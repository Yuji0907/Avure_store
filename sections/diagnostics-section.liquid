<section class="diagnostics" aria-labelledby="diagnostics-heading-{{ section.id }}">
  <div class="diagnostics__hero">
    {%- if section.settings.colab_image != blank -%}
      {{
        section.settings.colab_image
        | image_url: width: 2000
        | image_tag: alt: section.settings.colab_image.alt, loading: 'eager', class: 'diagnostics__image'
      }}
    {%- else -%}
      <img
        class="diagnostics__image"
        src="{{ 'Skin diagnostic - hero.png' | asset_url }}"
        width="2000"
        height="1200"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="diagnostics__content">
      {%- if section.settings.label != blank -%}
        <p class="diagnostics__eyebrow">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.hero_title != blank -%}
        <h1 class="diagnostics__heading" id="diagnostics-heading-{{ section.id }}">
          {{ section.settings.hero_title | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="diagnostics__description">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta != blank -%}
        <div class="diagnostics__button-wrapper">
          <a href="diagnostics-questions">
            <button class="avure-button" type="button">{{ section.settings.cta | escape }}</button>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .diagnostics {
    width: 100%;
    font-family: var(--text-font-accent);
  }
  .diagnostics__hero {
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .diagnostics__image {
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .diagnostics__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-color-secondary);
    width: 80%;
    margin-bottom: 3rem;
  }

  .diagnostics__eyebrow {
    font-family: var(--text-font-accent);
    margin: 2rem 0 0;
    text-transform: uppercase;
  }

  .diagnostics__heading {
    font-family: var(--text-font-primary);
    font-weight: 600;
    width: 95%;
    margin: 0;
    text-transform: uppercase;
  }

  .diagnostics__description {
    width: 90%;
    font-family: var(--text-font-primary);
    margin: 0;
  }

  .diagnostics__button-wrapper {
    margin-top: 3rem;
    width: 100%;
  }
{% endstylesheet %}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Eyebrow */
  #shopify-section-{{ section.id }} .diagnostics__eyebrow {
    width: 100%;
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.eyebrow_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.eyebrow_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .diagnostics__heading {
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .diagnostics__description {
    font-size: {{ section.settings.description_size }}px;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Pharma collaboration hero",
  "tag": "section",
  "class": "section-diagnostics",
  "settings": [
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "colab_image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Skin diagnostic" },

    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": " Unsure of your skin type? Understand its needs."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Answer few short questions about how your skin looks and behaves. You'll find out your skin type and get a starting routine to match."
    },
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Skin diagnostic©" },
    { "type": "text", "id": "cta", "label": "Call to action", "default": "Start your diagnostic" },

    { "type": "header", "content": "Eyebrow typography" },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Font size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -8
    },
    {
      "type": "range",
      "id": "eyebrow_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    { "type": "text_alignment", "id": "eyebrow_alignment", "label": "Alignment", "default": "center" },

    { "type": "header", "content": "Heading typography" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -4
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    { "type": "text_alignment", "id": "heading_alignment", "label": "Alignment", "default": "center" },

    { "type": "header", "content": "Description typography" },
    {
      "type": "range",
      "id": "description_size",
      "label": "Font size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    { "type": "text_alignment", "id": "description_alignment", "label": "Alignment", "default": "center" }
  ],
  "presets": [{ "name": "Pharma collaboration hero" }]
}
{% endschema %}
