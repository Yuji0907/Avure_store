{%- assign collection = collections['routines-duos'] -%}

<section class="routines-slider" id="RoutinesSlider-{{ section.id }}">
  <div class="routines-slider__content">
    <div class="routines-slider__header">
      <h2 class="routines-slider__title">{{ section.settings.heading | escape }}</h2>

      {% if collection != blank %}
        <a class="routines-slider__link" href="pages/routines-duos">
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </div>
    <div class="routines-slider__track">
      {% for product in collection.products %}
        {% comment %} <pre>{{product |json  }}</pre> {% endcomment %}
        <div class="routin-product__card">
          <div class="product-image__container">
            {{ product.featured_image | image_url: width: 500 | image_tag: class: 'product-image' }}
          </div>

          {%- assign rating = product.metafields.custom.rating.value.rating | times: 1 -%}
          <div class="routin-details__container">
            <div class="row-flex__group">
              <h1>{{ product.title }}</h1>
              {%- render 'rating', rating: rating -%}
            </div>

            <p>{{ product.description | strip_html | strip }}</p>

            <span class="price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <s class="compare-at-price">{{ product.compare_at_price | money }}</s>
              {% endif %}
            </span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .routines-slider {
    width: 100%;
  }
  .routines-slider__content {
    width: 90%;
    margin: 0 auto calc(64 * var(--fu));
  }
  .routines-slider__header {
    display: flex;
    align-items: center;
    gap: calc(64 * var(--fu));
    margin-bottom: calc(64 * var(--fu));
  }
  .routines-slider__title {
    display: flex;
    align-items: center;
    gap: calc(24 * var(--fu));
    margin: 0 auto 0 0;
    color: var(--text-color-dark);
    font-family: var(--text-primary);
    font-weight: 500;
  }
  .routines-slider__title::before {
    content: '';
    width: calc(32 * var(--fu));
    aspect-ratio: 1;
    flex: 0 0 calc(32 * var(--fu));
    border-radius: 50%;
    background: var(--bg-dark);
  }

  .routines-slider__link {
    text-decoration: underline;
    font-family: var(--text-secondary);
    color: var(--text-color-dark);
    font-weight: 400;
    text-transform: uppercase;
  }
  .routines-slider__track {
    width: 100%;
    overflow-y: hidden;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    gap: calc(64 * var(--fu));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 48%;
    padding-bottom: calc(32 * var(--fu));

    .routin-product__card {
      display: flex;
      flex-direction: column;

      .product-image__container {
        position: relative;
        width: 100%;
        aspect-ratio: 4/3;
        overflow: hidden;
        .product-image {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover; /* crops to fill without stretching */
          object-position: center;
        }
      }
      .routin-details__container {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        .row-flex__group {
          display: flex;
          flex-wrap: nowrap;
          width: 100%;
          justify-content: space-between;
          padding-top: calc(32 * var(--fu));
          align-items: center;
          gap: calc(16 * var(--fu));
          > h1 {
            flex: 1 1 auto;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: var(--text-secondary);
            color: var(--text-color-secondary);
            font-weight: 600;
          }
          > .rating {
            flex: 0 0 auto;
          }
        }
        > p {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
          line-clamp: 2;
          overflow: hidden;
          margin-top: calc(8 * var(--fu));
        }
        > p,
        .price {
          font-family: var(--text-secondary);
          color: var(--text-color-muted);
          font-weight: 500;
        }
        .price {
          color: var(--text-color-secondary);
          font-weight: 600;
          display: flex;
          flex-direction: row;
          align-items: baseline;
          gap: calc(12.8 * var(--fu));
          margin-top: calc(16 * var(--fu));
          .compare-at-price {
            color: var(--text-color-disabled);
            font-weight: 500;
          }
        }
      }
    }
  }
{% endstylesheet %}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Section title (flex item with a dot, so no alignment setting) */
  #shopify-section-{{ section.id }} .routines-slider__title {
    font-size: calc({{ section.settings.title_size }} * var(--fu));
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
  }

  /* View all link */
  #shopify-section-{{ section.id }} .routines-slider__link {
    font-size: calc({{ section.settings.link_size }} * var(--fu));
    letter-spacing: {{ section.settings.link_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.link_line_height | divided_by: 100.0 }};
  }

  /* Card title (shares a row with the rating, so no alignment setting) */
  #shopify-section-{{ section.id }} .routin-details__container .row-flex__group > h1 {
    font-size: calc({{ section.settings.card_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_title_line_height | divided_by: 100.0 }};
  }

  /* Card description */
  #shopify-section-{{ section.id }} .routin-details__container > p {
    font-size: calc({{ section.settings.card_description_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_description_alignment }};
  }

  /* Card price */
  #shopify-section-{{ section.id }} .routin-details__container .price {
    font-size: calc({{ section.settings.card_price_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_price_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_price_line_height | divided_by: 100.0 }};
  }

  /* Compare-at price */
  #shopify-section-{{ section.id }} .routin-details__container .compare-at-price {
    font-size: calc({{ section.settings.card_compare_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_compare_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_compare_line_height | divided_by: 100.0 }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .routines-slider__title { letter-spacing: 0em; line-height: 1.1; }
    #shopify-section-{{ section.id }} .routines-slider__link { font-size: 11px; letter-spacing: 0em; line-height: 1.4; }
    #shopify-section-{{ section.id }} .routin-details__container .row-flex__group > h1 { font-size: 14px; line-height: 1.2; }
    #shopify-section-{{ section.id }} .routin-details__container > p { font-size: 12px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .routin-details__container .price { font-size: 13px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .routin-details__container .compare-at-price { font-size: 12px; line-height: 1.4; }
  }
  /* auto:freeze-end */
{% endstyle %}

<script>
  (() => {
    const slider = document.getElementById('RoutinesSlider-{{ section.id }}');
    if (!slider) return;

    slider.querySelectorAll('.routines-slider__button').forEach((button) => {
      button.addEventListener('click', () => {
        const track = slider.querySelector('[data-slider-track]');
        if (!track) return;
        const direction = button.dataset.direction === 'next' ? 1 : -1;
        track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  })();
</script>

