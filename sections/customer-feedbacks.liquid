{%- assign k = 0 -%}
{%- assign reverse = true -%}
{% assign feedbacks = shop.metaobjects.feedback.values %}
{%- capture feedback_groups -%}
  {%- for feedback in feedbacks -%}
    {%- assign pos = forloop.index0 | modulo: 2 -%}
    {%- assign posf = forloop.index0  -%}

    {%- if pos == 0 -%}
      {%- assign k = forloop.index0 -%}
      {%- if reverse -%}
        <div class="feedbacks-row"  style="--direction: normal;">
        {%- assign reverse = false -%} 
        {%- else -%}
          <div class="feedbacks-row" style="--direction: reverse;">
          {%- assign reverse = true -%} 
  
      {%- endif -%}
    {%- endif -%}

      {%- assign full_name = feedback.full_name.value | strip -%}
      {%- assign name_parts = full_name | split: ' ' -%}
      {%- if name_parts.size > 1 -%}
        {%- assign last_initial = name_parts.last | slice: 0, 1 -%}
        {%- assign masked_name = name_parts.first | append: ' ' | append: last_initial | append: '****' -%}
      {%- else -%}
        {%- assign masked_name = full_name -%}
      {%- endif -%}
      <div class="feedbacks__wrapper">
        <div class="feedback-header">
          <div class="user">
            <p>@{{ masked_name }}</p>
            <span>{{ feedback.type.value }}</span>
          </div>
          <p>{{ feedback.rating.value }}</p>
        </div>
        <p>{{ feedback.feedback.value }}</p>
      </div>
      
    {%- if pos == 1 or forloop.last -%}
      {% comment %} {%- assign posf = posf | plus :1 -%} {% endcomment %}
      {%- for feedback in feedbacks -%}

        
        {%- if forloop.index0 >= k and forloop.index0 <=posf  -%}
          
        {%- assign full_name = feedback.full_name.value | strip -%}
        {%- assign name_parts = full_name | split: ' ' -%}
        {%- if name_parts.size > 1 -%}
          {%- assign last_initial = name_parts.last | slice: 0, 1 -%}
          {%- assign masked_name = name_parts.first | append: ' ' | append: last_initial | append: '******' -%}
        {%- else -%}
          {%- assign masked_name = full_name -%}
        {%- endif -%}
        <div class="feedbacks__wrapper">
            <div class="feedback-header">
              <div class="user">
                <p>@{{ masked_name }}</p>
                <span>{{ feedback.type.value }}</span>
              </div>
              <p>{{ feedback.rating.value }}</p>
            </div>
            <p>{{ feedback.feedback.value }}</p>
        </div>
        {%- endif -%}

      {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section class="feedbacks-wrapper">
  <div class="feedbacks-container">
    <div class="feedbacks-header">
      <h2 class="feedbacks-title">
        {{ section.settings.title }}
      </h2>
      <h1 class="feedbacks-heading">
        {{ section.settings.heading }}
      </h1>
      <p class="feedbacks-description">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="feedbacks-carousel">
      {{ feedback_groups }}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .feedbacks-wrapper {
    width: 100%;
    overflow-x: hidden;
    gap: 2rem;
    margin-block: 4rem;
    padding: 2rem;
    background-color: var(--bg-elevated);
    div {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }
    .feedbacks-container {
      width: 100%;
      gap: 2rem;
      .feedbacks-header {
        width: 80%;
        h2,
        h1,
        p {
          color: var(--text-color-dark);
        }
        .feedbacks-title {
          font-family: var(--text-font-accent);
          font-weight: 500;
        }
        .feedbacks-heading {
          font-family: var(--text-font-primary);
          font-weight: 600;
        }
        .feedbacks-description {
          width: 80%;
          font-family: var(--text-font-secondary);
          color: var(--text-color-muted);
        }
      }
      .feedbacks-carousel {
        width: 100%;
        display: flex;

        flex-direction: column;
        gap: 1rem;
        padding: 0;
        .feedbacks-row {
          width: 100%;
          display: flex;
          flex-grow: 1;
          flex-direction: row;
          flex-wrap: nowrap;
          gap: 16px;
          justify-content: flex-start;
          transform: translateX(calc(-60px * var(--row-index)));
          animation: infinite-scroll 20s linear infinite;
          animation-direction: var(--direction, normal);
        }
        .feedbacks__wrapper {
          flex-shrink: 1;
          min-width: 50%;
          height: 131px;
          max-height: 131px;
          padding-inline: 0.9rem;
          padding-block: 0.7rem;

          display: flex;
          flex-direction: column;
          background-color: var(--bg-light);
          border-radius: 0.9rem;
          box-shadow: 0px 2px 4px var(--shadow-clr-dark);
          font-family: var(--text-font-secondary);
          gap: 0.5rem;
          .feedback-header {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;

            .user {
              width: fit-content;
              align-items: flex-start;
              gap: 0;

              p {
                font-weight: 600;
              }
              span {
                color: var(--text-color-muted);
              }
            }
          }
        }
      }
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
  Note: cards have a fixed height of 131px, so very large card text will be clipped.
{%- endcomment -%}
{% style %}
  /* Header title */
  #shopify-section-{{ section.id }} .feedbacks-title {
    width: 100%;
    font-size: {{ section.settings.title_size }}px;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.title_alignment }};
  }

  /* Header heading */
  #shopify-section-{{ section.id }} .feedbacks-heading {
    width: 100%;
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Header description */
  #shopify-section-{{ section.id }} .feedbacks-description {
    font-size: {{ section.settings.description_size }}px;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }

  /* Card name */
  #shopify-section-{{ section.id }} .feedbacks__wrapper .feedback-header .user p {
    font-size: {{ section.settings.card_name_size }}px;
    letter-spacing: {{ section.settings.card_name_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_name_line_height | divided_by: 100.0 }};
  }

  /* Card type */
  #shopify-section-{{ section.id }} .feedbacks__wrapper .feedback-header .user span {
    font-size: {{ section.settings.card_type_size }}px;
    letter-spacing: {{ section.settings.card_type_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_type_line_height | divided_by: 100.0 }};
  }

  /* Card rating */
  #shopify-section-{{ section.id }} .feedbacks__wrapper .feedback-header > p {
    font-size: {{ section.settings.card_rating_size }}px;
    letter-spacing: {{ section.settings.card_rating_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_rating_line_height | divided_by: 100.0 }};
  }

  /* Card feedback text */
  #shopify-section-{{ section.id }} .feedbacks__wrapper > p {
    width: 100%;
    font-size: {{ section.settings.card_body_size }}px;
    letter-spacing: {{ section.settings.card_body_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_body_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_body_alignment }};
  }
{% endstyle %}

