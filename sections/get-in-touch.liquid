<section class="get-in-touch__section">
  <div class="get-in-touch__wrapper">
    <div class="hearder-container">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.description | escape }}</p>
    </div>

    {% form 'contact', class: 'get-in-touch__form' %}
      {{ form.errors | default_errors }}
      <input
        class="avure-input"
        type="text"
        name="contact[name]"
        placeholder="Name"
        aria-label="Name"
        autocomplete="name"
        required
      >
      <input
        class="avure-input"
        type="email"
        name="contact[email]"
        placeholder="Email"
        aria-label="Email"
        autocomplete="email"
        required
      >
      <input
        class="avure-input"
        type="tel"
        name="contact[phone]"
        placeholder="Phone"
        aria-label="Phone"
        autocomplete="tel"
      >
      <textarea class="avure-area" name="message" placeholder="message" id=""></textarea>
      {% comment %} <input  class="avure-input"type="textarea" name="contact[body]" placeholder="Message" aria-label="Message" required> {% endcomment %}
      <button class="avure-button" type="submit">{{ section.settings.button_label | escape }}</button>
    {% endform %}
  </div>
</section>
{%- stylesheet -%}
  .get-in-touch__section {
    width: 100%;
    display: grid;
    place-items: center;
    margin-block: 4rem;
    .get-in-touch__wrapper {
      width: 90%;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .hearder-container {
      color: var(--text-color-secondary);
      font-family: var(--text-font-primary);
      h1 {
        width: 100%;
        font-weight: 700;
      }
      p {
        font-family: var(--text-font-secondary);
        width: 100%;
        font-weight: 500;
      }
    }
    .get-in-touch__form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Heading */
  #shopify-section-{{ section.id }} .hearder-container h1 {
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .hearder-container p {
    font-size: {{ section.settings.description_size }}px;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Get in touch",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Questions about a product, an order or how to build a routine? Send us a message. We reply within 48 working hours.]"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },

    { "type": "header", "content": "Heading typography" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    { "type": "text_alignment", "id": "heading_alignment", "label": "Alignment", "default": "center" },

    { "type": "header", "content": "Description typography" },
    {
      "type": "range",
      "id": "description_size",
      "label": "Font size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "description_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    { "type": "text_alignment", "id": "description_alignment", "label": "Alignment", "default": "center" }
  ],
  "presets": [
    {
      "name": "Get in touch"
    }
  ]
}
{% endschema %}
