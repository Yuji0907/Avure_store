{%- assign roles = section.settings.roles | newline_to_br | split: '<br />' -%}
{% assign contact_form_success = false %}
<section class="get-in-touch__section">
  <div class="get-in-touch__wrapper">
    <div class="header-container">
      <h2>{{ section.settings.label | escape }}</h2>
      <h1>{{ section.settings.heading | escape }}</h1>
      {% assign working_days_text = section.settings.working_days | append: ' days' %}
      <p>{{ section.settings.description | replace: '[X working days]', working_days_text | escape }}</p>
    </div>

    {% form 'contact', class: 'get-in-touch__form' %}
      {% assign contact_form_success = form.posted_successfully? %}
      {{ form.errors | default_errors }}
      <input
        class="avure-input"
        type="text"
        name="contact[Pharmacy name]"
        data-success-pharmacy
        placeholder="Pharmacy name"
        aria-label="Pharmacy name"
        required
      >
      <input
        class="avure-input"
        type="text"
        name="contact[Pharmacy address]"
        placeholder="Pharmacy Address"
        aria-label="Pharmacy Address"
        required
      >
      <input class="avure-input" type="text" name="contact[name]" placeholder="Your name" aria-label="Your name" autocomplete="name" required data-success-name>
      {%- render 'avure-combo', combo_placeholder: 'Select your role...', options: roles, name: 'role' -%}
      <input
        class="avure-input"
        type="email"
        name="contact[email]"
        placeholder="Email"
        aria-label="Email"
        autocomplete="email"
        required
      >
      <input
        class="avure-input"
        type="phone"
        name="contact[phone]"
        placeholder="Phone number"
        aria-label="Phone number"
        autocomplete="tel"
      >
      {%- render 'avure-combo', combo_placeholder: 'What would you like?', options: roles, name: 'like' -%}
      <textarea
        class="avure-area "
        name="contact[body]"
        placeholder="Tell us about your collaboration idea"
        aria-label="Tell us about your collaboration idea"
        required
      ></textarea>
      <button class="avure-button" type="submit">{{ section.settings.button_label | escape }}</button>
    {% endform %}
  </div>
  {% if contact_form_success %}
    <div class="get-in-touch-success__overlay">
      <div class="text-container">
        <h1 data-success-title>Thank you.</h1>
        <p>
          We’ve received your request<span data-success-for></span>. We’ll reply within 03 working days.
        </p>
        <a data-style="light" class="avure-button back-home__btn" href="{{ routes.root_url }}">Back home</a>
      </div>
      {%- if section.settings.success_image != blank -%}
        {{
          section.settings.success_image
          | image_url: width: 2000
          | image_tag: alt: section.settings.success_image.alt, loading: 'eager', class: 'pharma-colab__image'
        }}
      {%- else -%}
        <img
          class="success__image"
          src="{{ 'success.png' | asset_url }}"
          width="2000"
          height="1200"
          alt="{{ section.settings.image_alt | escape }}"
          loading="eager"
        >
      {%- endif -%}
    </div>
  {% endif %}
</section>
<script>
  (() => {
    const KEY = 'avure-colab-request';
    const form = document.querySelector('#shopify-section-{{ section.id }} .get-in-touch__form');
    if (form) {
      form.addEventListener('submit', () => {
        const value = (selector) => form.querySelector(selector)?.value.trim() || '';
        try {
          sessionStorage.setItem(
            KEY,
            JSON.stringify({ name: value('[data-success-name]'), pharmacy: value('[data-success-pharmacy]') })
          );
        } catch (e) {}
      });
    }

    const overlay = document.querySelector('#shopify-section-{{ section.id }} .get-in-touch-success__overlay');
    if (!overlay) return;
    let saved = {};
    try {
      saved = JSON.parse(sessionStorage.getItem(KEY) || '{}');
    } catch (e) {}
    if (saved.name) overlay.querySelector('[data-success-title]').textContent = `Thank you, ${saved.name}.`;
    if (saved.pharmacy) overlay.querySelector('[data-success-for]').textContent = ` for ${saved.pharmacy}`;
  })();
</script>

{%- stylesheet -%}
  .get-in-touch-success__overlay {
    position: absolute;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100dvh;
    .success__image {
      position: absolute;
      inset: 0;
      width: 100%;
      z-index: 90;
      height: 100%;
      object-fit: cover;
    }
    .text-container {
      width: 90%;
      position: absolute;
      margin: auto;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: calc(64 * var(--fu));
      color: var(--text-color-primary);

      h1 {
        width: 100%;
        font-weight: 700;
        margin-top: auto;
      }
      p {
        width: 100%;
        font-family: var(--text-font-secondary);
        font-weight: 500;
        margin-bottom: auto;
      }
    }
  }
  .get-in-touch__section {
    width: 100%;
    display: grid;
    place-items: center;
    margin-block: calc(128 * var(--fu));
    .get-in-touch__wrapper {
      width: 90%;
      display: flex;
      flex-direction: column;
      gap: calc(64 * var(--fu));
    }
    .header-container {
      color: var(--text-color-secondary);
      font-family: var(--text-font-primary);
      display: flex;
      flex-direction: column;
      align-items: center;
      h1 {
        width: 100%;
        font-weight: 700;
      }
      h2 {
        font-family: var(--text-font-accent);
        text-transform: uppercase;
        letter-spacing: var(--tracking-eyebrow);
        width: 100%;
        font-weight: 500;
      }
      p {
        width: 100%;
        font-family: var(--text-font-secondary);
        font-weight: 500;
      }
    }
    .get-in-touch__form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: calc(48 * var(--fu));
    }
    .back-home__btn {
      margin-bottom: calc(160 * var(--fu));
      padding-inline: calc(70.4 * var(--fu));
      font-weight: 600;
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Eyebrow */
  #shopify-section-{{ section.id }} .header-container h2 {
    font-size: calc({{ section.settings.eyebrow_size }} * var(--fu));
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.eyebrow_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.eyebrow_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .header-container h1 {
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .header-container p {
    font-size: calc({{ section.settings.description_size }} * var(--fu));
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }

  /* Success title */
  #shopify-section-{{ section.id }} .get-in-touch-success__overlay .text-container h1 {
    font-size: calc({{ section.settings.success_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.success_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.success_title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.success_title_alignment }};
  }

  /* Success text */
  #shopify-section-{{ section.id }} .get-in-touch-success__overlay .text-container p {
    font-size: calc({{ section.settings.success_text_size }} * var(--fu));
    letter-spacing: {{ section.settings.success_text_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.success_text_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.success_text_alignment }};
  }

  /* Success button (alignment is handled by the button) */
  #shopify-section-{{ section.id }} .get-in-touch-success__overlay .back-home__btn {
    font-size: calc({{ section.settings.success_button_size }} * var(--fu));
    letter-spacing: {{ section.settings.success_button_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.success_button_line_height | divided_by: 100.0 }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .header-container h2 { font-size: 11px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .header-container h1 { font-size: 24px; letter-spacing: 0em; line-height: 1.1; }
    #shopify-section-{{ section.id }} .header-container p { font-size: 13px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .get-in-touch-success__overlay .text-container h1 { font-size: 24px; letter-spacing: 0em; line-height: 1.1; }
    #shopify-section-{{ section.id }} .get-in-touch-success__overlay .text-container p { line-height: 1.4; }
    #shopify-section-{{ section.id }} .get-in-touch-success__overlay .back-home__btn { font-size: 12px; line-height: 1.1; }
  }
  /* auto:freeze-end */
{% endstyle %}

