

{%- assign claims = shop.metaobjects.claims.values -%}

<div class="claims-wrapper">
    
    <div class="claims-container">
        
        {%- for claim in claims-%}
            <div class="claim-item__container">
                <h1 class="stat-number">{{ claim.stat_number.value}}</h1>
                <p class="stat-text">{{ claim.stat_text.value}}</p>
            </div>
            
        {%- endfor -%}
    </div>
</div>

{%- stylesheet -%}
.claims-wrapper{
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
  .claims-container{
    
        width: 90%;
        display: grid;
        grid-template-columns: repeat(3,1fr);
        place-items: center;
        margin-block: 4rem;
        .claim-item__container{
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap:1rem;
            .stat-number{
                font-family: var( --text-font-accent);
                font-size: var(--text-h2);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: -3px;
                line-height: 1;
            }
            .stat-text{
                font-family: var( --text-font-primary);
                font-size: var(--text-h4);
                font-weight: 500;
                text-transform: uppercase;
            }
        }
    }
{%- endstylesheet -%}