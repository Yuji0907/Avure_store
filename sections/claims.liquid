{%- assign claims = shop.metaobjects.claims.values -%}

<div class="claims-wrapper">
  <div class="claims-container">
    {%- for claim in claims -%}
      <div class="claim-item__container">
        <h1 class="stat-number">{{ claim.stat_number.value }}</h1>
        <p class="stat-text">{{ claim.stat_text.value }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{%- stylesheet -%}
  .claims-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .claims-container {
    width: 90%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 0.75rem;
    row-gap: 1.5rem;
    place-items: start center;
    margin-block: 32px;
    .claim-item__container {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      .stat-number {
        width: 100%;
        font-family: var(--text-font-accent);
        font-weight: 600;
      }
      .stat-text {
        width: 100%;
        font-family: var(--text-font-secondary);
        font-weight: 500;
      }
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Claim number */
  #shopify-section-{{ section.id }} .stat-number {
    font-size: {{ section.settings.number_size }}px;
    letter-spacing: {{ section.settings.number_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.number_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.number_alignment }};
  }

  /* Claim text */
  #shopify-section-{{ section.id }} .stat-text {
    font-size: {{ section.settings.text_size }}px;
    letter-spacing: {{ section.settings.text_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.text_alignment }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Claims",
  "settings": [
    { "type": "header", "content": "Claim number typography" },
    {
      "type": "range",
      "id": "number_size",
      "label": "Font size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "number_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -8
    },
    {
      "type": "range",
      "id": "number_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    { "type": "text_alignment", "id": "number_alignment", "label": "Alignment", "default": "center" },

    { "type": "header", "content": "Claim text typography" },
    {
      "type": "range",
      "id": "text_size",
      "label": "Font size",
      "min": 9,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "text_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    { "type": "text_alignment", "id": "text_alignment", "label": "Alignment", "default": "center" }
  ],
  "presets": [{ "name": "Claims" }]
}
{% endschema %}
