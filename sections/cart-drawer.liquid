<div class="cart-drawer__overlay" data-cart-close></div>

<div class="cart-drawer__panel" role="dialog" aria-label="Cart">
  <div class="cart-header__container">
    <span aria-hidden="true">{%- render 'cart-bag' -%}</span>
    <h2 class="cart-drawer__heading">
      Bag <span>({{ cart.item_count }})</span>
    </h2>
    <button class="cart-drawer__close" type="button" aria-label="Close cart" data-cart-close>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  {%- assign free_shipping_threshold = 500000 -%}
  {%- assign amount_remaining = free_shipping_threshold | minus: cart.total_price -%}
  {%- assign progress_percent = cart.total_price | times: 100.0 | divided_by: free_shipping_threshold -%}
  {%- if progress_percent > 100 -%}
    {%- assign progress_percent = 100 -%}
  {%- endif -%}

  <div class="cart-shipping-progress">
    {%- if amount_remaining > 0 -%}
      <p>{{ amount_remaining | money }} away from <span>FREE SHIPPING</span></p>
    {%- else -%}
      <p>You've unlocked FREE SHIPPING!</p>
    {%- endif -%}
    <div
      class="cart-shipping-progress__track"
      role="progressbar"
      aria-label="Progress toward free shipping"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_percent | round }}"
    >
      <span style="width: {{ progress_percent }}%"></span>
    </div>
  </div>
  {%- if cart.item_count > 0 -%}
    <ul class="cart-drawer__items">
      {%- for item in cart.items -%}
        {%- assign item_collection = item.product.collections.first -%}
        <li class="cart-drawer__item">
          {%- if item.image -%}
            <a class="cart-drawer__image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
              {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}
            </a>
          {%- endif -%}

          <div class="cart-drawer__details">
            <a class="cart-drawer__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
            {%- if item.product.description != blank -%}
              <p class="cart-drawer__description">{{ item.product.description | strip_html | truncate: 100 }}</p>
            {%- endif -%}

            {%- unless item.product.has_only_default_variant -%}
              <div class="cart-drawer__variants" role="group" aria-label="Size">
                {%- for variant in item.product.variants -%}
                  {%- assign variant_label = variant.title -%}
                  {%- unless variant_label contains 'ml' -%}
                    {%- assign variant_label = variant_label | append: ' ml' -%}
                  {%- endunless -%}
                  <button
                    type="button"
                    class="cart-drawer__variant{% if variant.id == item.variant_id %} is-selected{% endif %}"
                    {% if variant.id == item.variant_id %}
                      aria-pressed="true"
                    {% else %}
                      aria-pressed="false"
                      data-cart-swap
                      data-key="{{ item.key }}"
                      data-variant-id="{{ variant.id }}"
                      data-quantity="{{ item.quantity }}"
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant_label | escape }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="cart-drawer__prices">
              <span>{{ item.final_line_price | money }}</span>
            </div>

            <div class="cart-drawer__qty">
              <div class="cart-drawer__stepper">
                <button
                  type="button"
                  class="cart-drawer__step"
                  aria-label="Decrease quantity"
                  data-cart-qty
                  data-key="{{ item.key }}"
                  data-qty="{{ item.quantity | minus: 1 }}"
                >
                  &minus;
                </button>
                <span class="cart-drawer__count" aria-live="polite">{{ item.quantity }}</span>
                <button
                  type="button"
                  class="cart-drawer__step"
                  aria-label="Increase quantity"
                  data-cart-qty
                  data-key="{{ item.key }}"
                  data-qty="{{ item.quantity | plus: 1 }}"
                >
                  +
                </button>
              </div>

              <a
                class="cart-drawer__remove"
                href="{{ routes.cart_change_url }}?id={{ item.key | url_encode }}&amp;quantity=0"
                data-cart-remove
                data-key="{{ item.key }}"
                >Remove</a
              >
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="cart-drawer__footer">
      <a class="cart-drawer__checkout" href="pages/checkout">
        Checkout - {{ cart.total_price | money_without_currency }} DA
      </a>
      <p class="cart-drawer__note">Shipping and promo codes are calculated at checkout.</p>
    </div>
  {%- else -%}
    <p class="cart-empty">Your cart is empty.</p>
  {%- endif -%}
</div>

{%- stylesheet -%}
  .no-scroll {
    overflow: hidden;
  }
  .cart-empty {
    width: 100%;
    height: 100%;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-h2);
    font-family: var(--text-font-primary);
    color: var(--text-color-disabled);
    line-height: 1;
  }
  .cart-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(32 * var(--fu));
    padding-block: calc(32 * var(--fu));
    padding-inline: calc(16 * var(--fu));
    .cart-bag svg {
      --size: 3rem;
      width: var(--size);
      height: var(--size);
      path {
        fill: var(--color-dark);
      }
    }
  }
  .cart-drawer__overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    font-size: var(--type-body);
  }
  .cart-drawer__panel.cart-drawer-open ~ .cart-drawer__overlay,
  .cart-drawer__overlay:has(+ .cart-drawer-open) {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer__panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: calc(64 * var(--fu));
    padding: calc(48 * var(--fu));
    background-color: var(--bg-light);
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.3s ease, visibility 0.3s ease;
  }
  .cart-drawer__panel.cart-drawer-open {
    transform: translateX(0);
    visibility: visible;
    width: 100%;
    padding-inline: calc(128 * var(--fu));
    pointer-events: auto;
  }

  .cart-drawer__close {
    align-self: auto;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .cart-drawer__items {
    width: 100%;
    overflow-y: auto;
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }
  .cart-drawer__item {
    width: 100%;
    margin-inline: auto;
    display: flex;
    gap: calc(32 * var(--fu));
    padding-block: calc(32 * var(--fu));
    border-block: 2px solid var(--border-clr-muted);
  }
  .cart-drawer__image {
  }
  .cart-drawer__item img {
    display: block;
    width: calc(416 * var(--fu));
    height: auto;
  }
  .cart-drawer__details {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(14.4 * var(--fu));
  }
  .cart-drawer__category {
    font-size: var(--type-caption);
    text-transform: uppercase;
    opacity: 0.7;
  }
  .cart-drawer__title {
    font-weight: 700;
    font-size: var(--text-h2);
    font-family: var(--text-font-primary);
    color: var(--text-color-secondary);
    line-height: 1;
  }
  .cart-drawer__description {
    font-weight: 400;
    font-size: var(--text-h3);
    font-family: var(--text-font-primary);
    color: var(--text-color-secondary);
    line-height: 1;
  }
  .cart-drawer__qty {
    width: 100%;
    display: inline-flex;
    align-items: center;
    gap: calc(25.6 * var(--fu));
    justify-content: space-between;
    margin-top: auto;
  }
  .cart-drawer__variants {
    display: flex;
    flex-wrap: wrap;
    gap: calc(12.8 * var(--fu));
  }
  .cart-drawer__variant {
    padding: calc(9.6 * var(--fu)) calc(19.2 * var(--fu));
    border: 1px solid var(--color-dark);
    border-radius: calc(16 * var(--fu));
    background: transparent;
    color: var(--text-color-secondary);
    font-family: var(--text-font-primary);
    font-size: var(--type-body-sm);
    line-height: 1;
    cursor: pointer;
  }
  .cart-drawer__variant.is-selected {
    background: var(--bg-dark);
    color: var(--text-color-primary);
    cursor: default;
  }
  .cart-drawer__variant:disabled:not(.is-selected) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .cart-drawer__stepper {
    display: inline-flex;
    align-items: center;
    gap: calc(24 * var(--fu));
  }
  .cart-drawer__step {
    width: calc(56 * var(--fu));
    height: calc(56 * var(--fu));
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-dark);
    border-radius: calc(16 * var(--fu));
    background: transparent;
    color: var(--text-color-secondary);
    font-size: calc(32 * var(--fu));
    line-height: 1;
    cursor: pointer;
  }
  .cart-drawer__count {
    min-width: 1.5ch;
    text-align: center;
    font-size: var(--type-body);
    font-weight: 600;
  }
  .cart-drawer__remove {
    margin-left: auto;
    font-size: var(--type-body-sm);
    text-decoration: underline;
    color: var(--text-color-muted);
  }
  .cart-drawer__prices {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--fu));
    font-weight: 600;
  }
  .cart-drawer__prices s {
    font-size: var(--type-body-sm);
    font-weight: 400;
    opacity: 0.65;
  }
  .cart-drawer__footer {
    display: grid;
    gap: calc(24 * var(--fu));
  }
  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    margin: 0;
  }
  .cart-drawer__view-cart,
  .cart-drawer__checkout {
    display: block;
    padding: calc(27.2 * var(--fu)) calc(32 * var(--fu));
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cart-drawer__view-cart {
    border: 1px solid currentColor;
  }
  .cart-drawer__checkout {
    background: var(--fill-dark);
    color: var(--text-color-primary);
    font-size: var(--text-h2);
    font-weight: 700;
  }
  .cart-drawer__heading {
    color: var(--text-color-secondary);
    font-size: var(--text-h1);
    font-weight: 700;
    display: flex;
    flex-grow: 1;
    align-items: center;
    gap: calc(16 * var(--fu));
  }
  .cart-drawer__close svg {
    display: block;
    width: 3rem;
    height: 3rem;
  }
  @media (max-width: 30rem) {
    .cart-drawer__panel {
      width: 100%;
    }
  }
  .cart-drawer__items {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .cart-drawer__items::-webkit-scrollbar {
    display: none;
  }
  .cart-drawer__note {
    margin: 0;
    color: var(--text-color-muted);
    font-size: var(--text-h4);
    text-align: center;
  }
  .cart-shipping-progress p {
    margin: 0 0 calc(16 * var(--fu));
    color: var(--text-color-muted);
    font-size: var(--text-h4);
    span {
      font-weight: 700;
    }
  }
  .cart-shipping-progress__track {
    height: calc(16 * var(--fu));
    overflow: hidden;
    background: var(--border-clr-muted);
    border-radius: calc(1998 * var(--fu));
  }
  .cart-shipping-progress__track span {
    display: block;
    height: 100%;
    background: var(--fill-dark);
    transition: width 0.3s ease;
  }
{%- endstylesheet -%}
