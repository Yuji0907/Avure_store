{% assign product_collection = product.collections.first %}

{%- assign variant = product.selected_or_first_available_variant -%}

<div class="product-info_wrapper">
  <div class="main-conatiner">
    <div class="product-info_container">
      <span class="category">
        <span> {{ product_collection.description | strip_html }} </span>
        <span>·</span>
        <span>{{ product_collection.title }}</span>
      </span>
      <h1 class="product-title">{{ product.title }}</h1>
      <p class="product-description">{{ product.description | strip_html }}</p>

      <div class="product-variant_container">
        <div class="variants">
          {%- render 'selector', items: product.variants -%}
        </div>

        <div class="quantity-selector">
          {%- render 'quanity-selector' -%}
        </div>
      </div>
    </div>

    <div class="product-price_container">
      <span class="price">{{ product.price | divided_by: 100 }} DA</span>
      {% if product.compare_at_price > product.price %}
        <span class="price" data-type="old">{{ product.compare_at_price | divided_by: 100 }} DA</span>
      {% endif %}
    </div>

    <div class="cta">
      <button
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        data-add-to-cart
        id="add-cart__product"
        type="button"
        class="custom-button custom-button--filled"
      >
        {{ 'add to cart' | escape }}
      </button>
      <button
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        data-buy
        type="button"
        class="custom-button custom-button--outline"
      >
        {{ 'buy now' | escape }}
      </button>
      {% comment %} {%- render 'button', text: 'buy now', variant: 'border' -%} {% endcomment %}
    </div>
  </div>
  {%- render 'product-about-content', product: product -%}
</div>

{%- stylesheet -%}
  .custom-button {
    display: inline-block;
    width: 100%;
    height: 100%;
    border: 1px solid var(--fill-dark);
    font: inherit;
    font-size: inherit;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    text-transform: uppercase;
  }
  .custom-button--filled {
    background: var(--fill-dark);
    color: var(--text-color-primary);
  }
  .product-info_wrapper {
    width: 100%;
    display: grid;
    place-items: center;
    /* same spacing as when "about" was its own section: 1.5rem above, 1.5rem between */
    padding-block: 1.5rem 0;
    row-gap: 1.5rem;
  }
  .main-conatiner {
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
  }
  .product-info_container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* gap:.25rem; */
    font-family: var(--text-font-primary);
    .category {
      width: 100%;
      font-family: var(--text-font-accent);
      font-weight: 500;
      font-size: var(--text-h4);
      display: flex;
      align-items: center;
      text-transform: uppercase;
      justify-content: flex-start;
    }
    .product-title {
      width: 100%;
      font-weight: 700;
      font-size: var(--text-h1);
      line-height: var(--text-h1-leading);
    }
    .product-description {
      width: 100%;
      font-weight: 500;
      font-size: var(--text-h3);
      line-height: var(--text-h3-leading);
    }
  }

  .product-variant_container {
    margin-top: 0.8rem;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    .variants {
    }
    .quantity-selector {
    }
  }

  .product-price_container {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    font-family: var(--text-font-secondary);
    line-height: 1;
    gap: 0.5rem;
  }
  .price {
    --text-size: var(--text-h3);
    font-size: var(--text-size);
    font-weight: 600;
  }
  .price[data-type='old'] {
    font-size: calc(var(--text-size) - 0.125rem);
    color: var(--color-dark-disabled);
    text-decoration: line-through;
    font-weight: 400;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.8rem;
    padding-block: 1rem;
    font-family: var(--text-font-primary);
    font-size: var(--text-h3);
  }
  .product-info_wrapper .cta .custom-button {
    flex: 1 1 0;
    min-width: 0;
    height: 48px;
    padding: 0 0.75rem;
    font-family: var(--text-font-primary);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    border: 1px solid var(--fill-dark);
  }
  .product-info_wrapper .cta .custom-button--filled {
    background: var(--fill-dark);
    color: var(--avure-light);
  }
  .product-info_wrapper .cta .custom-button--outline {
    background: var(--avure-light);
    color: var(--fill-dark);
  }
{%- endstylesheet -%}
