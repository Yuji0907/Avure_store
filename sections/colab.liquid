<section class="section-hero">
  <div class="colab-hero-container">
    {%- if section.settings.colab_image != blank -%}
      {{
        section.settings.colab_image
        | image_url: width: 400
        | image_tag: alt: 'coloab image', loading: 'eager', class: 'colab-image'
      }}
    {%- else -%}
      <img class="colab-image" src="{{ 'colab.png' | asset_url }}" width="400" height="auto" alt="logo">
    {%- endif -%}

    <div class="colab-hero-content">
      {%- if section.settings.label != blank -%}
        <p class="colab-hero-label">
          {%- assign label_parts = section.settings.label | split: '.' -%}
          {%- for part in label_parts -%}
            {{- part | strip -}}
            {%- unless forloop.last -%}.<br>{%- endunless -%}
          {%- endfor -%}
        </p>
      {%- endif -%}
      <div class="colab-heading-container">
        {%- if section.settings.hero_title != blank -%}
          <h1 class="colab-hero-heading">{{ section.settings.hero_title }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="colab-hero-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta != blank -%}
        <div class="btton-wrrapper">
          <a href="pages/colab-form">
            <button data-style="light" class=" avure-outline-button   colab-btn " type="btn">
              {{ section.settings.cta | escape }}
            </button>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .section-hero {
    width: 100%;
    display: flex;
    font-family: var(--text-font-secondary);
  }
  .colab-hero-container {
    width: 100%;
    height: auto;
    position: relative;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .colab-image {
    display: block;
    position: relative;
    inset: 0;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .colab-hero-container::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), transparent);
  }

  .colab-hero-content {
    position: absolute;
    z-index: 1;
    inset: 0;
    margin: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-color-primary);
    width: 100%;
    margin-bottom: 10rem;

    .btton-wrrapper {
      width: 30%;
      .colab-btn {
        margin-top: 3rem;
      }
    }
  }
  .colab-hero-label {
    font-family: var(--text-font-accent);
    margin-bottom: auto;
    margin-top: 2rem;
    text-transform: uppercase;
  }
  .colab-heading-container {
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  .colab-hero-heading {
    font-family: var(--text-font-primary);
    font-weight: 600;
    width: 95%;
  }
  .colab-hero-subheading {
    width: 50%;
    font-family: var(--text-font-secondary);
    text-wrap: balance;
  }
{% endstylesheet %}

{%- comment -%}
  Typography lives in {% style %} (not {% stylesheet %}) because stylesheet blocks cannot use Liquid.
  Selectors are scoped to this section instance so several can coexist with different settings.
{%- endcomment -%}
{% style %}
  /* Label */
  #shopify-section-{{ section.id }} .colab-hero-label {
    width: 100%;
    font-size: {{ section.settings.label_size }}px;
    letter-spacing: {{ section.settings.label_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.label_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.label_alignment }};
  }

  /* Title */
  #shopify-section-{{ section.id }} .colab-hero-heading {
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Subheading */
  #shopify-section-{{ section.id }} .colab-hero-subheading {
    font-size: {{ section.settings.subheading_size }}px;
    letter-spacing: {{ section.settings.subheading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.subheading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.subheading_alignment }};
  }

  /* Button text (alignment is handled by the button itself) */
  #shopify-section-{{ section.id }} .colab-btn {
    --btn-text-size: {{ section.settings.cta_size }}px;
    font-size: {{ section.settings.cta_size }}px;
    letter-spacing: {{ section.settings.cta_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.cta_line_height | divided_by: 100.0 }};
  }
{% endstyle %}

{% schema %}
{
  "name": "colab",
  "tag": "section",
  "class": "section-colab",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "colab_image", "label": "Image" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "hero_title", "label": "Hero Title", "default": "Skincare shared with pharmacists." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clear information, simple routines and a team that supports you."
    },
    { "type": "text", "id": "label", "label": "label", "default": "Developed by Pharmacists. for  Pharmacists." },
    { "type": "text", "id": "cta", "label": "call to action", "default": "collaborate now" },

    { "type": "header", "content": "Label typography" },
    {
      "type": "range",
      "id": "label_size",
      "label": "Font size",
      "min": 11,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "label_letter_spacing",
