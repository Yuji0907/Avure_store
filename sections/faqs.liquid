{% assign faqs_colab = shop.metaobjects.colab_questions.values %}

<div class="faqs-wrapper">

    <div class="accordings_container">
        {% for item in faqs_colab %}
                    {% if forloop.last %}
                        {%- assign last = true -%}
                    {% endif %}
            {%- render 'accordion',title:item.question.value,items:item.answers.value,last:last -%}
            {% comment %} check last  {% endcomment %}
        {% endfor %}
    </div>
</div>
{%- stylesheet -%}
  
  .faqs-wrapper{
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .accordings_container{
        display: flex;
        flex-direction: column;
        align-items: center;
        /* gap: 1.5rem; */
        margin-top: 1.5rem;
        width: 90%;
        font-family: var(--text-font-primary);
        font-size: var(--text-h3);
    }
{%- endstylesheet -%}