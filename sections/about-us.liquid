{% assign about_avure = shop.metaobjects.about_avure.values %}

<section class="section-about">
  <div class="about-container">
    {%- if section.settings.about_image != blank -%}
      {{
        section.settings.about_image
        | image_url: width: 400
        | image_tag: alt: 'coloab image', loading: 'eager', class: 'about-image'
      }}
    {%- else -%}
      <img class="about-image" src="{{ 'about-image.png' | asset_url }}" width="400" height="auto" alt="logo">
    {%- endif -%}

    <div class="about-content">
      {%- if section.settings.subheading != blank -%}
        <p class="about-label">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="about-container">
        {%- if section.settings.hero_title != blank -%}
          <h1 class="about-heading">{{ section.settings.hero_title | replace_first: ', ', ',<br>' }}</h1>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="about-us-values__container">
    <div>
      <p class="about-us-values__slogen">//{{ section.settings.slogen }}</p>
      <h1 class="about-us-values_lable">{{ section.settings.about_us_values_lable }}</h1>
    </div>

    <div class="accordings_container">
      {%- comment -%}
        The container is column-reverse, so the item shown at position N on screen is forloop.rindex N.
        The first DOM item is shown last and gets the bottom divider.
      {%- endcomment -%}
      {%- assign open_position = section.settings.open_item_index | default: 0 | times: 1 -%}
      {% for item in about_avure %}
        {%- assign item_open = false -%}
        {%- if forloop.rindex == open_position -%}
          {%- assign item_open = true -%}
        {%- endif -%}
        {%- render 'accordion',
          title: item.title.value,
          items: item.values.value,
          open: item_open,
          last: forloop.first
        -%}
      {% endfor %}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .about-image {
    width: 100%;
  }
  .section-about {
    width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: calc(128 * var(--fu));
    font-family: var(--text-font-secondary);
    .about-us-values__container {
      width: 90%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: calc(48 * var(--fu));
      .about-us-values__slogen {
        font-family: var(--text-font-accent);
        font-weight: 500;
      }
      .about-us-values_lable {
        font-family: var(--text-font-primary);
        font-weight: 700;
        text-transform: uppercase;
      }
      .accordings_container {
        display: flex;
        flex-direction: column-reverse;
        align-items: center;
        margin-top: calc(48 * var(--fu));
        width: 100%;
        font-family: var(--text-font-primary);
      }
    }
  }
  .about-container {
    width: 100%;
    height: auto;
    position: relative;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-content {
    position: absolute;
    z-index: 1;
    top: 0;
    margin: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: calc(32 * var(--fu));
    color: var(--text-color-primary);
    width: 100%;

    margin-top: calc(160 * var(--fu));
  }
  .about-label {
    text-wrap: balance;
    font-family: var(--text-font-accent);
  }
  .about-contaboutainer {
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: calc(16 * var(--fu));
  }
  .about-heading {
    font-family: var(--text-font-primary);
    font-weight: 700;
    text-transform: uppercase;
    width: 90%;
    max-width: calc(640 * var(--fu));
    margin-inline: auto;
    text-wrap: balance;
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance,
  so the shared accordion snippet is unchanged and accordions in other sections are unaffected.
{%- endcomment -%}
{% style %}
  /* Label */
  #shopify-section-{{ section.id }} .about-label {
    width: 100%;
    font-size: calc({{ section.settings.label_size }} * var(--fu));
    letter-spacing: {{ section.settings.label_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.label_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.label_alignment }};
  }

  /* Hero heading */
  #shopify-section-{{ section.id }} .about-heading {
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Values slogan */
  #shopify-section-{{ section.id }} .about-us-values__slogen {
    font-size: calc({{ section.settings.slogan_size }} * var(--fu));
    letter-spacing: {{ section.settings.slogan_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.slogan_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.slogan_alignment }};
  }

  /* Values title */
  #shopify-section-{{ section.id }} .about-us-values_lable {
    font-size: calc({{ section.settings.values_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.values_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.values_title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.values_title_alignment }};
  }

  /* Accordion rows: ~40px high, 1px #222 dividers, 14px +/- icon */
  #shopify-section-{{ section.id }} .accordings_container .accordion {
    border-top: 1px solid #222;
  }
  #shopify-section-{{ section.id }} .accordings_container .accordion.last {
    border-bottom: 1px solid #222;
  }
  #shopify-section-{{ section.id }} .accordings_container .accordion-title {
    padding: 10px 0;
    min-height: 40px;
    font-family: var(--text-font-secondary);
    font-weight: 500;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .accordings_container .accordion-icon {
    flex: 0 0 14px;
    width: 14px;
  }
  #shopify-section-{{ section.id }} .accordings_container .accordion[open]::details-content {
    margin-bottom: 0.75rem;
  }

  /* Accordion titles (flex row with the icon, so no alignment setting) */
  #shopify-section-{{ section.id }} .accordings_container .accordion-title {
    font-size: calc({{ section.settings.accordion_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.accordion_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.accordion_title_line_height | divided_by: 100.0 }};
  }

  /* Accordion items */
  #shopify-section-{{ section.id }} .accordings_container .accordion > ul {
    text-align: {{ section.settings.accordion_item_alignment }};
  }
  #shopify-section-{{ section.id }} .accordings_container .accordion > ul li {
    {%- comment -%} "Left" renders justified, which the alignment picker can't offer {%- endcomment -%}
    text-align: {% if section.settings.accordion_item_alignment == 'left' %}justify{% else %}{{ section.settings.accordion_item_alignment }}{% endif %};
    color: var(--avure-black-900);
    font-family: var(--text-font-secondary);
    font-size: calc({{ section.settings.accordion_item_size }} * var(--fu));
    letter-spacing: {{ section.settings.accordion_item_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.accordion_item_line_height | divided_by: 100.0 }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .about-label { font-size: 9px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .about-heading { font-size: 20px; line-height: 1.1; }
    #shopify-section-{{ section.id }} .about-us-values__slogen { font-size: 9px; letter-spacing: -0.07em; line-height: 1.2; }
    #shopify-section-{{ section.id }} .about-us-values_lable { font-size: 16px; letter-spacing: -0.05em; line-height: 1.1; }
    #shopify-section-{{ section.id }} .accordings_container .accordion-title { font-size: 16px; letter-spacing: 0em; line-height: 1.2; }
    #shopify-section-{{ section.id }} .accordings_container .accordion > ul li { line-height: 1.4; }
  }
  /* auto:freeze-end */
{% endstyle %}

