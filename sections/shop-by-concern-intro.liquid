<div class="products-hero_container">
  <div class="products-hero_content">
    <div class="products-hero_header">
      <h2 class="products-hero_title">Shop by concern</h2>
      <a class="products-hero_link" href="pages/concerns/imperfections-breakouts"> view all </a>
    </div>
    {%- render 'concerns-slider' -%}
  </div>
</div>

{%- stylesheet -%}
  .products-hero_container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .products-hero_content {
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-block: calc(64 * var(--fu));
    .products-hero_header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .products-hero_title {
      font-family: var(--text-primary);
      color: var(--text-color-dark);
      font-weight: 500;
      position: relative;
      display: flex;
      align-items: center;
      gap: calc(16 * var(--fu));
    }
    .products-hero_title::before {
      content: '';
      --size: calc(32 * var(--fu));
      width: var(--size);
      aspect-ratio: 1/1;
      border-radius: var(--size);
      background-color: var(--bg-dark);
    }
    .products-hero_link {
      text-decoration: underline;
      font-family: var(--text-secondary);
      color: var(--text-color-dark);
      font-weight: 400;
      text-transform: uppercase;
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Selectors are scoped to this
  section, so the concern-card snippet is unchanged and other places that use it are unaffected.
{%- endcomment -%}
{% style %}
  /* Section title (flex item with a dot, so no alignment setting) */
  #shopify-section-{{ section.id }} .products-hero_title {
    font-size: calc({{ section.settings.title_size }} * var(--fu));
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
  }

  /* "View all" link */
  #shopify-section-{{ section.id }} .products-hero_link {
    font-size: calc({{ section.settings.link_size }} * var(--fu));
    letter-spacing: {{ section.settings.link_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.link_line_height | divided_by: 100.0 }};
  }

  /* Card title */
  #shopify-section-{{ section.id }} .concern-card__title {
    font-size: calc({{ section.settings.card_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_title_alignment }};
  }

  /* Card description (symptoms) */
  #shopify-section-{{ section.id }} .concern-card__description {
    font-size: calc({{ section.settings.card_description_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_description_alignment }};
  }

  /* Figma mobile (768 frame): fonts and weights, phones only */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .products-hero_title { font-family: var(--text-font-primary); font-weight: 400; }
    #shopify-section-{{ section.id }} .products-hero_link { font-family: var(--text-font-primary); font-weight: 500; }
    #shopify-section-{{ section.id }} .concern-card__title { font-family: var(--font-poppins); font-weight: 600; }
    #shopify-section-{{ section.id }} .concern-card__description { font-family: var(--text-font-primary); }
    /* Figma: 217px cards, three fill the row */
    #shopify-section-{{ section.id }} .concern-slider_container { grid-auto-columns: calc(217 * var(--fu)); column-gap: calc((100% - 651 * var(--fu)) / 2); }
  }

  /* Tablet and desktop keep the sizes they had before the Figma mobile values were entered.
     (Fixed here, so changing these settings only affects phones.) */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .products-hero_title { letter-spacing: 0em; line-height: 1.1; }
    #shopify-section-{{ section.id }} .products-hero_link { font-size: 11px; }
    #shopify-section-{{ section.id }} .concern-card__title { font-size: 14px; }
    #shopify-section-{{ section.id }} .concern-card__description { font-size: 12px; line-height: 1.2; }
  }
{% endstyle %}

