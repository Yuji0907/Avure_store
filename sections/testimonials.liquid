{% assign testimonials = shop.metaobjects.testimonials.values %}

<section class="testimonials-wrapper">
  <div class="testimonials-container">
    <div class="testimonials-header">
      <h2 class="testimonials-title">
        {{ section.settings.title }}
      </h2>
      <h1 class="testimonials-heading">
        {{ section.settings.heading }}
      </h1>
      <p class="testimonials-description">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="testimonials-carousel">
      {%- if section.blocks.size > 0 -%}
        {%- comment -%} Video blocks added in the theme editor. Blocks without a video are skipped. {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign video = block.settings.video -%}
          {%- if video == blank -%}{%- continue -%}{%- endif -%}
          {%- assign poster = block.settings.poster | default: video.preview_image -%}
          <div class="testimonials-vide__wrapper" {{ block.shopify_attributes }}>
            <video
              class="testi-video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              {% if poster != blank %}
                poster="{{ poster | image_url: width: 720 }}"
              {% endif %}
              {% if video.alt != blank %}
                aria-label="{{ video.alt | escape }}"
              {% endif %}
            >
              {%- for source in video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for testimonial in testimonials -%}
          <div class="testimonials-vide__wrapper">
            {%- if testimonial.media != blank -%}
              {{
                testimonial.media.value
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  preload: 'metadata',
                  controls: false,
                  class: 'testi-video'
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .testimonials-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(64 * var(--fu));
    margin-block: 0;
    justify-content: center;
    padding-block: 0 calc(64 * var(--fu));
    div {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .testimonials-container {
      width: 90%;
      gap: calc(64 * var(--fu));
      .testimonials-header {
        width: 100%;
        h2,
        h1,
        p {
          color: var(--text-color-dark);
        }
        .testimonials-title {
          font-family: var(--text-font-accent);
          font-weight: 500;
        }
        .testimonials-heading {
          font-family: var(--text-font-primary);
          font-weight: 600;
        }
        .testimonials-description {
          width: 80%;
          font-family: var(--text-font-secondary);
          color: var(--text-color-muted);
        }
      }
      .testimonials-carousel {
        --cols-mobile: 3;
        width: 100%;
        display: grid;

        grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr));
        gap: calc(48 * var(--fu));
        padding: 0;
        place-items: center;
        .testimonials-vide__wrapper {
          width: 100%;
          height: 100%;
          display: flex;
          justify-content: flex-end;
          align-items: flex-end;
          .testi-video {
            width: 100%;
            height: auto;
            aspect-ratio: 9/16;
            object-fit: cover;
            border-radius: calc(32 * var(--fu));
            margin-top: auto;
            box-shadow: 0px 0px calc(14 * var(--fu)) var(--shadow-clr-dark);
          }
        }

        .testimonials-vide__wrapper:nth-child(2) {
          width: 110%;
        }
      }
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Title */
  #shopify-section-{{ section.id }} .testimonials-title {
    width: 100%;
    font-size: calc({{ section.settings.title_size }} * var(--fu));
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.title_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .testimonials-heading {
    width: 100%;
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .testimonials-description {
    font-size: calc({{ section.settings.description_size }} * var(--fu));
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }

  /* Figma mobile (768 frame): fonts and weights, phones only */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .testimonials-title { font-family: var(--text-font-accent); font-weight: 600; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .testimonials-heading { font-family: var(--text-font-primary); font-weight: 400; }
  }

  /* Tablet and desktop keep the sizes they had before the Figma mobile values were entered.
     (Fixed here, so changing these settings only affects phones.) */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .testimonials-title { font-size: 11px; letter-spacing: 0em; }
    #shopify-section-{{ section.id }} .testimonials-heading { line-height: 1.1; }
  }
{% endstyle %}

