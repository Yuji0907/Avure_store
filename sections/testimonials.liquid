{% assign testimonials = shop.metaobjects.testimonials.values %}

<section class="testimonials-wrapper">
  <div class="testimonials-container">
    <div class="testimonials-header">
      <h2 class="testimonials-title">
        {{ section.settings.title }}
      </h2>
      <h1 class="testimonials-heading">
        {{ section.settings.heading }}
      </h1>
      <p class="testimonials-description">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="testimonials-carousel">
      {%- for testimonial in testimonials -%}
        <div class="testimonials-vide__wrapper">
          {%- if testimonial.media != blank -%}
            {{
              testimonial.media.value
              | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'testi-video'
            }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .testimonials-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    margin-block: 0;
    justify-content: center;
    padding-block: 0 32px;
    div {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .testimonials-container {
      width: 90%;
      gap: 2rem;
      .testimonials-header {
        width: 100%;
        h2,
        h1,
        p {
          color: var(--text-color-dark);
        }
        .testimonials-title {
          font-family: var(--text-font-accent);
          font-weight: 500;
        }
        .testimonials-heading {
          font-family: var(--text-font-primary);
          font-weight: 600;
        }
        .testimonials-description {
          width: 80%;
          font-family: var(--text-font-secondary);
          color: var(--text-color-muted);
        }
      }
      .testimonials-carousel {
        --cols-mobile: 3;
        width: 100%;
        display: grid;

        grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr));
        gap: 1.5rem;
        padding: 0;
        place-items: center;
        .testimonials-vide__wrapper {
          width: 100%;
          height: 100%;
          display: flex;
          justify-content: flex-end;
          align-items: flex-end;
          .testi-video {
            width: 100%;
            height: auto;
            aspect-ratio: 9/16;
            object-fit: cover;
            border-radius: 1rem;
            margin-top: auto;
            box-shadow: 0px 0px 7px var(--shadow-clr-dark);
          }
        }

        .testimonials-vide__wrapper:nth-child(2) {
          width: 110%;
        }
      }
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Title */
  #shopify-section-{{ section.id }} .testimonials-title {
    width: 100%;
    font-size: {{ section.settings.title_size }}px;
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.title_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .testimonials-heading {
    width: 100%;
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .testimonials-description {
    font-size: {{ section.settings.description_size }}px;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }
{% endstyle %}

