



<section class="section-header">


  <div class="header-container">
    {% comment %} {% render 'announcement-bar' %} {% endcomment %}
    {%- if template.name == 'index' -%}
      {% render 'menu' %}
    {%- else -%}
      <button type="button" class="header-back" aria-label="Go back" data-header-back>
        <svg class="header-back__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <script>
        (() => {
          const back = document.currentScript.previousElementSibling;
          back.addEventListener('click', () => {
            let cameFromStore = false;
            try {
              cameFromStore = document.referrer && new URL(document.referrer).origin === location.origin;
            } catch (e) {}
            if (cameFromStore && history.length > 1) {
              history.back();
            } else {
              location.href = '{{ routes.root_url }}';
            }
          });
        })();
      </script>
    {%- endif -%}
    <a href="{{ routes.root_url }}" class="header-logo">
      {%- if settings.brand_logo != blank -%}
        {{ 
          settings.brand_logo | image_url: width: 160 | image_tag:
            alt: shop.name,
            width: settings.logo_width,
            loading: 'eager' 
        }}
      {%- else -%}
          <img src="{{ 'logo_dak.svg' | asset_url }}" width="160" height="auto" alt="logo">
      {%- endif -%}
    </a>
    {% render 'shopping-bag' %}
    
  </div>
</section>



{% stylesheet %}



  .section-header {
    width: 100%;
     font-family: var(--font-heading);
     position: relative;

  }
  .header-container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    padding-inline: 2rem;
  }
  .shopping-bag {
    width: 40px;
    path{
      fill: var(--color-primary);
    }
  }
  .header-back {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
  }
  .header-back__icon {
    width: 28px;
    height: 28px;
  }
  .menu {
    width: 40px;
    path{
      fill: var(--color-primary);
    }
  }
  .header-title {
    font-size: var(--type-subtitle);
    color: var(--text-color-primary);
  }
{% endstylesheet %}
{%schema %}
{
  "name": "header",
  "tag": "section",
  "class": "section-header",
  "settings": [
  ],
  "presets": [{ "name": "header" }]
}
{% endschema %}