{% render 'section-typography', section_id: section.id, section_settings: section.settings %}
{%- assign concern = metaobject -%}
{%- assign concern_label = concern.lable | default: section.settings.sub_heading -%}

<section class="concern-page">
  <div class="concern-page__header">
    {%- render 'breadcrumb', title: section.settings.heading -%}
    <h1 class="concern-page__title">
      <span class="concern-page__title-dot" aria-hidden="true"></span>
      <span>{{ section.settings.heading | escape }}</span>
    </h1>

    {%- unless section.settings.sub_heading == '.' -%}
      <h2 class="concern-page__subtitle">{{ concern_label | escape }}</h2>
    {%- endunless -%}

    {%- assign description_field = section.settings.description_field | default: 'description' | strip -%}
    {%- assign concern_description = concern[description_field].value -%}
    {%- if concern_description != blank -%}
      <p class="concern-page__description">{{ concern_description | strip_html }}</p>
    {%- endif -%}
  </div>

  {%- comment -%}
    One grid of every product tagged with this concern. Products are grouped by their step
    collection, and that collection's name is used as the card badge. Each product shows once.
  {%- endcomment -%}
  {%- assign step_order = 'cleanse,exfoliate,treat,hydrate,protect' | split: ',' -%}
  {%- assign shown_ids = ',' -%}
  {%- capture concern_cards -%}
    {%- for step in step_order -%}
      {%- assign step_collection = collections[step] -%}
      {%- if step_collection.id == blank -%}
        {%- for candidate in collections -%}
          {%- assign candidate_handle = candidate.title | handleize -%}
          {%- if candidate_handle == step -%}
            {%- assign step_collection = candidate -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if step_collection.id != blank -%}
        {%- for product in step_collection.products -%}
          {%- assign product_key = ',' | append: product.id | append: ',' -%}
          {%- assign concern_lable = product.metafields.custom.concern.value.lable -%}
          {%- if concern_lable == concern.lable and shown_ids contains product_key -%}
            {%- comment -%} already shown {%- endcomment -%}
          {%- elsif concern_lable == concern.lable -%}
            {%- assign shown_ids = shown_ids | append: product.id | append: ',' -%}
            {%- render 'product-card', product: product, badge_override: step_collection.title -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if concern_cards != blank -%}
    <ul class="all-collections__products concern-page__products" role="list">
      {{ concern_cards }}
    </ul>
  {%- endif -%}
</section>

{%- stylesheet -%}
  .concern-page {
    display: flex;
    flex-direction: column;
    margin: 2rem;
  }

  .concern-page__header {
    margin-bottom: 1.5rem;
  }
  .concern-page__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-family: var(--text-font-primary);
    font-weight: 800;
    font-size: var(--type-title);
    line-height: var(--text-h1-leading);
  }

  .concern-page__products .badge-title {
    text-transform: uppercase;
  }
  .concern-page__title-dot {
    --size: 1.1rem;
    width: var(--size);
    height: var(--size);
    flex: 0 0 var(--size);
    border-radius: 50%;
    background-color: var(--color-dark);
  }
  .concern-page__subtitle {
    gap: 0.5rem;
    font-family: var(--text-font-secondary);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: var(--text-h1-leading);
  }
  .concern-page__description {
    margin-top: 0.5rem;
    color: var(--text-color-muted);
    font-family: var(--text-font-secondary);
    font-size: 12px;
    font-weight: 400;
    line-height: var(--text-h1-leading);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Concern page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by concern"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "subheading",
      "default": "default"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Blackheads, pimples and marks have different causes, and skin that's prone to them is often easy to irritate. Here's a simple way to care for it, one step at a time, with each product's role explained."
    },
    {
      "type": "text",
      "id": "description_field",
      "label": "Concern description field",
      "info": "Key of the concern metaobject field shown under the concern name.",
      "default": "description"
    }
  ]
}
{% endschema %}
