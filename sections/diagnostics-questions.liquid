  .skin-quiz__view--final {
    width: 90%;
    max-width: calc(1300 * var(--fu));
    min-height: calc(100dvh - calc(320 * var(--fu)));
    margin: 0 auto;
    padding-block: calc(32 * var(--fu)) calc(64 * var(--fu));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(32 * var(--fu));
