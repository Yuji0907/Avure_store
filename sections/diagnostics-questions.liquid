{%- comment -%}
  Skin diagnostic quiz: question steps (blocks) -> final step (email + phone) -> analyse screen -> results.
  Everything after the questions runs client-side; answers, the current view and the results are kept
  in sessionStorage so a refresh resumes where the visitor was.

  The recommendation logic reads answers by question key. Keep these keys on the matching blocks:
  concerns, feel, shine, react, breakouts, age, steps.
{%- endcomment -%}

{%- assign slot_ids = 'cleanser_oil,cleanser_gel,exfoliant_salicylic,exfoliant_glycolic,serum_niacinamide,serum_azelaic,serum_vitc,serum_hyaluronic,serum_retinol,moisturizer,spf' | split: ',' -%}

<section
  class="skin-quiz"
  id="SkinQuiz-{{ section.id }}"
  data-skin-quiz
  data-view="quiz"
  data-storage-key="avure-skin-diagnostic-{{ section.id }}"
>
  {%- comment -%} ---------- Questions ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--quiz" data-view-panel="quiz">
    <div
      class="skin-quiz__progress"
      role="progressbar"
      aria-label="Diagnostic progress"
      aria-valuemin="1"
      aria-valuemax="{{ section.blocks.size | plus: 1 }}"
      aria-valuenow="1"
      data-progress
    >
      <span data-progress-fill></span>
    </div>

    <p class="skin-quiz__eyebrow">{{ section.settings.label | escape }}</p>

    {%- for block in section.blocks -%}
      {%- assign max_choices = block.settings.max_choices | default: 1 -%}
      <fieldset
        class="skin-quiz__step"
        data-step
        data-key="{{ block.settings.key | handleize }}"
        data-max="{{ max_choices }}"
        data-why="{{ block.settings.why_text | escape }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        <legend class="skin-quiz__question">{{ block.settings.question | escape }}</legend>
        {%- if block.settings.subtitle != blank -%}
          <p class="skin-quiz__subtitle">({{ block.settings.subtitle | escape }})</p>
        {%- endif -%}

        <div class="skin-quiz__chips">
          {%- assign answer_lines = block.settings.answers | newline_to_br | split: '<br />' -%}
          {%- for line in answer_lines -%}
            {%- assign line = line | strip -%}
            {%- if line == blank -%}{%- continue -%}{%- endif -%}
            {%- assign parts = line | split: '|' -%}
            {%- assign answer_label = parts[0] | strip -%}
            {%- assign answer_value = parts[1] | default: answer_label | strip | handleize -%}
            <button
              type="button"
              class="skin-quiz__chip"
              aria-pressed="false"
              data-value="{{ answer_value | escape }}"
              data-label="{{ answer_label | escape }}"
            >
              {{- answer_label | escape -}}
            </button>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}

    <div class="skin-quiz__footer">
      <p class="skin-quiz__error" data-error role="alert" hidden>{{ section.settings.error_text | escape }}</p>
      <div class="skin-quiz__why">
        <p class="skin-quiz__why-title">{{ section.settings.why_heading | escape }}</p>
        <p class="skin-quiz__why-text" data-why-text></p>
      </div>
      <div class="skin-quiz__nav">
        <button type="button" class="avure-outline-button" data-previous>Previous</button>
        <button type="button" class="avure-button" data-next>Next</button>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Final step: email + phone ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--final" data-view-panel="final" hidden>
    <div class="skin-quiz__progress skin-quiz__progress--full" aria-hidden="true"><span></span></div>
    <p class="skin-quiz__eyebrow">{{ section.settings.label | escape }}</p>
    <h2 class="skin-quiz__question">{{ section.settings.final_heading | escape }}</h2>

    {%- form 'customer', class: 'skin-quiz__form' -%}
      <input type="hidden" name="contact[tags]" value="diagnostic" data-tags>
      <input type="hidden" name="contact[note]" value="" data-note>
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      <label class="skin-quiz__field">
        <span class="visually-hidden">Email</span>
        <input
          class="avure-input"
          type="email"
          name="contact[email]"
          placeholder="Email *"
          autocomplete="email"
          required
          data-email
        >
      </label>
      <label class="skin-quiz__field skin-quiz__field--phone">
        <span class="skin-quiz__prefix" aria-hidden="true">+213</span>
        <input
          class="avure-input"
          type="tel"
          inputmode="tel"
          placeholder="Phone number *"
          autocomplete="tel-national"
          aria-label="Phone number"
          required
          data-phone
        >
      </label>
      <p class="skin-quiz__error" data-final-error role="alert" hidden></p>
      <p class="skin-quiz__consent">{{ section.settings.consent_text }}</p>

      <div class="skin-quiz__nav">
        <button type="button" class="avure-outline-button" data-final-previous>Previous</button>
        <button type="submit" class="avure-button">OK</button>
      </div>
    {%- endform -%}
  </div>

  {%- comment -%} ---------- Analyse ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--analyse" data-view-panel="analyse" hidden>
    {%- if section.settings.analyse_image != blank -%}
      {{
        section.settings.analyse_image
        | image_url: width: 1200
        | image_tag: class: 'skin-quiz__analyse-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__analyse-image" src="{{ 'Skin diagnostic - hero.png' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
    {%- endif -%}
    <div class="skin-quiz__analyse-content">
      <span class="skin-quiz__spinner" aria-hidden="true"></span>
      <p class="skin-quiz__analyse-text" role="status">{{ section.settings.analyse_text | escape }}</p>
    </div>
  </div>

  {%- comment -%} ---------- Results ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--results" data-view-panel="results" hidden>
    {%- if section.settings.results_image != blank -%}
      {{
        section.settings.results_image
        | image_url: width: 1200
        | image_tag: class: 'skin-quiz__results-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__results-image" src="{{ 'Skin diagnostic - hero.png' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
    {%- endif -%}

    <div class="skin-quiz__results">
      <p class="skin-quiz__eyebrow">{{ section.settings.results_eyebrow | escape }}</p>

      <details class="skin-quiz__panel" open>
        <summary>Your skin type <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <h3 class="skin-quiz__type-name" data-type-name></h3>
          <p class="skin-quiz__type-text" data-type-text></p>
          <div class="skin-quiz__sensitive" data-sensitive hidden>
            <h4>Easily irritated</h4>
            <p>{{ section.settings.sensitive_text | escape }}</p>
          </div>
        </div>
      </details>

      <details class="skin-quiz__panel" open>
        <summary>Your priorities <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <ul class="skin-quiz__priorities" data-priorities></ul>
        </div>
      </details>

      <details class="skin-quiz__panel" open>
        <summary>Your routine <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <div class="skin-quiz__routine-card">
            <ul class="skin-quiz__routine" data-routine></ul>
            <div class="skin-quiz__total">
              <span>Total</span>
              <span data-total></span>
            </div>
            <p class="skin-quiz__error" data-cart-error role="alert" hidden></p>
            <button type="button" class="avure-button" data-add-routine></button>
          </div>
        </div>
      </details>

      <details class="skin-quiz__panel">
        <summary>How to use <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body skin-quiz__how">
          <div>
            <h4>Morning</h4>
            <ol data-morning></ol>
          </div>
          <div>
            <h4>Evening</h4>
            <ol data-evening></ol>
          </div>
        </div>
      </details>

      <button type="button" class="skin-quiz__restart" data-restart>Retake the diagnostic</button>
    </div>
  </div>

  {%- comment -%} Data for the client-side logic {%- endcomment -%}
  <script type="application/json" data-quiz-config>
    {
      "types": {
        "dry": { "name": {{ section.settings.type_dry_name | json }}, "text": {{ section.settings.type_dry_text | json }} },
        "normal": { "name": {{ section.settings.type_normal_name | json }}, "text": {{ section.settings.type_normal_text | json }} },
        "oily": { "name": {{ section.settings.type_oily_name | json }}, "text": {{ section.settings.type_oily_text | json }} },
        "combination": { "name": {{ section.settings.type_combination_name | json }}, "text": {{ section.settings.type_combination_text | json }} }
      },
      "products": {
        {%- assign first_product = true -%}
        {%- for slot in slot_ids -%}
          {%- assign slot_product = section.settings[slot] -%}
          {%- if slot_product != blank -%}
            {%- assign slot_variant = slot_product.selected_or_first_available_variant -%}
            {%- unless first_product -%},{%- endunless -%}
            {%- assign first_product = false -%}
            {{ slot | json }}: {
              "title": {{ slot_product.title | json }},
              "url": {{ slot_product.url | json }},
              "image": {{ slot_product.featured_image | image_url: width: 240 | json }},
              "variantId": {{ slot_variant.id | json }},
              "price": {{ slot_variant.price | json }},
              "available": {{ slot_variant.available | json }}
            }
          {%- endif -%}
        {%- endfor -%}
      }
    }
  </script>
</section>

<script>
  (() => {
    const root = document.getElementById('SkinQuiz-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const config = JSON.parse(root.querySelector('[data-quiz-config]').textContent);
    const STORAGE = root.dataset.storageKey;
    const PHONE_RE = /^(\+213|0)[567]\d{8}$/;
    const ANALYSE_MS = 2500;

    const steps = Array.from(root.querySelectorAll('[data-step]'));
    const fill = root.querySelector('[data-progress-fill]');
    const progress = root.querySelector('[data-progress]');
    const error = root.querySelector('[data-error]');
    const whyText = root.querySelector('[data-why-text]');
    const prevBtn = root.querySelector('[data-previous]');
    const nextBtn = root.querySelector('[data-next]');

    /* ---------- state ---------- */
    const load = () => {
      try {
        return JSON.parse(sessionStorage.getItem(STORAGE)) || {};
      } catch (e) {
        return {};
      }
    };
    let state = Object.assign({ view: 'quiz', step: 0, answers: {} }, load());
    const save = () => {
      try {
        sessionStorage.setItem(STORAGE, JSON.stringify(state));
      } catch (e) {}
    };

    /* Sections placed after the quiz (science, footer) only show with the results.
       CSS (:has) handles it; this is a fallback for browsers without :has. Looked up lazily,
       because those sections are parsed after this script runs. */
    const followingSections = () => {
      const list = [];
      let sib = root.closest('.shopify-section')?.nextElementSibling;
      while (sib) {
        if (sib.classList.contains('shopify-section')) list.push(sib);
        sib = sib.nextElementSibling;
      }
      return list;
    };

    const showView = (view) => {
      state.view = view;
      root.dataset.view = view;
      root.querySelectorAll('[data-view-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.viewPanel !== view;
      });
      if (!CSS.supports('selector(:has(*))')) {
        followingSections().forEach((s) => (s.style.display = view === 'results' ? '' : 'none'));
      }
      save();
      window.scrollTo({ top: 0 });
    };

    /* ---------- questions ---------- */
    const answersFor = (key) => state.answers[key] || [];
    const first = (key) => answersFor(key)[0];

    const renderStep = () => {
      steps.forEach((step, i) => {
        step.hidden = i !== state.step;
        const chosen = answersFor(step.dataset.key);
        step.querySelectorAll('.skin-quiz__chip').forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chosen.includes(chip.dataset.value)));
        });
      });
      const current = steps[state.step];
      whyText.textContent = current ? current.dataset.why || '' : '';
      const total = steps.length + 1;
      fill.style.width = `${((state.step + 1) / total) * 100}%`;
      progress.setAttribute('aria-valuenow', String(state.step + 1));
      prevBtn.disabled = state.step === 0;
      error.hidden = true;
    };

    root.addEventListener('click', (e) => {
      const chip = e.target.closest('.skin-quiz__chip');
      if (!chip) return;
      const step = chip.closest('[data-step]');
      const key = step.dataset.key;
      const max = Number(step.dataset.max) || 1;
      let chosen = answersFor(key).slice();
      const value = chip.dataset.value;

      if (chosen.includes(value)) {
        chosen = chosen.filter((v) => v !== value);
      } else if (max === 1) {
        chosen = [value];
      } else if (chosen.length < max) {
        chosen.push(value); // selection order = order of importance
      } else {
        return;
      }
      state.answers[key] = chosen;
      save();
      renderStep();
    });

    prevBtn.addEventListener('click', () => {
      if (state.step > 0) {
        state.step -= 1;
        save();
        renderStep();
      }
    });

    nextBtn.addEventListener('click', () => {
      const current = steps[state.step];
      if (answersFor(current.dataset.key).length === 0) {
        error.hidden = false;
        return;
      }
      if (state.step < steps.length - 1) {
        state.step += 1;
        save();
        renderStep();
      } else {
        showView('final');
      }
    });

    /* ---------- recommendation logic ---------- */
    const computeResults = () => {
      const concerns = answersFor('concerns');
      const feel = first('feel') || 'normal';
      const shine = first('shine');
      const react = first('react');
      const age = first('age');

      let type = feel;
      if (feel === 'normal' && shine === 'tzone') type = 'combination';
      if (feel === 'normal' && shine === 'all') type = 'oily';
      if (!config.types[type]) type = 'normal';

      const sensitive = react === 'high' || (react === 'mid' && concerns.includes('redness'));

      const cleanse = type === 'dry' || type === 'normal' ? 'cleanser_oil' : 'cleanser_gel';

      let treat = 'serum_hyaluronic';
      switch (concerns[0]) {
        case 'breakouts':
        case 'pores':
          treat = 'serum_niacinamide';
          break;
        case 'redness':
          treat = 'serum_azelaic';
          break;
        case 'dull':
          treat = sensitive ? 'serum_niacinamide' : 'serum_vitc';
          break;
        case 'dryness':
          treat = 'serum_hyaluronic';
          break;
        case 'lines':
          treat = (age === '35' || age === '45') && !sensitive ? 'serum_retinol' : 'serum_hyaluronic';
          break;
        default:
          treat = 'serum_hyaluronic';
      }

      const complete = first('steps') === 'complete';
      let exfoliate = null;
      if (complete && !sensitive) {
        exfoliate = type === 'oily' || first('breakouts') === 'often' ? 'exfoliant_salicylic' : 'exfoliant_glycolic';
      }

      const routine = complete
        ? [
            ['cleanse', cleanse],
            exfoliate && ['exfoliate', exfoliate],
            ['treat', treat],
            ['moisturize', 'moisturizer'],
            ['protect', 'spf'],
          ]
        : [
            ['cleanse', cleanse],
            ['treat', treat],
            ['protect', 'spf'],
          ];

      return {
        type,
        sensitive,
        concerns,
        routine: routine.filter(Boolean).map(([step, slot]) => ({ step, slot })),
      };
    };

    /* ---------- final step ---------- */
    const finalForm = root.querySelector('.skin-quiz__form');
    finalForm.noValidate = true;
    const finalError = root.querySelector('[data-final-error]');
    const normalizePhone = (raw) => {
      let v = raw.replace(/[\s.-]/g, '');
      if (/^[567]\d{8}$/.test(v)) v = '0' + v;
      if (/^213/.test(v)) v = '+' + v;
      return v;
    };

    root.querySelector('[data-final-previous]').addEventListener('click', () => {
      state.step = steps.length - 1;
      showView('quiz');
      renderStep();
    });

    finalForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = finalForm.querySelector('[data-email]');
      const phone = normalizePhone(finalForm.querySelector('[data-phone]').value);
      const problems = [];
      if (!email.value.trim() || !email.checkValidity()) problems.push('Please enter a valid email.');
      if (!PHONE_RE.test(phone)) problems.push('Please enter a valid phone number.');
      if (problems.length) {
        finalError.textContent = problems.join(' ');
        finalError.hidden = false;
        return;
      }
      finalError.hidden = true;

      const results = computeResults();
      state.results = results;
      finalForm.querySelector('[data-tags]').value = [
        'diagnostic',
        `skin-${results.type}`,
        `sensitive-${results.sensitive ? 'yes' : 'no'}`,
      ].join(', ');
      finalForm.querySelector('[data-note]').value = `Phone: ${phone}`;

      // Fire and forget: the results never wait on the signup.
      fetch(finalForm.action, { method: 'POST', body: new FormData(finalForm), credentials: 'same-origin' }).catch(
        () => {}
      );

      showView('analyse');
      setTimeout(() => {
        renderResults();
        showView('results');
      }, ANALYSE_MS);
    });

    /* ---------- results ---------- */
    const STEP_LABELS = {
      cleanse: 'Cleanse',
      exfoliate: 'Exfoliate',
      treat: 'Treat',
      moisturize: 'Moisturize',
      protect: 'Protect',
    };
    const money = (cents) =>
      (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' DA';
    const el = (tag, cls, text) => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text != null) node.textContent = text;
      return node;
    };
    const labelFor = (key, value) =>
      root.querySelector(`[data-step][data-key="${key}"] [data-value="${CSS.escape(value)}"]`)?.dataset.label || value;

    const renderResults = () => {
      const results = state.results || computeResults();
      state.results = results;
      const type = config.types[results.type];

      root.querySelector('[data-type-name]').textContent = type.name;
      root.querySelector('[data-type-text]').textContent = type.text;
      root.querySelector('[data-sensitive]').hidden = !results.sensitive;

      const priorities = root.querySelector('[data-priorities]');
      priorities.replaceChildren(
        ...results.concerns.map((value, i) => el('li', null, `${i + 1}. ${labelFor('concerns', value)}`))
      );

      const items = results.routine
        .map((r) => ({ ...r, product: config.products[r.slot] }))
        .filter((r) => r.product);

      const list = root.querySelector('[data-routine]');
      list.replaceChildren(
        ...items.map((item) => {
          const li = el('li', 'skin-quiz__routine-item');
          const link = el('a', 'skin-quiz__routine-link');
          link.href = item.product.url;
          if (item.product.image) {
            const img = el('img');
            img.src = item.product.image;
            img.alt = '';
            img.loading = 'lazy';
            link.append(img);
          }
          const info = el('span', 'skin-quiz__routine-info');
          info.append(el('span', 'skin-quiz__routine-step', STEP_LABELS[item.step]));
          info.append(el('span', 'skin-quiz__routine-title', item.product.title));
          link.append(info);
          const price = item.product.available
            ? el('span', 'skin-quiz__routine-price', money(item.product.price))
            : el('span', 'skin-quiz__routine-price is-unavailable', 'Out of stock');
          li.append(link, price);
          return li;
        })
      );

      const buyable = items.filter((i) => i.product.available && i.product.variantId);
      const total = buyable.reduce((sum, i) => sum + i.product.price, 0);
      root.querySelector('[data-total]').textContent = money(total);
      const addBtn = root.querySelector('[data-add-routine]');
      addBtn.textContent = `Add to cart - ${money(total)}`;
      addBtn.disabled = buyable.length === 0;
      addBtn.dataset.variants = JSON.stringify(buyable.map((i) => i.product.variantId));

      // How to use, built from the routine
      const titleFor = (step) => items.find((i) => i.step === step)?.product.title;
      const morning = [];
      const evening = [];
      const add = (arr, step, note) => {
        const t = titleFor(step);
        if (t) arr.push(note ? `${t} (${note})` : t);
      };
      const treatSlot = items.find((i) => i.step === 'treat')?.slot;
      add(morning, 'cleanse');
      if (treatSlot && treatSlot !== 'serum_retinol') add(morning, 'treat');
      add(morning, 'moisturize');
      add(morning, 'protect');
      add(evening, 'cleanse');
      add(evening, 'exfoliate', '2–3 evenings a week');
      if (treatSlot !== 'serum_vitc') add(evening, 'treat');
      add(evening, 'moisturize');
      const fillList = (selector, entries) => {
        const list = root.querySelector(selector);
        list.replaceChildren(...entries.map((t) => el('li', null, t)));
        list.parentElement.hidden = entries.length === 0;
      };
      fillList('[data-morning]', morning);
      fillList('[data-evening]', evening);
      save();
    };

    root.querySelector('[data-add-routine]').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const cartError = root.querySelector('[data-cart-error]');
      const ids = JSON.parse(btn.dataset.variants || '[]');
      if (!ids.length) return;
      btn.disabled = true;
      cartError.hidden = true;
      try {
        const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        const res = await fetch(`${rootUrl}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: ids.map((id) => ({ id, quantity: 1 })) }),
        });
        if (!res.ok) throw new Error((await res.json()).description || 'Could not add to cart');
        const cart = await (await fetch(`${rootUrl}cart.js`)).json();
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        if (window.openCartDrawer) window.openCartDrawer();
      } catch (err) {
        cartError.textContent = err.message;
        cartError.hidden = false;
      } finally {
        btn.disabled = false;
      }
    });

    root.querySelector('[data-restart]').addEventListener('click', () => {
      state = { view: 'quiz', step: 0, answers: {} };
      save();
      renderStep();
      showView('quiz');
    });

    /* ---------- boot ---------- */
    if (state.step >= steps.length) state.step = 0;
    renderStep();
    if (state.view === 'results' || state.view === 'analyse') {
      renderResults();
      showView('results');
    } else {
      showView(state.view === 'final' ? 'final' : 'quiz');
    }
  })();
</script>

{% style %}
  #SkinQuiz-{{ section.id }} {
    --skin-quiz-plus: url("{{ 'plus-small.svg' | asset_url }}");
    --skin-quiz-minus: url("{{ 'minus-small.svg' | asset_url }}");
  }
{% endstyle %}

{%- stylesheet -%}
  .shopify-section:has([data-skin-quiz]:not([data-view='results'])) ~ .shopify-section {
    display: none;
  }
  .skin-quiz {
    width: 100%;
    font-family: var(--text-font-secondary);
    color: var(--text-color-secondary);
  }
  .skin-quiz [hidden] {
    display: none !important;
  }
  .skin-quiz .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* quiz + final layout */
  .skin-quiz__view--quiz,
  .skin-quiz__view--final {
    width: 90%;
    max-width: 650px;
    min-height: calc(100dvh - 160px);
    margin: 0 auto;
    padding-block: 1rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .skin-quiz__progress {
    width: 100%;
    height: 4px;
    border-radius: 99px;
    overflow: hidden;
    background: var(--avure-black-200);
  }
  .skin-quiz__progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--bg-dark);
    transition: width 0.25s ease;
  }
  .skin-quiz__progress--full span {
    width: 100%;
  }
  .skin-quiz__eyebrow {
    margin-top: 1.5rem;
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-align: center;
  }
  .skin-quiz__step {
    width: 100%;
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .skin-quiz__question {
    width: 100%;
    padding: 0;
    font-family: var(--text-font-primary);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: center;
  }
  .skin-quiz__subtitle {
    font-size: var(--type-label);
    color: var(--text-color-muted);
    text-align: center;
  }
  .skin-quiz__chips {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .skin-quiz__chip {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-dark);
    border-radius: 999px;
    background: var(--bg-light);
    color: var(--text-color-secondary);
    font-family: var(--text-font-secondary);
    font-size: var(--type-body-sm);
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
  }
  .skin-quiz__chip[aria-pressed='true'] {
    background: var(--bg-dark);
    color: var(--text-color-primary);
  }
  .skin-quiz__footer {
    width: 100%;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .skin-quiz__error {
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-align: center;
    color: var(--avure-error);
  }
  .skin-quiz__why {
    text-align: center;
  }
  .skin-quiz__why-title {
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .skin-quiz__why-text {
    margin-top: 0.25rem;
    font-family: var(--text-font-accent);
    font-size: var(--type-caption);
    color: var(--text-color-muted);
  }
  .skin-quiz__nav {
    width: 100%;
    display: flex;
    gap: 0.75rem;
  }
  .skin-quiz__nav > * {
    flex: 1 1 0;
    min-height: 48px;
  }
  .skin-quiz__nav button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* final */
  .skin-quiz__form {
    width: 100%;
    margin-top: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skin-quiz__field {
    display: flex;
    align-items: stretch;
  }
  .skin-quiz__prefix {
    display: grid;
    place-items: center;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-dark);
    border-right: 0;
    font-size: var(--type-input);
  }
  .skin-quiz__consent {
    font-size: var(--type-caption);
    color: var(--text-color-muted);
    text-align: center;
  }
  .skin-quiz__form .skin-quiz__nav {
    margin-top: auto;
  }

  /* analyse */
  .skin-quiz__view--analyse {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--bg-dark);
  }
  .skin-quiz__analyse-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }
  .skin-quiz__analyse-content {
    position: relative;
    width: 80%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    color: var(--text-color-primary);
    text-align: center;
  }
  .skin-quiz__analyse-text {
    font-family: var(--text-font-primary);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .skin-quiz__spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: skin-quiz-spin 0.8s linear infinite;
  }
  @keyframes skin-quiz-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* results */
  .skin-quiz__results-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    object-position: top;
  }
  .skin-quiz__results {
    width: 90%;
    margin: 0 auto;
    padding-block: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
  }
  .skin-quiz__results .skin-quiz__eyebrow {
    margin: 0 0 1rem;
  }
  .skin-quiz__panel {
    border-top: 1px solid #222;
  }
  .skin-quiz__panel:last-of-type {
    border-bottom: 1px solid #222;
  }
  .skin-quiz__panel summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 10px 0;
    font-family: var(--text-font-primary);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }
  .skin-quiz__panel summary::-webkit-details-marker {
    display: none;
  }
  .skin-quiz__panel-icon {
    width: 14px;
    height: 14px;
    background: var(--fill-dark);
    -webkit-mask: var(--skin-quiz-plus) center / contain no-repeat;
    mask: var(--skin-quiz-plus) center / contain no-repeat;
  }
  .skin-quiz__panel[open] .skin-quiz__panel-icon {
    -webkit-mask-image: var(--skin-quiz-minus);
    mask-image: var(--skin-quiz-minus);
  }
  .skin-quiz__panel-body {
    padding-bottom: 1rem;
    font-size: var(--type-body-sm);
    line-height: var(--leading-normal);
  }
  .skin-quiz__type-name {
    font-family: var(--text-font-primary);
    font-size: 18px;
    font-weight: 700;
  }
  .skin-quiz__type-text {
    margin-top: 0.35rem;
    color: var(--text-color-muted);
    text-align: justify;
  }
  .skin-quiz__sensitive {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-dark);
    border-radius: 8px;
  }
  .skin-quiz__sensitive h4,
  .skin-quiz__how h4 {
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .skin-quiz__priorities {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-weight: 500;
  }
  .skin-quiz__routine-card {
    padding: 1rem;
    border-radius: 12px;
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skin-quiz__routine {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .skin-quiz__routine-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .skin-quiz__routine-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .skin-quiz__routine-link img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--bg-light);
  }
  .skin-quiz__routine-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .skin-quiz__routine-step {
    font-family: var(--text-font-accent);
    font-size: var(--type-caption);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-color-muted);
  }
  .skin-quiz__routine-title {
    font-family: var(--text-font-primary);
    font-size: 13px;
    font-weight: 700;
  }
  .skin-quiz__routine-price {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
  }
  .skin-quiz__routine-price.is-unavailable {
    font-family: var(--text-font-accent);
    font-size: var(--type-caption);
    text-transform: uppercase;
    color: var(--text-color-muted);
  }
  .skin-quiz__total {
    display: flex;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--avure-black-300);
    font-weight: 700;
  }
  .skin-quiz__routine-card .avure-button {
    min-height: 48px;
  }
  .skin-quiz__how {
    display: grid;
    gap: 1rem;
  }
  .skin-quiz__how ol {
    padding-left: 1.2rem;
    list-style: decimal;
  }
  .skin-quiz__restart {
    margin-top: 1.5rem;
    align-self: center;
    border: 0;
    background: none;
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    text-transform: uppercase;
    text-decoration: underline;
    cursor: pointer;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Skin diagnostic quiz",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Skin diagnostic©" },
    { "type": "text", "id": "why_heading", "label": "Why heading", "default": "Why this question" },
    { "type": "text", "id": "error_text", "label": "No answer error", "default": "Please select an answer" },

    { "type": "header", "content": "Final step" },
    {
      "type": "text",
      "id": "final_heading",
      "label": "Heading",
      "default": "Diagnostics completed! Please provide your e-mail."
    },
    {
      "type": "richtext",
      "id": "consent_text",
      "label": "Consent text",
      "default": "<p>By clicking OK, you agree to receive your results and skincare tips by email. You can unsubscribe at any time.</p>"
    },

    { "type": "header", "content": "Analyse screen" },
    { "type": "image_picker", "id": "analyse_image", "label": "Image" },
    { "type": "text", "id": "analyse_text", "label": "Text", "default": "Working out what your skin needs..." },

    { "type": "header", "content": "Results" },
    { "type": "image_picker", "id": "results_image", "label": "Hero image" },
    { "type": "text", "id": "results_eyebrow", "label": "Eyebrow", "default": "//Your skin profile" },
    { "type": "text", "id": "type_dry_name", "label": "Dry: name", "default": "Dry skin" },
    {
      "type": "textarea",
      "id": "type_dry_text",
      "label": "Dry: description",
      "default": "Your skin makes less oil than it needs, so it can feel tight and look flaky. Gentle cleansing and steady hydration matter most."
    },
    { "type": "text", "id": "type_normal_name", "label": "Normal: name", "default": "Normal skin" },
    {
      "type": "textarea",
      "id": "type_normal_text",
      "label": "Normal: description",
      "default": "Your skin is mostly balanced: not too oily, not too dry. A simple routine keeps it that way."
    },
    { "type": "text", "id": "type_oily_name", "label": "Oily: name", "default": "Oily skin" },
    {
      "type": "textarea",
      "id": "type_oily_text",
      "label": "Oily: description",
      "default": "Your skin makes extra oil across the face, which can lead to shine and clogged pores. Light textures and regular exfoliation help."
    },
    { "type": "text", "id": "type_combination_name", "label": "Combination: name", "default": "Combination skin" },
    {
      "type": "textarea",
      "id": "type_combination_text",
      "label": "Combination: description",
      "default": "Your T-zone gets oily while your cheeks stay normal or dry. Balance is the goal: hydrate everywhere, control shine where it shows."
    },
    {
      "type": "textarea",
      "id": "sensitive_text",
      "label": "Easily irritated: text",
      "default": "Your skin reacts quickly to new products. We kept your routine gentle and left out strong exfoliants."
    },

    { "type": "header", "content": "Routine products" },
    { "type": "product", "id": "cleanser_oil", "label": "Cleanser: oil (dry / normal skin)" },
    { "type": "product", "id": "cleanser_gel", "label": "Cleanser: gel (oily / combination skin)" },
    { "type": "product", "id": "exfoliant_salicylic", "label": "Exfoliant: salicylic acid" },
    { "type": "product", "id": "exfoliant_glycolic", "label": "Exfoliant: glycolic acid" },
    { "type": "product", "id": "serum_niacinamide", "label": "Serum: niacinamide" },
    { "type": "product", "id": "serum_azelaic", "label": "Serum: azelaic acid" },
    { "type": "product", "id": "serum_vitc", "label": "Serum: vitamin C" },
    { "type": "product", "id": "serum_hyaluronic", "label": "Serum: hyaluronic acid" },
    { "type": "product", "id": "serum_retinol", "label": "Serum: retinol" },
    { "type": "product", "id": "moisturizer", "label": "Moisturizer" },
    { "type": "product", "id": "spf", "label": "Sunscreen (SPF)" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "e.g. up to three, in order of importance" },
        { "type": "textarea", "id": "why_text", "label": "Why this question" },
        {
          "type": "text",
          "id": "key",
          "label": "Key",
          "info": "Used by the recommendation logic: concerns, feel, shine, react, breakouts, age, steps"
        },
        {
          "type": "range",
          "id": "max_choices",
          "label": "Maximum answers",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        },
        {
          "type": "textarea",
          "id": "answers",
          "label": "Answers",
          "info": "One per line, as label|value"
        }
      ]
    }
  ],
  "presets": [{ "name": "Skin diagnostic quiz" }]
}
{% endschema %}
