{% render 'section-typography', section_id: section.id, section_settings: section.settings %}
<section id="Diagnostics-{{ section.id }}" class="diagnostics">
	<div class="diagnostics__container">
        
        
        
        <div class="diagnostics__progress"
            role="progressbar" 
            aria-label="Question progress" 
            aria-valuemin="1" aria-valuemax="3" 
            aria-valuenow="1" data-progress>
            
			<span data-progress-fill></span>
		</div>

        <h3>{{ section.settings.label | default: 'Find your plan' | escape }}</h3>
        
		<form data-diagnostics-form novalidate>
            <div class="diagnostics__page" data-page>
                <h3>What would you most like to improve?</h3>
                <p>(up to three, in order of importance)</p>
				<fieldset>
                    <label><input type="checkbox" name="goal-{{ section.id }}" required> Blackheads or breakouts</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Redness</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Dull or uneven-looking skin</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Dryness or tightness</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Visible pores</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Fine lines or firmness</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Nothing in particular</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Daily sun protection</label>
				</fieldset>
                
			</div>
            <div class="diagnostics__page" data-page hidden>
                <h3>Thirty minutes after washing, with nothing applied, how does your skin feel?</h3>
                <p>(up to three, in order of importance)</p>
				<fieldset>
                    <label><input type="checkbox" name="goal-{{ section.id }}" required>  Tight or uncomfortable</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Comfortable</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Shiny all over</label>
					<label><input type="checkbox" name="goal-{{ section.id }}"> Shiny in some areas</label>

				</fieldset>
                
			</div>
            
            <div class="questions-footer">
                <h2>{{ section.settings.footer_heading | default: 'Find your plan' | escape }}</h2>
                <p>{{ section.settings.footer_text | default: 'Find your plan' | escape }}</p>
            </div>




			<p class="diagnostics__error" data-error role="alert" hidden>Please answer each question before continuing.</p>
			<div class="diagnostics__navigation" data-navigation>
				<button type="button" class=" avure-outline-button" data-previous disabled>Previous</button>
				<button type="button" class="avure-button" data-next>Next</button>
			</div>
			<div class="diagnostics__complete" data-complete role="status" hidden>
				<h3>Your questions are complete</h3>
				<p>Your answers are ready to help guide your plan.</p>
			</div>
		</form>

	</div>
</section>
{%- stylesheet -%}
.diagnostics__container {
  max-width: 650px;
  height: 100dvh;
  /* padding-block: 5rem; */
  display: flex;
  flex-direction: column;
  >h3{
    font-family: var(--text-font-accent);
    font-weight: 500;
    font-size:var(--text-h4);
    color:var(--text-color-secondary);
    margin-top: 4rem;
    text-align:center;
        text-transform: uppercase;
  }
  .questions-footer{
    display: flex;
    flex-direction: column;
      font-family: var(--text-font-accent);
      align-items: center;
    h2{
        font-weight: 600;
        font-size:var(--text-h3);
        color:var(--text-color-secondary);
        text-align:center;
        letter-spacing: -1.44px;
        text-transform: uppercase;
    }
    p{
        width: 60%;
        font-weight: 500;
        font-size:var(--text-lg);
        color:var(--text-color-secondary);
        text-transform: capitalize;
        text-align:center;
    }
  }
  fieldset{
     display: flex;
    flex-direction: row;
    align-items: center; 
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.3rem;

  }
  fieldset label {
    flex-shrink: 1;
    position: relative;
    padding: 1rem;
    font-family: var(--text-font-primary);
    font-weight: 500;
    font-size:var(--text-h3);
    border-radius: 1rem;
    line-height: 1;
    border: 1px solid var(--color-dark);
      color: var(--text-color-secondary);
      background-color: var(--bg-light);
      letter-spacing: -1.44px;
    input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }

    &:has(input:checked) {
      color: var(--text-color-primary);
      background-color: var(--bg-dark);
    }
  }
}
{%- endstylesheet -%}
<style>
	#Diagnostics-{{ section.id }} { 
    width: 100%;
    height: 100dvh;
    inset: 0;
    }
	#Diagnostics-{{ section.id }} .diagnostics__container { 
        margin: 0 auto;
        display:flex
     }
	#Diagnostics-{{ section.id }} h2 { text-align: center; }
	#Diagnostics-{{ section.id }} .diagnostics__progress-copy { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; }
	#Diagnostics-{{ section.id }} .diagnostics__progress { height: 8px; overflow: hidden; border-radius: 99px; background: #e8e8e8; }
	#Diagnostics-{{ section.id }} [data-progress-fill] { display: block; width: 33.333%; height: 100%; background: #222; transition: width 200ms ease; }
	#Diagnostics-{{ section.id }} form {
         margin-top: 28px; 
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        align-items: center;
}

	#Diagnostics-{{ section.id }} .diagnostics__page h3{
        width: 80%;
        font-weight: 600;
        font-size:var(--text-h3);
        color:var(--text-color-secondary);
        text-align:center;
        letter-spacing: -1.44px;
        text-transform: uppercase;

        }
    #Diagnostics-{{ section.id }} .diagnostics__page p{
            font-weight: 500;
            font-size:var(--text-lg);
            color:var(--text-color-secondary);
            text-transform: capitalize;
            text-align:center;
        }
	#Diagnostics-{{ section.id }} .diagnostics__page  {
         width: 100%;
         font-family: var(--text-font-primary);
         display: flex;
         flex-direction: column;    
         align-items: center;

        }

	#Diagnostics-{{ section.id }} fieldset { border: 0; padding: 0; }
	#Diagnostics-{{ section.id }} legend { font-weight: 600; margin-bottom: 10px; }
	#Diagnostics-{{ section.id }} label { display: flex; align-items: center; gap: 10px;  cursor: pointer; }
	#Diagnostics-{{ section.id }} input { accent-color: #222; }
	#Diagnostics-{{ section.id }} .diagnostics__navigation { 
        width: 100%;
        display: flex; 
        justify-content: space-between;
         gap: 12px; margin-top: 28px;
         }
	#Diagnostics-{{ section.id }} .diagnostics__button { padding: 12px 24px; border: 1px solid #222; border-radius: 4px; background: #222; color: #fff; cursor: pointer; }
	#Diagnostics-{{ section.id }} .diagnostics__button--previous { background: transparent; color: #222; }
	#Diagnostics-{{ section.id }} .diagnostics__button:disabled { opacity: .45; cursor: not-allowed; }
	#Diagnostics-{{ section.id }} .diagnostics__error { color: #b42318; }
	#Diagnostics-{{ section.id }} .diagnostics__complete { padding: 24px; background: #f5f5f5; }
	#Diagnostics-{{ section.id }} [hidden] { display: none !important; }
</style>

<script>
	(() => {
		const root = document.getElementById('Diagnostics-{{ section.id }}');
		if (!root || root.dataset.initialized) return;
		root.dataset.initialized = 'true';

		const pages = Array.from(root.querySelectorAll('[data-page]'));
		const previous = root.querySelector('[data-previous]');
		const next = root.querySelector('[data-next]');
		const progress = root.querySelector('[data-progress]');
		const fill = root.querySelector('[data-progress-fill]');
		const pageLabel = root.querySelector('[data-progress-label]');
		const percentLabel = root.querySelector('[data-progress-percent]');
		const error = root.querySelector('[data-error]');
		let current = 0;

		const renderPage = () => {
			pages.forEach((page, index) => {
				page.hidden = index !== current;
				page.setAttribute('aria-hidden', String(index !== current));
			});
			const percent = Math.round(((current + 1) / pages.length) * 100);
			fill.style.width = `${percent}%`;
			pageLabel.textContent = `Page ${current + 1} of ${pages.length}`;
			percentLabel.textContent = `${percent}%`;
			progress.setAttribute('aria-valuenow', String(current + 1));
			previous.disabled = current === 0;
			next.textContent = current === pages.length - 1 ? 'Finish' : 'Next';
			error.hidden = true;
		};

		previous.addEventListener('click', () => {
			if (current > 0) {
				current -= 1;
				renderPage();
			}
		});

		next.addEventListener('click', () => {
			const requiredNames = new Set(Array.from(pages[current].querySelectorAll('input[required]'), (input) => input.name));
			const allAnswered = Array.from(requiredNames).every((name) =>
				pages[current].querySelector(`input[name="${name}"]:checked`)
			);

			if (!allAnswered) {
				error.hidden = false;
				return;
			}

			if (current < pages.length - 1) {
				current += 1;
				renderPage();
				return;
			}

			fill.style.width = '100%';
			percentLabel.textContent = '100%';
			progress.setAttribute('aria-valuenow', String(pages.length));
			root.querySelector('[data-navigation]').hidden = true;
			pages.forEach((page) => { page.hidden = true; });
			root.querySelector('[data-complete]').hidden = false;
		});
	})();
</script>

