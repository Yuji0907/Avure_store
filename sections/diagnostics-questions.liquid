    min-height: calc(96 * var(--fu));
  }
  .skin-quiz__nav button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* final */
  .skin-quiz__form {
    width: 100%;
    margin-top: calc(48 * var(--fu));
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--fu));
