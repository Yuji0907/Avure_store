    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-align: center;
    color: var(--avure-error);
  }
  .skin-quiz__why {
    text-align: center;
