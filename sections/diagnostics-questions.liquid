    position: relative;
    width: 80%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(40 * var(--fu));
    color: var(--text-color-primary);
    text-align: center;
  }
  .skin-quiz__analyse-text {
    font-family: var(--text-font-primary);
    font-size: calc(32 * var(--fu));
    font-weight: 700;
    text-transform: uppercase;
  }
  .skin-quiz__spinner {
    width: calc(72 * var(--fu));
    height: calc(72 * var(--fu));
    border: calc(6 * var(--fu)) solid rgb(255 255 255 / 0.35);
