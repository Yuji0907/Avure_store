  .skin-quiz__field {
    display: flex;
    align-items: stretch;
  }
  .skin-quiz__prefix {
    display: grid;
    place-items: center;
    padding-inline: calc(24 * var(--fu));
    border: 1px solid var(--color-dark);
    border-right: 0;
    font-size: var(--type-input);
  }
  .skin-quiz__consent {
    font-size: var(--type-caption);
    color: var(--text-color-muted);
    text-align: center;
  }
  .skin-quiz__form .skin-quiz__nav {
    margin-top: auto;
  }

  /* analyse */
  .skin-quiz__view--analyse {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
