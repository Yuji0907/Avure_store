{%- comment -%}
  Skin diagnostic: questions -> email + phone -> analyse screen -> results.

  Data and logic come from the client's quiz (English versions in assets/):
    avure-catalog.js    window.AVURE_CATALOG   13 products, actives, usage, compatibility rules
    avure-questions.js  window.AvureQuestions  EXPRESS = the 14 screens used here
    avure-engine.js     window.AvureEngine     analyze(answers, catalog) -> profile, routine, products
  This section only renders those questions with the existing screens and shows the engine's result.
  Answers and the current view are kept in sessionStorage, so a refresh resumes where the visitor was.

  Product pickers (one per catalog id) link the engine's products to Shopify products: their variant id
  and price override the catalog values at runtime. A product without a picker cannot be added to cart.
{%- endcomment -%}

{%- assign catalog_ids = 'gel_cleanser,oil_cleanser,salicylic_2,glycolic_7,niacinamide_10,retinol_02,vitc_15,azelaic_15,ha_2,eye_contour,day_cream,spf_gelcream,spf_stick' | split: ',' -%}

<script src="{{ 'avure-catalog.js' | asset_url }}" defer></script>
<script src="{{ 'avure-questions.js' | asset_url }}" defer></script>
<script src="{{ 'avure-engine.js' | asset_url }}" defer></script>
<script src="{{ 'avure-profile-texts.js' | asset_url }}" defer></script>

{%- assign script_font = section.settings.script_font | default: 'Great Vibes' | strip -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family={{ script_font | escape | replace: ' ', '+' }}&display=swap"
>

<section
  class="skin-quiz"
  id="SkinQuiz-{{ section.id }}"
  data-skin-quiz
  data-view="quiz"
  data-storage-key="avure-skin-diagnostic-v2-{{ section.id }}"
>
  {%- comment -%} ---------- Questions (rendered from AvureQuestions.EXPRESS) ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--quiz" data-view-panel="quiz">
    <div
      class="skin-quiz__progress"
      role="progressbar"
      aria-label="Diagnostic progress"
      aria-valuemin="1"
      aria-valuemax="15"
      aria-valuenow="1"
      data-progress
    >
      <span data-progress-fill></span>
    </div>

    <p class="skin-quiz__eyebrow">{{ section.settings.label | escape }}</p>

    <fieldset class="skin-quiz__step" data-step>
      <legend class="skin-quiz__question" data-question></legend>
      <p class="skin-quiz__subtitle" data-subtitle hidden></p>
      <div class="skin-quiz__chips" data-chips></div>
    </fieldset>

    <div class="skin-quiz__footer">
      <p class="skin-quiz__error" data-error role="alert" hidden>{{ section.settings.error_text | escape }}</p>
      <div class="skin-quiz__why">
        <p class="skin-quiz__why-title">{{ section.settings.why_heading | escape }}</p>
        <p class="skin-quiz__why-text" data-why-text></p>
      </div>
      <div class="skin-quiz__nav">
        <button type="button" class="avure-outline-button" data-previous>Previous</button>
        <button type="button" class="avure-button" data-next>Next</button>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Final step: email + phone ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--final" data-view-panel="final" hidden>
    <div class="skin-quiz__progress skin-quiz__progress--full" aria-hidden="true"><span></span></div>
    <p class="skin-quiz__eyebrow">{{ section.settings.label | escape }}</p>
    <h2 class="skin-quiz__question">{{ section.settings.final_heading | escape }}</h2>

    {%- comment -%}
      Privacy: only the email, the phone (in the note) and the tags "diagnostic, skin-<type>" are sent.
      Never add quiz, pregnancy or medical answers to this form.
    {%- endcomment -%}
    {%- form 'customer', class: 'skin-quiz__form' -%}
      <input type="hidden" name="contact[tags]" value="diagnostic" data-tags>
      <input type="hidden" name="contact[note]" value="" data-note>

      <label class="skin-quiz__field">
        <span class="visually-hidden">Email</span>
        <input
          class="avure-input"
          type="email"
          name="contact[email]"
          placeholder="Email *"
          autocomplete="email"
          required
          data-email
        >
      </label>
      <label class="skin-quiz__field skin-quiz__field--phone">
        <span class="skin-quiz__prefix" aria-hidden="true">+213</span>
        <input
          class="avure-input"
          type="tel"
          inputmode="tel"
          placeholder="Phone number *"
          autocomplete="tel-national"
          aria-label="Phone number"
          required
          data-phone
        >
      </label>
      <p class="skin-quiz__error" data-final-error role="alert" hidden></p>
      <p class="skin-quiz__consent">{{ section.settings.consent_text }}</p>

      <div class="skin-quiz__nav">
        <button type="button" class="avure-outline-button" data-final-previous>Previous</button>
        <button type="submit" class="avure-button">OK</button>
      </div>
    {%- endform -%}
  </div>

  {%- comment -%} ---------- Analyse ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--analyse" data-view-panel="analyse" hidden>
    {%- if section.settings.analyse_image != blank -%}
      {{
        section.settings.analyse_image
        | image_url: width: 1200
        | image_tag: class: 'skin-quiz__analyse-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__analyse-image" src="{{ 'Skin diagnostic - hero.png' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
    {%- endif -%}
    <div class="skin-quiz__analyse-content">
      <span class="skin-quiz__spinner" aria-hidden="true"></span>
      <p class="skin-quiz__analyse-text" role="status">{{ section.settings.analyse_text | escape }}</p>
    </div>
  </div>

  {%- comment -%} ---------- Results (Figma "Diagnostic Results") ---------- {%- endcomment -%}
  <div class="skin-quiz__view skin-quiz__view--results" data-view-panel="results" hidden>
    {%- comment -%} a. Hero {%- endcomment -%}
    {%- if section.settings.results_image != blank -%}
      {{
        section.settings.results_image
        | image_url: width: 1200
        | image_tag: class: 'skin-quiz__results-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__results-image" src="{{ 'Skin diagnostic - hero.png' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">
    {%- endif -%}

    <div class="skin-quiz__results">
      {%- comment -%} b. Title + intro {%- endcomment -%}
      <h2 class="skin-quiz__profile-title">{{ section.settings.results_title | escape }}</h2>
      <p class="skin-quiz__intro">
        <span data-intro></span>
        <a class="skin-quiz__read-more" href="#SkinQuizProfile-{{ section.id }}" data-read-more>[Read more]</a>
      </p>

      {%- comment -%} c. Summary table {%- endcomment -%}
      <table class="skin-quiz__summary">
        <tbody>
          <tr>
            <th scope="row">Your skin type</th>
            <td><ul data-summary-type></ul></td>
          </tr>
          <tr>
            <th scope="row">Your priorities</th>
            <td><ul data-summary-priorities></ul></td>
          </tr>
        </tbody>
      </table>

      {%- comment -%} d. Routine heading {%- endcomment -%}
      <div class="skin-quiz__routine-head">
        <p class="skin-quiz__eyebrow">{{ section.settings.routine_eyebrow | escape }}</p>
        <h2 class="skin-quiz__section-title">{{ section.settings.routine_title | escape }}</h2>
        <p class="skin-quiz__section-subtitle">{{ section.settings.routine_subtitle | escape }}</p>
      </div>

      {%- comment -%} e. Product cards {%- endcomment -%}
      <ul class="skin-quiz__cards" data-cards></ul>

      {%- comment -%} f. Routine box {%- endcomment -%}
      <div class="skin-quiz__box">
        <p class="skin-quiz__box-eyebrow">Your routine</p>
        <p class="skin-quiz__box-title">Avure<sup data-count></sup></p>
        <p class="skin-quiz__box-text">{{ section.settings.routine_box_text | escape }}</p>
        {%- if section.settings.shipping_text != blank -%}
          <p class="skin-quiz__box-shipping">{{ section.settings.shipping_text | escape }}</p>
        {%- endif -%}
        <p class="skin-quiz__routine-note" data-routine-note hidden></p>
        <p class="skin-quiz__error" data-cart-error role="alert" hidden></p>
        <button type="button" class="avure-button" data-add-routine></button>
      </div>
    </div>

    {%- comment -%} g. Full-width image {%- endcomment -%}
    {%- if section.settings.routine_image != blank -%}
      {{
        section.settings.routine_image
        | image_url: width: 1600
        | image_tag: class: 'skin-quiz__wide-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__wide-image" src="{{ 'kit.png' | asset_url }}" alt="" width="1600" height="1000" loading="lazy">
    {%- endif -%}

    <div class="skin-quiz__results">
      {%- comment -%} h. Accordions {%- endcomment -%}
      <details class="skin-quiz__panel" open>
        <summary>How to use <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body skin-quiz__how">
          <div>
            <h4>[Morning]</h4>
            <ol class="skin-quiz__steps" data-morning></ol>
          </div>
          <div>
            <h4>[Evening]</h4>
            <ol class="skin-quiz__steps" data-evening></ol>
          </div>
        </div>
      </details>

      <details class="skin-quiz__panel">
        <summary>Ingredients for your skin <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <ul class="skin-quiz__ingredients" data-ingredients></ul>
        </div>
      </details>

      <details class="skin-quiz__panel">
        <summary>How to start <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body skin-quiz__start">
          <ol class="skin-quiz__phases" data-phases></ol>
          <div data-schedule-wrap>
            <h4>Your evenings</h4>
            <ul class="skin-quiz__schedule" data-schedule></ul>
          </div>
          <div class="skin-quiz__sensitive" data-medical-wrap hidden>
            <h4>Good to know</h4>
            <ul data-medical></ul>
          </div>
          <ul class="skin-quiz__notes" data-notes></ul>
          <p class="skin-quiz__disclaimer" data-disclaimer></p>
        </div>
      </details>
    </div>

    {%- comment -%} i. Full-width image {%- endcomment -%}
    {%- if section.settings.profile_image != blank -%}
      {{
        section.settings.profile_image
        | image_url: width: 1600
        | image_tag: class: 'skin-quiz__wide-image', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      <img class="skin-quiz__wide-image" src="{{ 'about-image.png' | asset_url }}" alt="" width="1600" height="1000" loading="lazy">
    {%- endif -%}

    {%- comment -%} j. Detailed skin profile (texts: assets/avure-profile-texts.js) {%- endcomment -%}
    <div class="skin-quiz__results skin-quiz__profile" id="SkinQuizProfile-{{ section.id }}">
      <p class="skin-quiz__eyebrow">{{ section.settings.results_eyebrow | escape }}</p>

      <details class="skin-quiz__panel" open>
        <summary>Your skin type <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <ul class="skin-quiz__profile-list" data-profile-type></ul>
        </div>
      </details>

      <details class="skin-quiz__panel">
        <summary>Your priorities <span class="skin-quiz__panel-icon" aria-hidden="true"></span></summary>
        <div class="skin-quiz__panel-body">
          <ul class="skin-quiz__profile-list" data-profile-priorities></ul>
        </div>
      </details>

      <button type="button" class="skin-quiz__restart" data-restart>Retake the diagnostic</button>
    </div>
  </div>

  {%- comment -%} Shopify products picked for each catalog id: {catalogId: {variantId, title, image, url, price, available}} {%- endcomment -%}
  <script type="application/json" data-quiz-products>
    {
      {%- assign first_product = true -%}
      {%- for catalog_id in catalog_ids -%}
        {%- assign mapped = section.settings[catalog_id] -%}
        {%- if mapped != blank -%}
          {%- assign mapped_variant = mapped.selected_or_first_available_variant -%}
          {%- unless first_product -%},{%- endunless -%}
          {%- assign first_product = false -%}
          {{ catalog_id | json }}: {
            "variantId": {{ mapped_variant.id | json }},
            "title": {{ mapped.title | json }},
            "image": {{ mapped.featured_image | image_url: width: 240 | json }},
            "url": {{ mapped.url | json }},
            "price": {{ mapped_variant.price | json }},
            "available": {{ mapped_variant.available | json }}
          }
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
</section>

<script>
  (() => {
    const root = document.getElementById('SkinQuiz-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const boot = () => {
      if (!window.AvureQuestions || !window.AvureEngine || !window.AVURE_CATALOG) return false;
      start();
      return true;
    };
    if (!boot()) {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
      window.addEventListener('load', () => root.dataset.started || boot(), { once: true });
    }

    function start() {
      if (root.dataset.started) return;
      root.dataset.started = 'true';

      const Q = window.AvureQuestions;
      const Engine = window.AvureEngine;
      const STORAGE = root.dataset.storageKey;
      const PHONE_RE = /^(\+213|0)[567]\d{8}$/;
      const ANALYSE_MS = 2500;
      const SEVERITY = [[1, 'Mild'], [2, 'Moderate'], [3, 'Marked']];
      const ACNE_TYPE = Q.QUESTIONS.find((q) => q.id === 'acne_type');
      const ERROR_TEXT = root.querySelector('[data-error]').textContent;

      /* Short "why this question" text for each express screen */
      const WHY = {
        age: 'Skin needs change with age, and some actives are only suggested from 25.',
        x_profile: 'Some actives are not recommended during pregnancy or breastfeeding, so we leave them out.',
        medical: 'If a dermatologist is treating your skin, we keep the routine gentle and compatible with their care.',
        after_cleanse: 'How your bare skin feels after washing is the clearest sign of your skin type.',
        midday_shine: 'Where shine shows up tells normal, combination and oily skin apart.',
        tight_day: 'Tightness through the day is the main sign of dehydration.',
        x_reactivity: 'Reactive skin gets gentler products and a slower start.',
        redness_freq: 'Frequent redness changes which actives are suitable for you.',
        current_irritation: 'Irritated skin needs soothing before any active is added.',
        x_actives: 'Your experience with actives decides how quickly we introduce them.',
        concerns: 'Your concerns decide which treatments go into your routine.',
        x_intensity: 'How marked each concern is sets the strength and pace of your routine.',
        sun_exposure: 'Time in the sun decides how much protection you need.',
        current_products: 'Knowing what you already use avoids doubling up and over-exfoliating.',
      };

      /* Catalog with Shopify variant ids and prices from the theme editor (prices in DA) */
      const shopifyProducts = JSON.parse(root.querySelector('[data-quiz-products]').textContent || '{}');
      const catalog = JSON.parse(JSON.stringify(window.AVURE_CATALOG));
      catalog.products.forEach((p) => {
        const m = shopifyProducts[p.id];
        if (!m) return;
        p.variants[0] = { ...p.variants[0], variantId: m.variantId, price: Math.round(m.price / 100) };
      });

      const $ = (sel) => root.querySelector(sel);
      const fill = $('[data-progress-fill]');
      const progress = $('[data-progress]');
      const error = $('[data-error]');
      const prevBtn = $('[data-previous]');
      const nextBtn = $('[data-next]');

      /* ---------- state ---------- */
      const load = () => {
        try {
          return JSON.parse(sessionStorage.getItem(STORAGE)) || {};
        } catch (e) {
          return {};
        }
      };
      let state = Object.assign({ view: 'quiz', step: 0, answers: {} }, load());
      const save = () => {
        try {
          sessionStorage.setItem(STORAGE, JSON.stringify(state));
        } catch (e) {}
      };
      const A = () => state.answers;

      /* Sections after the quiz (science, footer) only show with the results.
         CSS (:has) handles it; this is a fallback for browsers without :has. */
      const followingSections = () => {
        const list = [];
        let sib = root.closest('.shopify-section')?.nextElementSibling;
        while (sib) {
          if (sib.classList.contains('shopify-section')) list.push(sib);
          sib = sib.nextElementSibling;
        }
        return list;
      };
      const showView = (view) => {
        state.view = view;
        root.dataset.view = view;
        root.querySelectorAll('[data-view-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.viewPanel !== view;
        });
        if (!CSS.supports('selector(:has(*))')) {
          followingSections().forEach((s) => (s.style.display = view === 'results' ? '' : 'none'));
        }
        save();
        window.scrollTo({ top: 0 });
      };

      /* ---------- question flow ---------- */
      const EXPRESS = Q.EXPRESS;
      const visible = (q) => !q.showIf || q.showIf(A());
      const visibleSteps = () => EXPRESS.filter(visible);
      const nextIndex = (from, dir) => {
        let i = from + dir;
        while (i >= 0 && i < EXPRESS.length && !visible(EXPRESS[i])) i += dir;
        return i;
      };

      const el = (tag, cls, text) => {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text != null) node.textContent = text;
        return node;
      };
      const chip = (label, pressed, data) => {
        const b = el('button', 'skin-quiz__chip', label);
        b.type = 'button';
        b.setAttribute('aria-pressed', String(!!pressed));
        Object.assign(b.dataset, data);
        return b;
      };

      const isAnswered = (q) => {
        const a = A();
        switch (q.type) {
          case 'single':
            return Object.prototype.hasOwnProperty.call(a, q.id) && a[q.id] !== undefined;
          case 'multi':
          case 'concerns':
            return Array.isArray(a[q.id]) && a[q.id].length > 0;
          case 'intensity_all': {
            const cs = a.concerns || [];
            const ok = cs.every((c) => ((a.concernDetails || {})[c] || {}).severity);
            return ok && (!cs.includes('acne') || !!a.acne_type);
          }
          default:
            return true;
        }
      };

      const renderStep = () => {
        const q = EXPRESS[state.step];
        const a = A();
        $('[data-question]').textContent = q.label;
        const sub = $('[data-subtitle]');
        sub.hidden = !q.hint;
        sub.textContent = q.hint ? `(${q.hint})` : '';
        $('[data-why-text]').textContent = WHY[q.id] || q.hint || '';

        const chips = $('[data-chips]');
        chips.replaceChildren();
        chips.classList.toggle('skin-quiz__chips--rows', q.type === 'intensity_all');

        if (q.type === 'single') {
          q.options.forEach(([value, label]) => chips.append(chip(label, a[q.id] === value, { kind: 'single', value })));
        } else if (q.type === 'multi' || q.type === 'concerns') {
          const chosen = a[q.id] || [];
          q.options.forEach(([value, label]) => chips.append(chip(label, chosen.includes(value), { kind: q.type, value })));
        } else if (q.type === 'intensity_all') {
          const conLabel = (cid) => (Q.CONCERNS.find((c) => c.id === cid) || {}).label || cid;
          (a.concerns || []).forEach((cid) => {
            const row = el('div', 'skin-quiz__intensity');
            row.append(el('p', 'skin-quiz__intensity-label', conLabel(cid)));
            const group = el('div', 'skin-quiz__intensity-chips');
            const sev = ((a.concernDetails || {})[cid] || {}).severity;
            SEVERITY.forEach(([v, label]) => group.append(chip(label, sev === v, { kind: 'severity', concern: cid, value: v })));
            row.append(group);
            chips.append(row);
          });
          if ((a.concerns || []).includes('acne') && ACNE_TYPE) {
            const row = el('div', 'skin-quiz__intensity');
            row.append(el('p', 'skin-quiz__intensity-label', ACNE_TYPE.label));
            const group = el('div', 'skin-quiz__intensity-chips');
            ACNE_TYPE.options.forEach(([v, label]) => group.append(chip(label, a.acne_type === v, { kind: 'acne_type', value: v })));
            row.append(group);
            chips.append(row);
          }
        }

        const steps = visibleSteps();
        const pos = steps.indexOf(q);
        const total = steps.length + 1; // + email step
        fill.style.width = `${((pos + 1) / total) * 100}%`;
        progress.setAttribute('aria-valuenow', String(pos + 1));
        progress.setAttribute('aria-valuemax', String(total));
        prevBtn.disabled = nextIndex(state.step, -1) < 0;
        error.hidden = true;
        error.textContent = ERROR_TEXT;
      };

      /* Answer handling, as in the client's UI */
      root.querySelector('[data-chips]').addEventListener('click', (e) => {
        const b = e.target.closest('.skin-quiz__chip');
        if (!b) return;
        const q = EXPRESS[state.step];
        const a = A();
        const kind = b.dataset.kind;
        const value = b.dataset.value;

        if (kind === 'single') {
          a[q.id] = value;
          const opt = q.options.find((o) => o[0] === value);
          if (opt && opt[2]) Object.assign(a, opt[2]);
        } else if (kind === 'multi') {
          let list = (a[q.id] || []).slice();
          if (list.includes(value)) list = list.filter((v) => v !== value);
          else if (q.exclusive && value === q.exclusive) list = [value];
          else list = list.filter((v) => v !== q.exclusive).concat(value);
          a[q.id] = list;
        } else if (kind === 'concerns') {
          let list = (a.concerns || []).slice();
          if (list.includes(value)) list = list.filter((v) => v !== value);
          else if (list.length < (q.max || 3)) list.push(value);
          else return;
          a.concerns = list;
          if (list.length) a.priority = list[0];
          else delete a.priority;
          if (!list.includes('acne')) delete a.acne_type;
          if (a.concernDetails) {
            Object.keys(a.concernDetails).forEach((cid) => {
              if (!list.includes(cid)) delete a.concernDetails[cid];
            });
          }
        } else if (kind === 'severity') {
          a.concernDetails = a.concernDetails || {};
          a.concernDetails[b.dataset.concern] = { ...(a.concernDetails[b.dataset.concern] || {}), severity: Number(value) };
        } else if (kind === 'acne_type') {
          a.acne_type = value;
        }
        save();
        renderStep();
      });

      prevBtn.addEventListener('click', () => {
        const i = nextIndex(state.step, -1);
        if (i >= 0) {
          state.step = i;
          save();
          renderStep();
        }
      });

      nextBtn.addEventListener('click', () => {
        const q = EXPRESS[state.step];
        if (!isAnswered(q)) {
          error.hidden = false;
          return;
        }
        const i = nextIndex(state.step, 1);
        if (i < EXPRESS.length) {
          state.step = i;
          save();
          renderStep();
        } else {
          showView('final');
        }
      });

      /* ---------- engine ---------- */
      const analyze = () =>
        Engine.analyze({ ...A(), _asked: [...Q.EXPRESS_FIELDS, 'detail.severity'] }, catalog);

      /* ---------- final step (only email, phone and tags are sent) ---------- */
      const finalForm = root.querySelector('.skin-quiz__form');
      finalForm.noValidate = true;
      const finalError = $('[data-final-error]');
      const normalizePhone = (raw) => {
        let v = raw.replace(/[\s.-]/g, '');
        if (/^[567]\d{8}$/.test(v)) v = '0' + v;
        if (/^213/.test(v)) v = '+' + v;
        return v;
      };

      $('[data-final-previous]').addEventListener('click', () => {
        state.step = nextIndex(EXPRESS.length, -1);
        showView('quiz');
        renderStep();
      });

      finalForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = finalForm.querySelector('[data-email]');
        const phone = normalizePhone(finalForm.querySelector('[data-phone]').value);
        const problems = [];
        if (!email.value.trim() || !email.checkValidity()) problems.push('Please enter a valid email.');
        if (!PHONE_RE.test(phone)) problems.push('Please enter a valid phone number.');
        if (problems.length) {
          finalError.textContent = problems.join(' ');
          finalError.hidden = false;
          return;
        }
        finalError.hidden = true;

        const type = analyze().profile.type;
        finalForm.querySelector('[data-tags]').value = `diagnostic, skin-${type}`;
        finalForm.querySelector('[data-note]').value = `Phone: ${phone}`;

        // Fire and forget: the results never wait on the signup.
        fetch(finalForm.action, { method: 'POST', body: new FormData(finalForm), credentials: 'same-origin' }).catch(
          () => {}
        );

        showView('analyse');
        setTimeout(() => {
          renderResults();
          showView('results');
        }, ANALYSE_MS);
      });

      /* ---------- results ---------- */
      const money = (da) => Number(da).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' DA';
      const P = Object.fromEntries(catalog.products.map((p) => [p.id, p]));
      const TEXTS = window.AVURE_PROFILE_TEXTS || { types: {}, conditions: {}, concerns: {} };
      const rootUrl = () => (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      const canBuy = (id) => {
        const m = shopifyProducts[id];
        return !!(m && m.available && m.variantId);
      };
      const typeLabel = (profile) =>
        ((TEXTS.types[profile.type] || {}).label || `${profile.type} skin`) +
        (profile.typeConfidence === 'low' ? ' (to be confirmed)' : '');
      /* "sensitive" is implied by "very_sensitive": show only the stronger one */
      const conditionsOf = (profile) =>
        profile.conditions.filter((c) => c !== 'sensitive' || !profile.conditions.includes('very_sensitive'));
      const concernLabel = (id, fallback) => (TEXTS.concerns[id] || {}).label || fallback || id;

      const addToCart = async (variantIds) => {
        const res = await fetch(`${rootUrl()}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: variantIds.map((id) => ({ id, quantity: 1 })) }),
        });
        if (!res.ok) throw new Error((await res.json()).description || 'Could not add to cart');
        const cart = await (await fetch(`${rootUrl()}cart.js`)).json();
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        return cart;
      };

      const renderResults = () => {
        const r = analyze();
        const cards = Object.fromEntries(r.products.map((p) => [p.id, p]));
        const nameOf = (id) => (P[id] ? P[id].name : id);

        // b. Intro
        $('[data-intro]').textContent = r.explanation + ' ';

        // c. Summary table
        $('[data-summary-type]').replaceChildren(
          el('li', null, typeLabel(r.profile)),
          ...conditionsOf(r.profile).map((c) => el('li', null, (TEXTS.conditions[c] || {}).label || c))
        );
        $('[data-summary-priorities]').replaceChildren(...r.priorities.map((p) => el('li', null, concernLabel(p.id, p.label))));

        // e. Product cards, in routine order
        const priorityIds = r.priorities.map((p) => p.id);
        $('[data-cards]').replaceChildren(
          ...r.products.map((item) => {
            const product = P[item.id];
            const m = shopifyProducts[item.id];
            const li = el('li', 'skin-quiz__card');

            const media = el(m ? 'a' : 'span', 'skin-quiz__card-media');
            if (m) media.href = m.url;
            if (m && m.image) {
              const img = el('img');
              img.src = m.image;
              img.alt = item.name;
              img.loading = 'lazy';
              media.append(img);
            }
            li.append(media);

            const body = el('div', 'skin-quiz__card-body');
            const title = el(m ? 'a' : 'span', 'skin-quiz__card-title', item.name);
            if (m) title.href = m.url;
            body.append(title);
            const actives = (product.keyActives || []).slice(0, 2).map((k) => k.name.replace(/\s*\(.*\)$/, ''));
            if (actives.length) body.append(el('p', 'skin-quiz__card-sub', actives.join(' / ')));

            const targets = [...product.targets.primary, ...product.targets.secondary];
            const topConcern = priorityIds.find((id) => targets.includes(id)) || targets[0];
            const typeTag =
              product.skinTypes.length >= 4
                ? 'All skin types'
                : product.skinTypes.includes(r.profile.type)
                  ? (TEXTS.types[r.profile.type] || {}).label || r.profile.type
                  : 'Selected skin types';
            const tags = el('div', 'skin-quiz__card-tags');
            const CATEGORY = { cleanser: 'Cleanser', exfoliant: 'Exfoliant', serum: 'Serum', eye: 'Eye care', moisturizer: 'Moisturizer', spf: 'Sun protection', spf_reapply: 'Sun protection' };
            tags.append(el('span', 'skin-quiz__pill', topConcern ? concernLabel(topConcern, topConcern) : CATEGORY[product.category] || 'Daily care'));
            tags.append(el('span', 'skin-quiz__pill', typeTag));
            body.append(tags);

            body.append(el('p', 'skin-quiz__card-text', item.mainBenefit || item.why || ''));

            const foot = el('div', 'skin-quiz__card-foot');
            foot.append(el('span', 'skin-quiz__card-price', canBuy(item.id) ? money(item.price) : m ? 'Out of stock' : 'Coming soon'));
            if (canBuy(item.id)) {
              const add = el('button', 'skin-quiz__card-add', 'Add');
              add.type = 'button';
              add.dataset.addOne = m.variantId;
              foot.append(add);
            }
            body.append(foot);
            li.append(body);
            return li;
          })
        );

        // f. Routine box
        const buyable = r.products.filter((p) => canBuy(p.id));
        const buyTotal = buyable.reduce((s, p) => s + p.price, 0);
        $('[data-count]').textContent = `[${String(r.products.length).padStart(3, '0')}]`;
        const addBtn = $('[data-add-routine]');
        addBtn.textContent = `Add to cart - ${money(buyTotal)}`;
        addBtn.disabled = buyable.length === 0;
        addBtn.dataset.variants = JSON.stringify(buyable.map((p) => shopifyProducts[p.id].variantId));
        const missing = r.products.length - buyable.length;
        const note = $('[data-routine-note]');
        note.hidden = missing === 0;
        note.textContent =
          missing === 0 ? '' : `${missing} product${missing > 1 ? 's' : ''} can't be bought online right now and ${missing > 1 ? 'are' : 'is'} not included in this total.`;

        // h. How to use: "<step role>, <product name>. Why: <reason>"
        const stepItem = (s) => {
          const extra = [s.nightsOnly ? 'some evenings' : '', s.optional ? 'optional' : ''].filter(Boolean);
          const li = el('li');
          const line = el('p', 'skin-quiz__step-head');
          line.append(el('strong', null, `${s.role}${extra.length ? ` (${extra.join(', ')})` : ''}, ${s.name}.`));
          const why = (cards[s.id] || {}).why;
          if (why) line.append(el('span', 'skin-quiz__step-text', ` Why: ${why}`));
          li.append(line);
          return li;
        };
        $('[data-morning]').replaceChildren(...r.routine.AM.map(stepItem));
        $('[data-evening]').replaceChildren(...r.routine.PM.map(stepItem));

        // Ingredients: key actives of the routine products
        const actives = new Map();
        r.products.forEach((item) => {
          (P[item.id].keyActives || []).forEach((k) => {
            const pct = typeof k.pct === 'number' ? `${k.pct}%` : '';
            const key = `${k.name}|${pct}`;
            if (!actives.has(key)) actives.set(key, { name: k.name, pct, products: [] });
            actives.get(key).products.push(item.name);
          });
        });
        $('[data-ingredients]').replaceChildren(
          ...[...actives.values()].map((x) => {
            const li = el('li');
            li.append(el('strong', null, x.pct ? `${x.name} ${x.pct}` : x.name));
            li.append(el('span', 'skin-quiz__step-text', ` in ${x.products.join(', ')}`));
            return li;
          })
        );

        // How to start
        $('[data-phases]').replaceChildren(
          ...r.routine.progression.map((ph) => {
            const li = el('li');
            li.append(el('strong', null, ph.weeks));
            li.append(el('p', 'skin-quiz__step-text', ph.focus));
            return li;
          })
        );
        $('[data-schedule-wrap]').hidden = !r.routine.schedule.some((n) => n.items.length);
        $('[data-schedule]').replaceChildren(
          ...r.routine.schedule.map((n) => {
            const li = el('li');
            li.append(el('span', 'skin-quiz__day', n.day));
            li.append(el('span', null, n.items.length ? n.items.map(nameOf).join(' + ') : 'Rest evening: basics only'));
            return li;
          })
        );
        $('[data-medical-wrap]').hidden = r.medicalNotes.length === 0;
        $('[data-medical]').replaceChildren(...r.medicalNotes.map((t) => el('li', null, t)));
        $('[data-notes]').replaceChildren(...r.notes.map((t) => el('li', null, t)));
        $('[data-disclaimer]').textContent = r.disclaimer;

        // j. Detailed profile (draft texts in assets/avure-profile-texts.js)
        const profileItem = (label, entry) => {
          const li = el('li');
          li.append(el('p', 'skin-quiz__profile-label', label));
          if (entry && entry.what) li.append(el('p', null, entry.what));
          if (entry && entry.helps) li.append(el('p', null, `What helps: ${entry.helps}`));
          if (entry && entry.easy) li.append(el('p', null, `Go easy on: ${entry.easy}`));
          if (entry && entry.text) li.append(el('p', null, entry.text));
          return li;
        };
        $('[data-profile-type]').replaceChildren(
          profileItem(typeLabel(r.profile), TEXTS.types[r.profile.type]),
          ...conditionsOf(r.profile).map((c) => profileItem((TEXTS.conditions[c] || {}).label || c, TEXTS.conditions[c]))
        );
        $('[data-profile-priorities]').replaceChildren(
          ...r.priorities.map((p) => profileItem(concernLabel(p.id, p.label), TEXTS.concerns[p.id]))
        );
      };

      // [Read more] -> detailed profile
      $('[data-read-more]').addEventListener('click', (e) => {
        e.preventDefault();
        const target = root.querySelector(e.currentTarget.getAttribute('href'));
        if (!target) return;
        target.querySelectorAll('details').forEach((d, i) => i === 0 && (d.open = true));
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // e. Add a single product
      $('[data-cards]').addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-add-one]');
        if (!btn || btn.classList.contains('is-added')) return;
        btn.disabled = true;
        const cartError = $('[data-cart-error]');
        cartError.hidden = true;
        try {
          await addToCart([Number(btn.dataset.addOne)]);
          btn.classList.add('is-added');
          btn.textContent = 'Added ✓';
        } catch (err) {
          cartError.textContent = err.message;
          cartError.hidden = false;
        } finally {
          btn.disabled = false;
        }
      });

      // f. Add the whole routine
      $('[data-add-routine]').addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const cartError = $('[data-cart-error]');
        const ids = JSON.parse(btn.dataset.variants || '[]');
        if (!ids.length) return;
        btn.disabled = true;
        cartError.hidden = true;
        try {
          await addToCart(ids);
          root.querySelectorAll('[data-add-one]').forEach((b) => {
            b.classList.add('is-added');
            b.textContent = 'Added ✓';
          });
          if (window.openCartDrawer) window.openCartDrawer();
        } catch (err) {
          cartError.textContent = err.message;
          cartError.hidden = false;
        } finally {
          btn.disabled = false;
        }
      });

      $('[data-restart]').addEventListener('click', () => {
        state = { view: 'quiz', step: 0, answers: {} };
        save();
        renderStep();
        showView('quiz');
      });

      /* ---------- resume ---------- */
      if (!(state.step >= 0 && state.step < EXPRESS.length) || !visible(EXPRESS[state.step])) state.step = 0;
      renderStep();
      if (state.view === 'results' || state.view === 'analyse') {
        renderResults();
        showView('results');
      } else {
        showView(state.view === 'final' ? 'final' : 'quiz');
      }
    }
  })();
</script>

{% style %}
  #SkinQuiz-{{ section.id }} .skin-quiz__profile-title {
    font-family: '{{ script_font | escape }}', cursive;
  }
  #SkinQuiz-{{ section.id }} {
    --skin-quiz-plus: url("{{ 'plus-small.svg' | asset_url }}");
    --skin-quiz-minus: url("{{ 'minus-small.svg' | asset_url }}");
  }
{% endstyle %}

{%- stylesheet -%}
  .shopify-section:has([data-skin-quiz]:not([data-view='results'])) ~ .shopify-section {
    display: none;
  }
  .skin-quiz {
    width: 100%;
    font-family: var(--text-font-secondary);
    color: var(--text-color-secondary);
  }
  .skin-quiz [hidden] {
    display: none !important;
  }
  .skin-quiz .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* quiz + final layout */
