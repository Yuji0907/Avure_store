    animation: skin-quiz-spin 0.8s linear infinite;
  }
  @keyframes skin-quiz-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* results */
  .skin-quiz__results-image {
    width: 100%;
    max-height: calc(840 * var(--fu));
    object-fit: cover;
    object-position: top;
  }
  .skin-quiz__results {
