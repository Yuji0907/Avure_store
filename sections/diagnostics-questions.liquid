    text-transform: uppercase;
    text-decoration: underline;
    cursor: pointer;
  }

  /* ---------- additions for the client quiz (new screen types / result blocks) ---------- */
  .skin-quiz__chips--rows {
    width: 100%;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: calc(40 * var(--fu));
  }
  .skin-quiz__intensity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(16 * var(--fu));
  }
  .skin-quiz__intensity-label {
    font-family: var(--text-font-primary);
    font-size: var(--type-body-sm);
    font-weight: 700;
    text-align: center;
  }
  .skin-quiz__intensity-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(16 * var(--fu));
  }
  .skin-quiz__routine-note {
    font-size: var(--type-caption);
    color: var(--text-color-muted);
  }
  .skin-quiz__steps,
  .skin-quiz__phases {
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--fu));
  }
  .skin-quiz__step-head {
    font-size: var(--type-body-sm);
  }
  .skin-quiz__step-tag {
    font-family: var(--text-font-accent);
    font-size: var(--type-caption);
    text-transform: uppercase;
    color: var(--text-color-muted);
  }
  .skin-quiz__step-text {
    margin-top: calc(4.8 * var(--fu));
    color: var(--text-color-muted);
  }
  .skin-quiz__ingredients {
    display: flex;
    flex-direction: column;
    gap: calc(16 * var(--fu));
  }
  .skin-quiz__start {
    display: flex;
    flex-direction: column;
    gap: calc(32 * var(--fu));
  }
  .skin-quiz__schedule {
    display: flex;
    flex-direction: column;
    gap: calc(9.6 * var(--fu));
  }
  .skin-quiz__schedule li {
    display: flex;
    gap: calc(24 * var(--fu));
  }
  .skin-quiz__day {
    flex: 0 0 calc(80 * var(--fu));
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    text-transform: uppercase;
  }
  .skin-quiz__notes {
    display: flex;
    flex-direction: column;
    gap: calc(12.8 * var(--fu));
    padding-left: calc(35.2 * var(--fu));
    list-style: disc;
    color: var(--text-color-muted);
  }
  .skin-quiz__disclaimer {
    font-size: var(--type-caption);
    color: var(--text-color-muted);
  }

  /* ---------- results (Figma "Diagnostic Results") ---------- */
  .skin-quiz__results + .skin-quiz__wide-image,
  .skin-quiz__wide-image + .skin-quiz__results {
    margin-top: 0;
  }
  .skin-quiz__profile-title {
    font-size: calc(88 * var(--fu));
    font-weight: 400;
    line-height: 1.1;
    text-align: center;
    color: var(--text-color-secondary);
  }
  .skin-quiz__intro {
    margin-top: calc(24 * var(--fu));
    font-size: var(--type-body-sm);
    line-height: var(--leading-normal);
    text-align: center;
    color: var(--text-color-muted);
  }
  .skin-quiz__read-more {
    color: var(--text-color-secondary);
    font-weight: 600;
    text-decoration: underline;
    white-space: nowrap;
  }
  .skin-quiz__summary {
    width: 100%;
    margin-top: calc(48 * var(--fu));
    border: 1px solid #000;
    border-collapse: collapse;
  }
  .skin-quiz__summary th,
  .skin-quiz__summary td {
    padding: calc(24 * var(--fu));
    border: 1px solid #000;
    vertical-align: top;
    text-align: left;
  }
  .skin-quiz__summary th {
    width: 40%;
    font-family: var(--text-font-accent);
    font-size: calc(32 * var(--fu));
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: #000;
  }
  .skin-quiz__summary ul {
    padding-left: calc(32 * var(--fu));
    list-style: disc;
    font-size: calc(26 * var(--fu));
  }
  .skin-quiz__routine-head {
    margin-top: calc(80 * var(--fu));
    text-align: center;
  }
  .skin-quiz__routine-head .skin-quiz__eyebrow {
    margin-top: 0;
  }
  .skin-quiz__section-title {
    margin-top: calc(12.8 * var(--fu));
    font-family: var(--text-font-primary);
    font-size: var(--type-title);
    font-weight: 700;
    text-transform: uppercase;
  }
  .skin-quiz__section-subtitle {
    margin-top: calc(12.8 * var(--fu));
    font-size: var(--type-body-sm);
    color: var(--text-color-muted);
  }
  .skin-quiz__cards {
    margin-top: calc(48 * var(--fu));
    display: flex;
    flex-direction: column;
  }
  .skin-quiz__card {
    display: grid;
    grid-template-columns: calc(192 * var(--fu)) minmax(0, 1fr);
    gap: calc(28.8 * var(--fu));
    padding-block: calc(32 * var(--fu));
    border-top: 1px solid var(--avure-black-200);
  }
  .skin-quiz__card:last-child {
    border-bottom: 1px solid var(--avure-black-200);
  }
  .skin-quiz__card-media {
    display: block;
    width: calc(192 * var(--fu));
    aspect-ratio: 4 / 5;
    border-radius: calc(12 * var(--fu));
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .skin-quiz__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .skin-quiz__card-body {
    display: flex;
    flex-direction: column;
    gap: calc(11.2 * var(--fu));
    min-width: 0;
  }
  .skin-quiz__card-title {
    font-family: var(--text-font-primary);
    font-size: calc(28 * var(--fu));
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-color-secondary);
  }
  .skin-quiz__card-sub {
    font-size: var(--type-caption);
    color: var(--text-color-muted);
  }
  .skin-quiz__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(11.2 * var(--fu));
  }
  .skin-quiz__pill {
    padding: calc(6.4 * var(--fu)) calc(17.6 * var(--fu));
    border-radius: calc(1998 * var(--fu));
    background: var(--avure-black-200);
    font-size: var(--type-caption);
    line-height: 1.3;
  }
  .skin-quiz__card-text {
    font-size: var(--type-body-sm);
    line-height: 1.4;
    color: var(--text-color-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .skin-quiz__card-foot {
    margin-top: calc(8 * var(--fu));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(16 * var(--fu));
  }
  .skin-quiz__card-price {
    font-size: calc(26 * var(--fu));
    font-weight: 600;
  }
  .skin-quiz__card-add {
    min-height: calc(64 * var(--fu));
    padding: 0 calc(35.2 * var(--fu));
    border: 0;
    border-radius: calc(1998 * var(--fu));
    background: var(--color-primary);
    color: var(--text-color-primary);
    font-family: var(--text-font-primary);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .skin-quiz__card-add.is-added {
    background: var(--avure-blue-100);
    color: var(--color-primary);
    cursor: default;
  }
  .skin-quiz__box {
    margin-top: calc(64 * var(--fu));
    padding: calc(48 * var(--fu));
    border: 1px solid #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(19.2 * var(--fu));
    text-align: center;
  }
  .skin-quiz__box-eyebrow,
  .skin-quiz__box-shipping {
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .skin-quiz__box-title {
    font-family: var(--text-font-primary);
    font-size: calc(80 * var(--fu));
    font-weight: 700;
    line-height: 1;
  }
  .skin-quiz__box-title sup {
    margin-left: calc(4.8 * var(--fu));
    font-family: var(--text-font-accent);
    font-size: calc(24 * var(--fu));
    font-weight: 500;
    vertical-align: super;
  }
  .skin-quiz__box-text {
    max-width: calc(560 * var(--fu));
    font-size: var(--type-body-sm);
    color: var(--text-color-muted);
  }
  .skin-quiz__box .avure-button {
    margin-top: calc(16 * var(--fu));
    min-height: calc(96 * var(--fu));
  }
  .skin-quiz__wide-image {
    display: block;
    width: 100%;
    max-height: calc(1040 * var(--fu));
    object-fit: cover;
  }
  .skin-quiz__profile {
    scroll-margin-top: calc(32 * var(--fu));
  }
  .skin-quiz__profile .skin-quiz__eyebrow {
    margin: 0 0 calc(32 * var(--fu));
  }
  .skin-quiz__profile-list {
    display: flex;
    flex-direction: column;
    gap: calc(32 * var(--fu));
    padding-left: calc(32 * var(--fu));
    list-style: disc;
  }
  .skin-quiz__profile-list p + p {
    margin-top: calc(9.6 * var(--fu));
  }
  .skin-quiz__profile-label {
    font-family: var(--text-font-primary);
    font-weight: 700;
    color: var(--text-color-secondary);
  }
{%- endstylesheet -%}

