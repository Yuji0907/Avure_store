<section class="section-skin-type">
  <div class="skin-type-container">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: controls: false, playsinline: false }}
    {% else %}
      <video autoplay muted loop playsinline class="skin-type__video">
        <source src="{{ 'skincare_type.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% endif %}
    <div class="skin-type-info__container">
      <div class="skin-type__header">
        <h4 class="lable">
          {{ section.settings.label | escape }}
          <span>©</span>
        </h4>
      </div>
      <div class="skin-type__main">
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.description | escape }}</p>
        <div class="skin-care-btton__wrrapper">
          <a href="pages/diagnostics-questions">
            <button data-style="light" class=" avure-outline-button   skin-type-btn " type="btn">
              {{ section.settings.cta | escape }}
            </button>
          </a>
        </div>
      </div>
      <div class="skin-type__footer">
        <h3>{{ section.settings.footer | escape }}</h3>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .skin-care-btton__wrrapper {
    width: 30%;
    margin-top: 0;
  }
  .section-skin-type {
    width: 100%;
    font-family: var(--text-font-primary);
    background-color: var(--bg-dark);
    color: var(--text-color-primary);
    display: grid;
    place-items: center;

    .skin-type-container {
      width: 100%;
      height: 100%;

      display: flex;
      align-items: center;
      div {
        width: 100%;
        max-height: 600px;
        display: flex;
        gap: 1rem;
      }
      video {
        width: 50%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
      }
      .skin-type-info__container {
        padding-block: 2.3rem;
        padding-inline: 0.8rem;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
        text-transform: uppercase;

        div {
          width: 100%;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          width: 90%;
        }
        .skin-type__header {
          margin-bottom: auto;
          h4 {
            font-family: var(--text-font-accent);
            color: var(--text-color-primary);
            display: flex;
            span {
              font-size: 0.5rem;
            }
          }
        }
        .skin-type__main {
          margin-block: auto;
          > h1 {
            font-family: var(--text-font-primary);
            color: var(--text-color-primary);
            font-weight: 600;
          }
          p {
            font-family: var(--text-font-primary);
            color: var(--text-color-primary);
            text-transform: none;
          }
        }
        .skin-type__footer {
          font-family: var(--text-font-primary);
          color: var(--text-color-primary);
        }
      }
    }
  }
{% endstylesheet %}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Label (flex element, so no alignment setting) */
  #shopify-section-{{ section.id }} .skin-type__header h4 {
    font-size: {{ section.settings.label_size }}px;
    letter-spacing: {{ section.settings.label_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.label_line_height | divided_by: 100.0 }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .skin-type__main > h1 {
    width: 100%;
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .skin-type__main p {
    width: 100%;
    font-size: {{ section.settings.description_size }}px;
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }

  /* Button text (alignment is handled by the button) */
  #shopify-section-{{ section.id }} .skin-type-btn {
    --btn-text-size: {{ section.settings.cta_size }}px;
    font-size: {{ section.settings.cta_size }}px;
    letter-spacing: {{ section.settings.cta_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.cta_line_height | divided_by: 100.0 }};
  }

  /* Footer text */
  #shopify-section-{{ section.id }} .skin-type__footer h3 {
    width: 100%;
    font-size: {{ section.settings.footer_size }}px;
    letter-spacing: {{ section.settings.footer_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.footer_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.footer_alignment }};
  }
{% endstyle %}

