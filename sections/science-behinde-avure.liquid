{% assign behinde_avure = shop.metaobjects.science_behind_avure.values %}

<div class="science-behind-avure_wrapper">
  <div class="science-behind-avure_container">
    <div class="science-behind-avure_header">
      <p class="science-avure_subheading">{{ section.settings.subheading }}</p>
      <h1 class="science-avure_heading">{{ section.settings.heading }}</h1>
      <p class="science-avure_description">{{ section.settings.description }}</p>
    </div>
    <div class="science-behind-avure_carousel">
      {% for c in behinde_avure %}
        {%- render 'image-text-item', item: c -%}
      {% endfor %}
    </div>
  </div>
</div>

{%- stylesheet -%}
  .science-behind-avure_wrapper {
    width: 100%;
    display: grid;
    /* minmax(0,1fr): keep the column at screen width so the carousel scrolls instead of overflowing */
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    margin-block: calc(128 * var(--fu)) calc(64 * var(--fu));
  }
  .science-behind-avure_container {
    width: 90%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    font-family: var(--text-font-primary);
    .science-behind-avure_header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: calc(28.8 * var(--fu));
      .science-avure_subheading {
        font-family: var(--text-font-accent);
      }
      .science-avure_heading {
        width: 60%;
        font-weight: 600;
      }
      .science-avure_description {
        width: 50%;
        font-family: var(--text-font-secondary);
        font-weight: 500;
      }
    }
    .science-behind-avure_carousel {
      width: 100%;
      display: grid;
      /* direction: rtl; */
      grid-auto-flow: column;
      grid-auto-columns: 90%;
      overflow-y: hidden;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      gap: calc(38.4 * var(--fu));
      padding-block: calc(48 * var(--fu)) 0;
      > * {
        direction: ltr;
      }
    }
  }
  /* Slide caption (image-text-item snippet), scoped so the product-page ingredients are unaffected */
  .science-behind-avure_wrapper .science-behind-avure_carousel .ingredient-info_container .ingredient-name {
    font-family: var(--text-font-accent);
    font-size: var(--type-label);
    font-weight: 500;
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .science-behind-avure_wrapper .science-behind-avure_carousel .product-ingredient_wrapper {
    gap: calc(24 * var(--fu));
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Subheading */
  #shopify-section-{{ section.id }} .science-avure_subheading {
    font-size: calc({{ section.settings.subheading_size }} * var(--fu));
    letter-spacing: {{ section.settings.subheading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.subheading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.subheading_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .science-avure_heading {
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .science-avure_description {
    font-size: calc({{ section.settings.description_size }} * var(--fu));
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .science-avure_subheading { font-size: 11px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .science-avure_heading { font-size: 24px; }
    #shopify-section-{{ section.id }} .science-avure_description { font-size: 13px; letter-spacing: -0.08em; line-height: 1.4; }
  }
  /* auto:freeze-end */
{% endstyle %}

