{%- assign diagnostic_stats = shop.metaobjects.diagnostic_stats.values -%}

<div class="diagnostic_stats-wrapper">
  <div class="diagnostic_stats-container">
    {%- for stat in diagnostic_stats -%}
      <div class="stat-item__container">
        <h1 class="stat-number">{{ stat.stat_number.value }}</h1>
        <p class="stat-text">{{ stat.stat_text.value }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{%- stylesheet -%}
  .diagnostic_stats-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .diagnostic_stats-container {
    width: 90%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    place-items: center;
    margin-block: calc(128 * var(--fu));
    .stat-item__container {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: calc(32 * var(--fu));
      .stat-number {
        width: 100%;
        font-family: var(--text-font-primary);
        font-weight: 600;
      }
      .stat-text {
        width: 100%;
        font-family: var(--text-font-secondary);
        font-weight: 500;
      }
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Stat number */
  #shopify-section-{{ section.id }} .stat-number {
    font-size: calc({{ section.settings.number_size }} * var(--fu));
    letter-spacing: {{ section.settings.number_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.number_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.number_alignment }};
  }

  /* Stat text */
  #shopify-section-{{ section.id }} .stat-text {
    font-size: calc({{ section.settings.text_size }} * var(--fu));
    letter-spacing: {{ section.settings.text_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.text_alignment }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .stat-number { font-size: 24px; }
    #shopify-section-{{ section.id }} .stat-text { font-size: 12px; line-height: 1.4; }
  }
  /* auto:freeze-end */
{% endstyle %}

{% schema %}
{
  "name": "Diagnostic stats",
  "settings": [
    {
      "type": "header",
      "content": "Stat number typography"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Font size",
      "min": 20,
      "max": 220,
      "step": 2,
      "unit": "px",
      "default": 40,
      "info": "Figma px (768px mobile frame). Scales with the screen width on phones."
    },
    {
      "type": "range",
      "id": "number_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -8
    },
    {
      "type": "range",
      "id": "number_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text_alignment",
      "id": "number_alignment",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Stat text typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Font size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 22,
      "info": "Figma px (768px mobile frame). Scales with the screen width on phones."
    },
    {
      "type": "range",
      "id": "text_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -2
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Diagnostic stats"
    }
  ]
}
{% endschema %}
