<section class="skincare-steps__wrapper">
  <div class="skincare-steps__container">
    <span class="skincare-steps__heading">
      {{ section.settings.heading | escape }}
    </span>
    {% assign collection_count = 0 %}

    <div class="step-selector">
      {% for collection in collections %}
        {% unless collection.handle == 'routines-duos' %}
          {% assign collection_count = collection_count | plus: 1 %}
          <h2
            class="{% if collection_count == 1 %}selected{% endif %}"
            role="button"
            tabindex="0"
            data-category="{{ collection.title | handleize }}"
            aria-pressed="{% if collection_count == 1 %}true{% else %}false{% endif %}"
          >
            {{ collection.title | escape }}
          </h2>
        {% endunless %}
      {% endfor %}
    </div>

    <div>
      {% for collection in collections %}
        {% unless collection.handle == 'routines-duos' %}
          {% if collection.products.size > 0 %}
            <ul data-category="{{ collection.title | handleize }}" class="all-collections__products" role="list">
              {% for product in collection.products %}
                {%- render 'product-card', product: product -%}
              {% endfor %}
            </ul>

          {% else %}
            {% comment %} <p>No products in this collection.</p>   {% endcomment %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>

    <a class="skincare-steps__link" href="/collections/all">View all</a>
  </div>
</section>
<script>
  var product_list = document.querySelectorAll('.all-collections__products');
  headings = document.querySelectorAll('.skincare-steps__wrapper .step-selector h2[role="button"]');
  var cat = headings[0].dataset.category;
  console.log(cat);
  const hide_all = () => {
    product_list.forEach((item, index) => {
      item.hidden = index !== 0;
    });
  };
  const filter_products = () => {
    product_list.forEach((item) => {
      item.hidden = item.dataset.category !== cat;
      Array.from(item.children).forEach((product, index) => {
        product.hidden = index >= 2;
      });
    });
  };

  filter_products();

  headings.forEach((heading) => {
    const selectHeading = () => {
      const selector = heading.closest('.step-selector');
      selector.querySelectorAll('h2[role="button"]').forEach((item) => {
        const isSelected = item === heading;
        cat = heading.dataset.category;
        console.log(heading.innerHTML);
        filter_products();
        item.classList.toggle('selected', isSelected);
        item.setAttribute('aria-pressed', isSelected);
      });
    };

    heading.addEventListener('click', selectHeading);
  });
</script>
{%- stylesheet -%}
  .skincare-steps__wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* margin-block: 3.5rem; */

    .skincare-steps__heading {
      font-family: var(--text-font-accent);
      color: var(--text-color-dark);
      font-weight: 600;
      text-transform: uppercase;
    }
    .all-collections__products[hidden] {
      display: none;
    }
  }
  .skincare-steps__container {
    width: 90%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-block: calc(64 * var(--fu));
    gap: calc(64 * var(--fu));
    .step-selector {
      width: 100%;
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: calc(16 * var(--fu));
      .selected {
        --color: var(--color-dark);
        font-weight: 700;
      }
      .selected::before {
        content: '';
        position: absolute;
        left: 0;
        bottom: calc(-8 * var(--fu));
        width: 100%;
        height: 2px;
        background-color: var(--color);
        border-radius: calc(200 * var(--fu));
      }

      h2 {
        --color: var(--color-dark-disabled);
        /* border-bottom: calc(12.8 * var(--fu)) solid;
        border-color: var(--color); */
        font-family: var(--text-font-accent);
        font-weight: 400;
        stroke-linecap: round;
        color: var(--color);
        user-select: none;
        cursor: pointer;
        text-transform: uppercase;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: calc(16 * var(--fu));
        flex: 0 1 auto;
        min-width: 0;
        white-space: nowrap;
      }
    }
    .skincare-steps__link {
      text-decoration: underline;
      font-family: var(--text-font-accent);
      color: var(--text-color-dark);
      text-transform: uppercase;
    }
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section, so the
  product-card snippet is unchanged and cards used in other sections are unaffected.
{%- endcomment -%}
{% style %}
  /* Section heading */
  #shopify-section-{{ section.id }} .skincare-steps__heading {
    width: 100%;
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Step tabs */
  #shopify-section-{{ section.id }} .step-selector h2 {
    font-size: calc({{ section.settings.tab_size }} * var(--fu));
    letter-spacing: {{ section.settings.tab_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.tab_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.tab_alignment }};

  }

  /* View all link (flex item, so no alignment setting) */
  #shopify-section-{{ section.id }} .skincare-steps__link {
    font-size: calc({{ section.settings.link_size }} * var(--fu));
    letter-spacing: {{ section.settings.link_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.link_line_height | divided_by: 100.0 }};
  }

  /* Card badge (positioned over the image, so no alignment setting) */
  #shopify-section-{{ section.id }} .product-card_container .badge-title {
    font-size: calc({{ section.settings.badge_size }} * var(--fu));
    letter-spacing: {{ section.settings.badge_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.badge_line_height | divided_by: 100.0 }};
  }

  /* Card title */
  #shopify-section-{{ section.id }} .product-card_container .product-info > h3 {
    width: 100%;
    font-size: calc({{ section.settings.card_title_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_title_alignment }};
  }

  /* Card description */
  #shopify-section-{{ section.id }} .product-card_container .product-info > p {
    width: 100%;
    font-size: calc({{ section.settings.card_description_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_description_alignment }};
  }

  /* Card price */
  #shopify-section-{{ section.id }} .product-card_container .product-info .price {
    display: block;
    width: 100%;
    font-size: calc({{ section.settings.card_price_size }} * var(--fu));
    letter-spacing: {{ section.settings.card_price_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.card_price_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.card_price_alignment }};
  }

  /* Figma mobile (768 frame): fonts and weights, phones only */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .skincare-steps__heading { font-family: var(--text-font-accent); font-weight: 600; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .step-selector h2 { font-family: var(--text-font-accent); font-weight: 700; }
    #shopify-section-{{ section.id }} .skincare-steps__link { font-family: var(--text-font-primary); font-weight: 500; }
  }

  /* Tablet and desktop keep the sizes they had before the Figma mobile values were entered.
     (Fixed here, so changing these settings only affects phones.) */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .skincare-steps__heading { font-size: 11px; letter-spacing: 0.14em; }
    #shopify-section-{{ section.id }} .step-selector h2 { font-size: 11px; letter-spacing: 0em; }
    #shopify-section-{{ section.id }} .skincare-steps__link { font-size: 11px; }
    #shopify-section-{{ section.id }} .product-card_container .product-info > h3 { font-size: 13px; letter-spacing: 0em; line-height: 1.2; }
    #shopify-section-{{ section.id }} .product-card_container .product-info > p { font-size: 11px; }
    #shopify-section-{{ section.id }} .product-card_container .product-info .price { font-size: 13px; }
  }
{% endstyle %}

