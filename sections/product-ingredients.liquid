


{% assign ingredients = product.metafields.custom.ingredients.value %}

<div class="product-ingredients_wrapper">
    <div class="product-ingredients-main_container">
        {%- comment -%} Desktop-only intro (hidden below 1024px; shown in assets/avure-desktop.css) {%- endcomment -%}
        <div class="product-ingredients__intro">
            <h2 class="product-ingredients__title">{{ section.settings.title | escape }}</h2>
            {%- if section.settings.description != blank -%}
                <p class="product-ingredients__description">{{ section.settings.description | escape }}</p>
            {%- endif -%}
        </div>

        
        <div class="product-ingredients-carousel">
            {% for c in ingredients %}
                {%- render 'product-ingredient', item:c -%}
            {% endfor %}
        </div>
    </div>

</div>


{%- stylesheet -%}
.product-ingredients_wrapper{
    margin-top: 0;
    width: 100%;
    display: grid;
    place-items: center;
    margin-bottom: calc(64 * var(--fu));
    /* gap: calc(64 * var(--fu)); */
}
.product-ingredients-main_container{
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(48 * var(--fu));
    justify-content: center;
    font-family: var(--text-font-primary);
    .product-ingredients-carousel{
        width: 100%;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 90%;
        overflow-y: hidden;
        overflow-x: scroll;
        scroll-snap-type: x mandatory;
        gap: calc(38.4 * var(--fu));
        padding-block: calc(32 * var(--fu)) calc(64 * var(--fu));
    }
}
.product-ingredients_wrapper .product-ingredients-carousel .ingredient-info_container .ingredient-name {
    font-size: calc(32 * var(--fu));
    font-weight: 700;
    text-align: left;
}
.product-ingredients_wrapper .product-ingredients-carousel .ingredient-info_container .ingredient-inci {
    font-size: calc(24 * var(--fu));
    font-weight: 700;
    text-align: left;
}
.product-ingredients__intro{
    display: none;
}
{%- endstylesheet -%}

{% schema %}
{
  "name": "Product ingredients",
  "settings": [
    { "type": "text", "id": "title", "label": "Title (desktop)", "default": "Clinical ingredients" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (desktop)",
      "default": "The active ingredients in this formula, what each one does, and why it's here."
    }
  ]
}
{% endschema %}