{% render 'section-typography', section_id: section.id, section_settings: section.settings %}
<section class="all-collections ">
  <div class="all-collections__header">
    {%- render 'breadcrumb', title: section.settings.heading -%}
    <h1 class="  _title all-collections__title">
      <span class="title-dot"></span>
      <span>
        {{ section.settings.heading | escape }}
      </span>
    </h1>
    <h2>
      {%- assign sub_heading = section.settings.sub_heading | escape -%}
      {%- if sub_heading == '.' -%}
        <span></span>
      {%- else -%}
        <span>{{ sub_heading }}</span>
      {%- endif -%}
    </h2>
    <p>{{ section.settings.description | escape }}</p>
  </div>

  {%- comment -%}
    Steps in routine order. Each entry matches a collection by handle, or by its handleized title.
    The step number is the position in this list, so it stays the same when a step is skipped.
    Steps with no products are not shown.
  {%- endcomment -%}
  {%- assign step_order = 'cleanse,exfoliate,treat,hydrate,protect' | split: ',' -%}
  {%- for step in step_order -%}
    {%- assign step_collection = collections[step] -%}
    {%- if step_collection.id == blank -%}
      {%- for candidate in collections -%}
        {%- assign candidate_handle = candidate.title | handleize -%}
        {%- if candidate_handle == step -%}
          {%- assign step_collection = candidate -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if step_collection.id != blank and step_collection.products.size > 0 -%}
      <div class="all-collections__collection">
        <h2 class="collection__title">
          <a href="{{ step_collection.url }}">
            {{- forloop.index | prepend: '0' | slice: -2, 2 }}. {{ step_collection.title | upcase | escape -}}
          </a>
        </h2>
        <ul class="all-collections__products" role="list">
          {%- for product in step_collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

{%- stylesheet -%}
  .all-collections__header {
    p {
      font-family: var(--text-font-secondary);
      font-weight: 400;
      font-size: var(--text-h4);
      line-height: var(--text-h1-leading);
      color: var(--text-color-muted);
    }
    .all-collections__title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      .title-dot {
        --size: 1.1rem;
        width: var(--size);
        height: var(--size);
        aspect-ratio: 1/1;
        border-radius: 50rem;
        background-color: var(--color-dark);
      }
    }
  }

  .all-collections {
    display: flex;
    flex-direction: column;
    margin: 2rem;
    gap: 4rem;
    ._title {
      font-family: var(--text-font-primary);
      width: auto;
      white-space: nowrap;
      font-weight: 800;
      font-size: var(--type-title);
      line-height: var(--text-h1-leading);
    }
    .all-collections__collection .collection__title {
      margin-bottom: 1rem;
      font-family: var(--text-font-accent);
      font-size: 22px;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
    }
  }
  .all-collections__collection {
    width: 100%;
  }
  .all-collections__products {
    --cols-mobile: 2;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr));
    /* grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); */
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "All products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All products"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "subheading",
      "default": "."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every Avure product, in the order you'd use it. You don't need them all: start with one step and add more when you want to."
    }
  ]
}
{% endschema %}
