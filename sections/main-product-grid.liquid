{% render 'section-typography', section_id: section.id, section_settings: section.settings %}
<section class="all-collections ">
	<div class="all-collections__header">
        <h1  class="  _title all-collections__title">
            <span class="title-dot"></span>
            <span>

                {{ section.settings.heading | escape }}
            </span>
        </h1>
        <h2>
                {%- assign sub_heading = section.settings.sub_heading | escape  -%}
                {%- if sub_heading == "." -%}
                    <span></span>
                    {%- else -%}
                        <span>{{ sub_heading }}</span>
                {%- endif -%}
        </h2>
	    <p>{{ section.settings.description | escape }}</p>
    </div>

	{% assign collection_count = 0 %}
	{% for collection in collections %}
        {% unless collection.handle == 'routines-duos' %}
		{% assign collection_count = collection_count | plus: 1 %}
		<div class="all-collections__collection">
            {%- assign step_label = collection.description | strip_html | remove: "Step" | remove: "step" | strip -%}
			<h2 class="_title collection__title"><a href="{{ collection.url }}"> {{ step_label }}.{{ collection.title | escape }}</a></h2>
 
			{% if collection.products.size > 0 %}
				<ul class="all-collections__products" role="list">
					{% for product in collection.products %}
                        {%- render 'product-card', product: product -%}
					{% endfor %}
				</ul>

			{% else %}
				<p>No products in this collection.</p>
			{% endif %}

		</div>
            
        {%- endunless -%}
	{% endfor %}

	{% if collection_count == 0 %}
		<p>No collections found.</p>
	{% endif %}
</section>

{%- stylesheet -%}


    .all-collections__header{
        p{
            font-family: var(--text-font-secondary);
            font-weight: 400;
            font-size: var(--text-h4);
            text-transform: capitalize;
            line-height: var(--text-h1-leading) ;
            text-transform: capitalize;
            color: var( --text-color-muted );

        }
            .all-collections__title{
        display: flex;
        align-items: center;
        gap: .5rem;
        .title-dot{
            --size:1.1rem;
            width: var(--size);
            height: var(--size);
            aspect-ratio: 1/1;
            border-radius: 50rem;
            background-color: var(--color-dark);
           }

    }
    }

.all-collections{
        display: flex;
        flex-direction: column;
        margin: 2rem; 
        gap:4rem;
        .collection__title{
        text-transform: uppercase;
            
        }
        ._title{
        font-family: var(--text-font-accent);
        width: 2%;
        font-weight: 800;
        font-size: var(--text-h1);
        text-transform: capitalize;
        line-height: var(--text-h1-leading) ;
        text-transform: capitalize;

    }
}
  	.all-collections__collection { 
        width: 100%;


    }
	.all-collections__products {
        --cols-mobile:2;
        width: 100%;
		display: grid;
        grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr));
		/* grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); */
		gap: 1.5rem;
		padding: 0;
		list-style: none;
	}

{%- endstylesheet -%}

{% schema %}
{
	"name": "All products",
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "All products"
		},
		{
			"type": "text",
			"id": "sub_heading",
			"label": "subheading",
			"default": "."
		},
		{
			"type": "textarea",
			"id": "description",
			"label": "Description",
			"default": "Every Avure product, in the order you'd use it. You don't need them all: start with one step and add more when you want to."
		}
	,
    {"type": "header", "content": "Heading typography"},
    {"type": "checkbox", "id": "typography_heading_enabled", "label": "Customize headings", "default": false},
    {"type": "range", "id": "typography_heading_size", "label": "Font size", "min": 8, "max": 120, "step": 1, "unit": "px", "default": 24},
    {"type": "range", "id": "typography_heading_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_heading_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_heading_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Body typography"},
    {"type": "checkbox", "id": "typography_body_enabled", "label": "Customize bodys", "default": false},
    {"type": "range", "id": "typography_body_size", "label": "Font size", "min": 10, "max": 48, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "typography_body_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_body_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_body_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Label typography"},
    {"type": "checkbox", "id": "typography_label_enabled", "label": "Customize labels", "default": false},
    {"type": "range", "id": "typography_label_size", "label": "Font size", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "typography_label_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_label_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_label_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Action typography"},
    {"type": "checkbox", "id": "typography_action_enabled", "label": "Customize actions", "default": false},
    {"type": "range", "id": "typography_action_size", "label": "Font size", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "typography_action_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_action_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_action_alignment", "label": "Alignment", "default": "center"}
  ]
}
{% endschema %}



