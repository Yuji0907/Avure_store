<footer class="site-footer">
  <div class="site-footer__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="site-footer__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <ul class="site-footer__social">
      {%- if section.settings.instagram != blank -%}
        <li>
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            {% render 'instagram' %}
          </a>
        </li>
      {%- endif -%}
      {%- if section.settings.tiktok != blank -%}
        <li>
          <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            {% render 'tiktok' %}
          </a>
        </li>
      {%- endif -%}
      {%- if section.settings.facebook != blank -%}
        <li>
          <a
            class="facebook-wrapper"
            href="{{ section.settings.facebook }}"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
          >
            {% render 'facebook' %}
          </a>
        </li>
      {%- endif -%}
    </ul>

    {%- if section.settings.email != blank -%}
      <a class="site-footer__email" href="mailto:{{ section.settings.email }}">
        {{ section.settings.email }}
      </a>
    {%- endif -%}

    <hr class="site-footer__divider">
  </div>

  <div class="site-footer__bottom">
    <p>
      &copy; {{ 'now' | date: '%Y' }}
      {{ section.settings.brand_name | default: 'Avure' | escape }}. All Rights Reserved.
    </p>
  </div>
</footer>

{%- stylesheet -%}
  .site-footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: calc(96 * var(--fu));
  }
  .site-footer__inner {
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(16 * var(--fu));
    padding: calc(96 * var(--fu)) calc(48 * var(--fu)) 0;
  }
  .site-footer__title {
    width: 100%;
    font-weight: 700;
    font-family: var(--text-font-primary);
    margin-bottom: calc(32 * var(--fu));
  }
  .site-footer__social {
    display: flex;
    gap: calc(38.4 * var(--fu));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: calc(96 * var(--fu));
    height: calc(96 * var(--fu));
    border-radius: calc(19.2 * var(--fu));
    background: var(--bg-dark);
    color: var(--color-light);
    .social-icon {
      path {
        fill: var(--color-light);
      }
    }
  }
  .site-footer__email {
    font-family: var(--text-font-primary);
    font-weight: 600;
  }
  .facebook-wrapper a {
    background-color: transparent;
    .facebook-icon {
      svg {
        width: 3rem;
        height: 3rem;
        path {
          fill: var(--color-dark);
        }
      }
    }
  }
  .site-footer__social a.facebook-wrapper {
    background: transparent;
  }

  .site-footer__social a.facebook-wrapper svg {
    width: 3rem;
    height: 3rem;
  }

  .site-footer__social a.facebook-wrapper svg path {
    fill: var(--color-dark);
  }
  .site-footer__divider {
    width: 90%;
    border: 0;
    border-top: calc(5.76 * var(--fu)) solid var(--color-dark);
    margin-top: calc(57.6 * var(--fu));
  }
  .site-footer__bottom {
    padding-block: calc(16 * var(--fu));
  }
{%- endstylesheet -%}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Title */
  #shopify-section-{{ section.id }} .site-footer__title {
    font-size: calc({{ section.settings.title_size }} * var(--fu));
    letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.title_alignment }};
  }

  /* Email (flex item that shrinks to its text, so no alignment setting) */
  #shopify-section-{{ section.id }} .site-footer__email {
    font-size: calc({{ section.settings.email_size }} * var(--fu));
    letter-spacing: {{ section.settings.email_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.email_line_height | divided_by: 100.0 }};
  }

  /* Copyright */
  #shopify-section-{{ section.id }} .site-footer__bottom p {
    font-size: calc({{ section.settings.copyright_size }} * var(--fu));
    letter-spacing: {{ section.settings.copyright_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.copyright_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.copyright_alignment }};
  }

  /* auto:freeze-start: tablet/desktop keep their pre-Figma sizes; these settings now hold
     Figma mobile values (768 frame), so changing them only affects phones. */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .site-footer__title { line-height: 1.1; }
    #shopify-section-{{ section.id }} .site-footer__bottom p { font-size: 11px; line-height: 1.4; }
  }
  /* auto:freeze-end */
{% endstyle %}

