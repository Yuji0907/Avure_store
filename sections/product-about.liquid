
{% assign product_lable = product.metafields.custom.product_name %}
{% assign product_tagline = product.metafields.custom.product_tagline %}
{% assign product_features = product.metafields.custom.product_features.value %}
{% assign product_benefits = product.metafields.custom.product_benefits.value %}
{% assign how_to_use = product.metafields.custom.how_to_use.value %}
{% assign is_it_for_you = product.metafields.custom.is_it_for_you.value %}


<div class="product-about_wrapper">
    <div class="product-about-main_container">

        <div class="product-details_container">
            <h1 class="product-lable">
                {{ product_lable }}
            </h1>
            <p class="product-tagline">
                {{ product_tagline }}
            </p>
            <ul class="product-features_list">
                {% for feat in product_features %}
                    <li class="product-feature">
                        <p>{{ feat }}</p>
                        {%- render 'V-avure_icon', size:32 -%}
                    </li>
                {% endfor %}
            </ul>
        </div>



        <div class="accordings_container">
            {%- render 'accordion',title:"Benifits",items:product_benefits -%}
            {%- render 'accordion',title:"How to use",items:how_to_use -%}
            {%- render 'accordion',title:"is it for you?",items:is_it_for_you,last:true -%}
        </div>


    </div>
</div>

{%- stylesheet -%}
.product-about_wrapper{
    width: 100%;
    display: grid;
    place-items: center;
    /* gap: 2rem; */
}
.product-about-main_container{
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    justify-content: center;
    font-family: var(--text-font-primary);

    .product-details_container{
        width: 100%;
        .product-lable{
            width: 100%;
            font-weight: 700;
            font-size: var(--text-h2);
            text-transform: capitalize;
            line-height: var(--text-h1-leading) ;
        }
        .product-tagline{
            width: 100%;
            font-weight: 400;
            font-size: var(--text-h3);
            text-transform: capitalize;
            line-height: var(--text-h1-leading) ;
        }
        .product-features_list{
            width: 100%;
            font-weight: 500;
            font-family: var(--text-font-secondary);
            font-size: var(--text-h3);
            text-transform: capitalize;
            line-height: var(--text-h1-leading) ;
            display: flex;
            flex-direction: column;
            gap: .25rem;
            
            margin-top: 1.4rem;
            .product-feature{
                display: flex;
                gap: .8rem;
                flex-direction: row-reverse;
                align-items: center;
                justify-content: flex-end;
                fill: var(--fill-dark);

            }
        }
    }
    .accordings_container{
        display: flex;
        flex-direction: column;
        align-items: center;
        /* gap: 1.5rem; */
        margin-top: 1.5rem;
        width: 100%;
        font-family: var(--text-font-primary);
        font-size: var(--text-h3);
    }
}


{%- endstylesheet -%}