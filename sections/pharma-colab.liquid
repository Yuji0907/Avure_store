<section class="pharma-colab" aria-labelledby="pharma-colab-heading-{{ section.id }}">
  <div class="pharma-colab__hero">
    {%- if section.settings.colab_image != blank -%}
      {{
        section.settings.colab_image
        | image_url: width: 2000
        | image_tag: alt: section.settings.colab_image.alt, loading: 'eager', class: 'pharma-colab__image'
      }}
    {%- else -%}
      <img
        class="pharma-colab__image"
        src="{{ 'Woman_wearing_lab_coat.png' | asset_url }}"
        width="2000"
        height="1200"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="pharma-colab__content">
      {%- if section.settings.label != blank -%}
        <p class="pharma-colab__eyebrow">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.hero_title != blank -%}
        <h1 class="pharma-colab__heading" id="pharma-colab-heading-{{ section.id }}">
          {{ section.settings.hero_title | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="pharma-colab__description">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta != blank -%}
        <div class="btton-wrrapper">
          <a class="avure-button pharma-colab__cta" href="{{ section.settings.cta_link | default: '/pages/colab-form' }}">
            {{- section.settings.cta | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pharma-colab {
    width: 100%;
    font-family: var(--text-font-secondary);
  }
  .pharma-colab__hero {
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pharma-colab__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(840 * var(--fu));
    object-fit: cover;
    object-position: top;
  }
  .pharma-colab__cta {
    display: block;
    text-align: center;
    text-decoration: none;
  }

  .pharma-colab__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: calc(24 * var(--fu));
    color: var(--text-color-secondary);
    width: 80%;
    margin-bottom: calc(96 * var(--fu));
  }

  .pharma-colab__eyebrow {
    font-family: var(--text-font-accent);
    margin: calc(64 * var(--fu)) 0 0;
    text-transform: uppercase;
  }

  .pharma-colab__heading {
    font-family: var(--text-font-primary);
    font-weight: 600;
    width: 95%;
    margin: 0;
  }

  .pharma-colab__description {
    width: 90%;
    font-family: var(--text-font-primary);
    margin: 0;
  }

  .btton-wrrapper {
    margin-top: calc(96 * var(--fu));
    width: 100%;
  }
{% endstylesheet %}

{%- comment -%}
  Typography is in {% style %} because {% stylesheet %} can't use Liquid. Scoped to this section instance.
{%- endcomment -%}
{% style %}
  /* Eyebrow */
  #shopify-section-{{ section.id }} .pharma-colab__eyebrow {
    width: 100%;
    font-size: calc({{ section.settings.eyebrow_size }} * var(--fu));
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.eyebrow_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.eyebrow_alignment }};
  }

  /* Heading */
  #shopify-section-{{ section.id }} .pharma-colab__heading {
    font-size: calc({{ section.settings.heading_size }} * var(--fu));
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.heading_alignment }};
  }

  /* Description */
  #shopify-section-{{ section.id }} .pharma-colab__description {
    font-size: calc({{ section.settings.description_size }} * var(--fu));
    letter-spacing: {{ section.settings.description_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};
    text-align: {{ section.settings.description_alignment }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Pharma collaboration hero",
  "tag": "section",
  "class": "section-colab",
  "settings": [
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "colab_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Pharmacist in a lab coat"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Skincare you can explain at the counter."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Avure makes dermo-cosmetic care for sensitive skin.We give pharmacists the formula information, the simple routines and the support to recommend it"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow",
      "default": "For pharmacists & Dermatologists"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Call to action",
      "default": "Collaborate now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Call to action link",
      "info": "Leave empty to use /pages/colab-form (the pharmacist form page)"
    },
    {
      "type": "header",
      "content": "Eyebrow typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Font size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 22,
      "info": "Figma px (768px mobile frame). Scales with the screen width on phones."
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -8
    },
    {
      "type": "range",
      "id": "eyebrow_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    {
      "type": "text_alignment",
      "id": "eyebrow_alignment",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 20,
      "max": 220,
      "step": 2,
      "unit": "px",
      "default": 48,
      "info": "Figma px (768px mobile frame). Scales with the screen width on phones."
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": -4
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 110
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Description typography"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Font size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 26,
      "info": "Figma px (768px mobile frame). Scales with the screen width on phones."
    },
    {
      "type": "range",
      "id": "description_letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em (5 = 0.05em)",
      "min": -10,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Line height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 140
    },
    {
      "type": "text_alignment",
      "id": "description_alignment",
      "label": "Alignment",
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Pharma collaboration hero"
    }
  ]
}
{% endschema %}
