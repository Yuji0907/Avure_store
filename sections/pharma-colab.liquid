{% render 'section-typography', section_id: section.id, section_settings: section.settings %}
<section class="pharma-colab" aria-labelledby="pharma-colab-heading-{{ section.id }}">
  <div class="pharma-colab__hero">
    {%- if section.settings.colab_image != blank -%}
      {{ section.settings.colab_image
        | image_url: width: 2000
        | image_tag: alt: section.settings.colab_image.alt, loading: 'eager', class: 'pharma-colab__image'
      }}
    {%- else -%}
      <img
        class="pharma-colab__image"
        src="{{ 'Woman_wearing_lab_coat.png' | asset_url }}"
        width="2000"
        height="1200"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="pharma-colab__content">
      {%- if section.settings.label != blank -%}
        <p class="pharma-colab__eyebrow">{{ section.settings.label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.hero_title != blank -%}
        <h1 class="pharma-colab__heading" id="pharma-colab-heading-{{ section.id }}">
          {{ section.settings.hero_title | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="pharma-colab__description">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta != blank  -%}
        <div class="btton-wrrapper">

          <button  class=" avure-button " type="btn">{{ section.settings.cta | escape }}</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>






{% stylesheet %}


.pharma-colab {
  width: 100%;
  font-family: var(--text-font-accent);
}
.pharma-colab__hero {
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pharma-colab__image {
  display: block;
  object-fit: cover;
  width: 100%;
  height: auto;
}

.pharma-colab__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: .75rem;
  color: var(--text-color-secondary);
  width: 80%;
  text-align: center;
  margin-bottom: 3rem;
}

.pharma-colab__eyebrow {
  font-family: var(--text-font-accent);
  font-size: var(--text-lg);
  margin: 2rem 0 0;
  letter-spacing: -1.44px;
  text-transform: uppercase;
}

.pharma-colab__heading {
  font-family: var(--text-font-primary);
  font-size:var(--text-h2);
  font-weight: 600;
  width: 95%;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: -1.44px;
}

.pharma-colab__description {
  width: 90%;
  font-family: var(--text-font-primary);
  font-size: var(--text-h4);
  margin: 0;
}

.btton-wrrapper{
    margin-top: 3rem;
    width: 100%;
}


{% endstylesheet %}



{% schema %}
{
  "name": "Pharma collaboration hero",
  "tag": "section",
  "class": "section-colab",
  "settings": [

    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "colab_image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Pharmacist in a lab coat" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "hero_title", "label": "Hero Title", "default": "Skincare you can explain at the counter." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Avure makes dermo-cosmetic care for sensitive skin.We give pharmacists the formula information, the simple routines and the support to recommend it" },
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "For pharmacists & Dermatologists" },
    { "type": "text", "id": "cta", "label": "Call to action", "default": "Collaborate now" },
    
  
    {"type": "header", "content": "Heading typography"},
    {"type": "checkbox", "id": "typography_heading_enabled", "label": "Customize headings", "default": false},
    {"type": "range", "id": "typography_heading_size", "label": "Font size", "min": 8, "max": 120, "step": 1, "unit": "px", "default": 24},
    {"type": "range", "id": "typography_heading_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_heading_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_heading_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Body typography"},
    {"type": "checkbox", "id": "typography_body_enabled", "label": "Customize bodys", "default": false},
    {"type": "range", "id": "typography_body_size", "label": "Font size", "min": 10, "max": 48, "step": 1, "unit": "px", "default": 16},
    {"type": "range", "id": "typography_body_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_body_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_body_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Label typography"},
    {"type": "checkbox", "id": "typography_label_enabled", "label": "Customize labels", "default": false},
    {"type": "range", "id": "typography_label_size", "label": "Font size", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "typography_label_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_label_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_label_alignment", "label": "Alignment", "default": "center"},
    {"type": "header", "content": "Action typography"},
    {"type": "checkbox", "id": "typography_action_enabled", "label": "Customize actions", "default": false},
    {"type": "range", "id": "typography_action_size", "label": "Font size", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 14},
    {"type": "range", "id": "typography_action_letter_spacing", "label": "Letter spacing", "info": "In hundredths of an em (5 = 0.05em)", "min": -10, "max": 30, "step": 1, "default": 0},
    {"type": "range", "id": "typography_action_line_height", "label": "Line height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 140},
    {"type": "text_alignment", "id": "typography_action_alignment", "label": "Alignment", "default": "center"}
  ],
  "presets": [{ "name": "Pharma collaboration hero" }]
}
{% endschema %}