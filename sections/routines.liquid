{% render 'section-typography', section_id: section.id, section_settings: section.settings %}

<div class="products-hero_container">
  <div class="products-hero_content">
    <div class="products-hero_header">
      <h2 class="products-hero_title">Best Seller</h2>
      <a class="products-hero_link" href="/pages/routines-duos"> view all </a>
    </div>
    {%- render 'products-slider', category: 'best sellers' -%}
  </div>
</div>

{% schema %}
{
  "name": "hero products",
  "tag": "section",
  "class": "hero-products",
  "settings": [],
  "presets": [{ "name": "hero products" }]
}
{% endschema %}

{%- stylesheet -%}
  .products-hero_container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(16 * var(--fu));
  }
  .products-hero_content {
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-block: calc(192 * var(--fu));
    /* background-color: red; */
    .products-hero_header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .products-hero_title {
      font-size: var(--type-title);
      font-family: var(--text-primary);
      color: var(--text-color-dark);
      font-weight: 500;
      position: relative;
      display: flex;
      align-items: center;
      gap: calc(16 * var(--fu));
    }
    .products-hero_title::before {
      content: '';
      --size: calc(32 * var(--fu));
      width: var(--size);
      aspect-ratio: 1/1;
      border-radius: var(--size);
      background-color: var(--bg-dark);
    }
    .products-hero_link {
      font-size: var(--type-label);
      text-decoration: underline;
      font-family: var(--text-secondary);
      color: var(--text-color-dark);
      font-weight: 400;
      text-transform: uppercase;
    }
  }
{%- endstylesheet -%}
