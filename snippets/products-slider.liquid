
{% assign all_products = collections['all'].products %}

<ul class="product-slider_container">
    {% for product in all_products %}
        {% assign badge = product.metafields.custom.variant_badge.value %}
        {% if badge contains  "Best Sellers" %}
            {%- render 'product-card', product: product, badge_override: 'Best Sellers' -%}
        {% endif %}

    {% endfor %}

</ul>

{%- stylesheet -%}
      .product-slider_container{
        width:100%;
        overflow-y: hidden;
        overflow-x: scroll;
        scroll-snap-type: x mandatory;
        gap: calc(64 * var(--fu));
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 48%;
        padding-bottom: 0;

    }
{%- endstylesheet -%}
  






