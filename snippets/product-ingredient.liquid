
<div class="product-ingredient_wrapper">

    <div class="ingredient-image_container">
      {%- if item.ingredient_image != blank -%}
        {{ 
          item.ingredient_image | image_url: width: 600 | image_tag:
            alt: item.ingredient_name,
            loading: 'eager',
            class:"ingredient-image"
        }}
      {%- else -%}
        <p>No image</p>
      {%- endif -%}
    </div>

    <div class="ingredient-info_container">
        <div>
            <h1 class="ingredient-name">{{ item.ingredient_name }}</h1>
            <p class="ingredient-inci">{{ item.inci_name | strip_html }}</p>
        </div>

        <div class="ingredient-benefits_container">
            {% for benefit in item.benefits_properties.value %}
                <span class="ingredient-benefit" >
                    {%- render 'icon-button', style: "circle", size: 14 -%}
                    <p>{{benefit}}</p>
                </span>
            {% endfor %}
        </div>

        <p class="ingredient-desc">{{ item.ingredient_description }}</p>
    </div>



</div>

{%- stylesheet -%}
  .product-ingredient_wrapper{
    font-family: var(--text-font-primary);
    color: var(--text-color-secondary);
    line-height: 1.2;
    scroll-snap-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: calc(64 * var(--fu));
    .ingredient-image_container{
        display: flex;
        .ingredient-image{
            width: 100%;
            height: auto;
            object-fit: cover;
        }
    }


    .ingredient-info_container{
        width: 100%;
        font-size: var(--text-h3) ;
        display: flex;
        flex-direction: column;
        /* align-items: center; */
        gap: calc(25.6 * var(--fu));
        
        .ingredient-name{
            
            font-size: var(--text-h2) ;
            font-weight: 700;
        }
        .ingredient-inci{
            color: var(--text-color-secondary-subheading);
                font-weight: 600;

        }
        .ingredient-benefits_container{
            /* margin-top: calc(25.6 * var(--fu)); */
            display: flex;
            flex-direction: column;
            gap: calc(8 * var(--fu));
            .ingredient-benefit{
                display: flex;
                align-items: center;
                gap: calc(8 * var(--fu));
                /* justify-content: center; */
                >p{
                    margin-top:  clamp( calc(16 * var(--fu)),.8vw, calc(32 * var(--fu)));;
                    line-height: 1;
                }
            }
        }
        .ingredient-desc{
                font-family: var(--text-font-secondary);
                font-size: var(--text-h3) ;
                text-align: justify;
                font-weight: 500;
                color: var(--text-color-muted);

        }
    }


}

{%- endstylesheet -%}