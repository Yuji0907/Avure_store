<div data-selector class="selector">
  {% for item in items %}
    <label class="radio">
      <input
        type="radio"
        name="option"
        value="{{ item.title | escape }}"
        data-price="{{ item.price | money }}"
        data-old="{{ item.compare_at_price | money }}"
        data-available="{{ item.available }}"
        data-id="{{ item.id }}"
        {% if forloop.first %}
          checked
        {% endif %}
      >
      <span class="radio-custom">{{ item.title }} ml</span>
    </label>
  {% endfor %}
</div>

{%- stylesheet -%}
  .selector {
    display: flex;
    gap: calc(28.8 * var(--fu));
    /* line-height: 1;     */
    line-height: 1;
    /* text-box: trim-both cap alphabetic; */
    > label {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: calc(32 * var(--fu));
      display: grid;
      place-items: center;
    }

    input[type='radio'] {
      opacity: 0;
      position: absolute;
      pointer-events: none;
    }

    input[type='radio']:checked + .radio-custom {
      background-color: var(--bg-dark);
      color: white;
    }

    .radio-custom {
      font-family: var(--text-font-primary);
      font-size: var(--text-lg);
      font-weight: 400;
      padding: calc(8 * var(--fu));
      padding-inline: calc(12.8 * var(--fu));
      border-radius: calc(16 * var(--fu));
      border: 1px solid var(--bg-dark);
      text-align: center;
      text-justify: auto;
      padding-top: calc(12.8 * var(--fu));
      cursor: pointer;
      user-select: none;
    }
  }
{%- endstylesheet -%}

{%- javascript -%}
  document.addEventListener('change', async (e) => {
    const radio = e.target.closest('[data-selector] input[type="radio"]');
    if (!radio) return;
    const selector = radio.closest('[data-selector]');

    const add_product = document.querySelector('[data-add-to-cart]');
    if (!add_product) return;

    add_product.dataset.variantId = radio.dataset.id;
    console.log('variant', add_product.dataset.variantId);

    const card = document.querySelector('.product-price_container');
    if (!card) return;

    const price = card.querySelector('.price');
    const old_price = card.querySelector('[data-type="old"]');
    if (price) price.textContent = radio.dataset.price;
    old_price.textContent = old_price ? radio.dataset.old : '';
  });
{%- endjavascript -%}
