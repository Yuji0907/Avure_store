<div class="carousel-wrraper">
    {%- assign i = 0 -%}
    {%- assign media_total = product.media.size -%}
    <div class="break-points">
        {%- for p in (1..media_total) -%}
            <div  data-selected="false"></div>
        {%- endfor -%}
    </div>
    <ul class="product-media_container">
        {% for media in product.media %}
            {% if media.media_type == 'image' %}
                <li class="product-media_item">
                    {{
                        media
                        | image_url: width: 800
                        | image_tag:
                        alt: media.alt,
                        loading: 'lazy',
                        class: 'product-media-image'
                    }}
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
{%- stylesheet -%}
    .carousel-wrraper{
        width: 100%;
        position: relative;
        .break-points{
            position: absolute;
            top: 0;
            right: 0;
            left: auto;
            width: 100%;
            display: grid;
            grid-template-columns:  repeat(auto-fit, minmax(1rem, 1fr));
            gap: 1rem;
            margin-top: 1rem;
            >div{
                min-width: 1rem;
                border-radius: 500px;
                height: 10px;
                background-color: var(--fill-carousel-points);
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
                
            }
            >div[data-selected="true"]{
                background-color: var(--fill-carousel-points-selcted);

            }
        }
        .product-media_container{
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: 100%;
            overflow-y: hidden;
            overflow-x: scroll;
            scroll-snap-type: x mandatory;

            .product-media_item{
                scroll-snap-align: start;
                width: 100%;
                aspect-ratio: 4/5;
            }
            .product-media-image{
                object-fit: cover;
                width: 100%;
                height: 100%;
            }
        }
    }
{%- endstylesheet -%}