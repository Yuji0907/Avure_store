{%- stylesheet -%}
:root{
}

  html{
    background-color:var( --bg-light) ;
    overflow-x: hidden;
    overflow-x: clip;
  }
  body{
    position: relative;
  }
  svg{
    /* width:2rem; */
    path{
        /* fill:var( --color-primary)  */
    }
  }
  .two-lines {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.avure-area{
    font-size:var(--type-input);
    padding-block:1rem;
    padding-inline:2rem;
    background-color: transparent;
    border:1px solid var(--color-dark);
    font-family: var(--text-font-secondary);
    width: 100%;
    min-height: 13rem;
    
}
.avure-input,
.avure-combo-box{
    font-size:var(--type-input);
    padding-block:1rem;
    padding-inline:2rem;
    background-color: transparent;
    border:1px solid var(--color-dark);
    font-family: var(--text-font-secondary);
  width: 100%;
    
}

.avure-button{
  --btn-text-size:var(--type-button);
    width: 100%;    

    font-family: var(--text-font-primary);
    font-weight: 500;
    font-size:var(--btn-text-size);
    color:var(--text-color-primary);
    padding-block:1rem;
    padding-inline:2rem;
    text-transform:uppercase;
    background-color: var(--bg-dark);
    border:1px solid var(--color-dark)
    
}

.avure-outline-button{
    --btn-text-size:var(--type-button);

    width: 100%;
    font-family: var(--text-font-primary);
    font-weight: 500;
    font-size:var(--btn-text-size);
    color:var(--text-color-secondary);
    padding-block:1rem;
    padding-inline:2rem;
    text-transform:uppercase;
    background-color: transparent;
    border:2px solid var(--color-dark)
    
}
.avure-outline-button[data-style="light"]{
    color:var(--text-color-primary);
    border-color: var(--color-light);
}
.avure-button[data-style="light"]{
    color:var(--text-color-secondary);
    border-color: var(--color-light);
    background-color: var(--bg-light);
}
.avure-input:focus,
.avure-combo-box:focus{
  outline: none;
}
@keyframes infinite-scroll{
  to{
    transform: translateX(-103%);
  }
}
{%- endstylesheet -%}