<div class="carousel-sm-wrraper">


    <ul class="product-media-sm_container">
        {% for media in product.media %}
            {% if media.media_type == 'image' %}
                <li class="product-media-sm_item">
                    {{
                        media
                        | image_url: width: 800
                        | image_tag:
                        alt: media.alt,
                        loading: 'lazy',
                        class: 'product-media-image-sm'
                    }}
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
{%- stylesheet -%}
    .carousel-sm-wrraper{
        width: 100%;
        position: relative;

        .product-media-sm_container{
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: 40%;
            overflow-y: hidden;
            overflow-x: scroll;
            scroll-snap-type: x mandatory;
            padding-inline: 4rem;
            padding-block: 2rem;
            gap: 1rem;
            .product-media-sm_item{
                scroll-snap-align: start;
                width: 100%;
                aspect-ratio: 4/5;
                border-radius: .6rem;
            }
            .product-media-image-sm{
                object-fit: cover;
                width: 100%;
                height: 100%;
                border-radius: .6rem;
            }
        }
    }
{%- endstylesheet -%}