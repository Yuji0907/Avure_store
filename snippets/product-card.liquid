{%- assign variant = product.selected_or_first_available_variant -%}

{%- assign in_cart = false -%}
{%- for item in cart.items -%}
  {%- if item.variant_id == variant.id -%}
    {%- assign in_cart = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<li class="product-card_container">
  <div class="product-image_container">
    <a href="{{ product.url }}" class="product-image_link" aria-label="{{ product.title | escape }}">
      {{ product.featured_image | image_url: width: 500 | image_tag: class: 'product-image', alt: product.title }}
    </a>

    <div class="product-card_hedear">
      {%- if product.has_only_default_variant -%}
        <button
          type="button"
          class="shopping-cart-add_container{% if in_cart %} is-in-cart{% endif %}"
          data-add-to-cart
          data-variant-id="{{ variant.id }}"
          data-title="{{ product.title | escape }}"
          aria-label="{% if in_cart %}In cart, open cart{% else %}Add {{ product.title | escape }} to cart{% endif %}"
          {% unless variant.available %}
            disabled
          {% endunless %}
        >
          <span class="icon-add">{% render 'shopping-cart-add' %}</span>
          <span class="icon-added">{% render 'shopping-cart-add-check' %}</span>
        </button>
      {%- else -%}
        <a
          href="{{ product.url }}"
          class="shopping-cart-add_container"
          aria-label="Choose options for {{ product.title | escape }}"
        >
          {% render 'shopping-cart-add' %}
        </a>
      {%- endif -%}

      {%- render 'product-badge', product: product, badge: badge_override -%}
    </div>
  </div>

  <div class="product-info">
    <h3>{{ product.title }}</h3>
    <p>{{ product.description | strip_html | truncate: 90 }}</p>
    <span class="price">{{ product.price | money }}</span>
  </div>
</li>

{%- stylesheet -%}
  .product-card_container {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: calc(19.2 * var(--fu));

    .product-image_container {
      position: relative;
      min-width: 100%;
      aspect-ratio: 2/3;

      .product-image_link {
        display: block;
        width: 100%;
        height: 100%;
      }

      .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .product-card_hedear {
        position: absolute;
        inset: 0 0 auto 0;
        padding: calc(48 * var(--fu));
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: space-between;
        pointer-events: none; /* clicks pass through to the image link */

        .badge-title {
          font-size: var(--type-caption);
          font-family: var(--text-primary);
          text-transform: uppercase;
          color: var(--badge-color, var(--text-color-brand));
          font-weight: 600;
        }

        svg {
          width: 2rem;
          height: 2rem;
          path {
            fill: var(--color-primary);
          }
        }
        .shopping-cart-add_container {
          pointer-events: auto;
          display: inline-flex;
          border: 0;
          cursor: pointer;
          background-color: var(--surface-icon);
          padding: calc(25.6 * var(--fu));
          border-radius: calc(25.6 * var(--fu));

          &:disabled {
            opacity: 0.5;
            cursor: not-allowed;
          }
          &.is-loading {
            opacity: 0.6;
          }

          .icon-add,
          .icon-added {
            display: inline-flex;
          }
          .icon-added {
            display: none;
          }
          &.is-in-cart .icon-add {
            display: none;
          }
          &.is-in-cart .icon-added {
            display: inline-flex;
          }
        }
      }
    }

    .product-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: var(--text-font-secondary);
      text-align: center;

      > h3 {
        width: 100%;
        font-size: calc(26 * var(--fu));
        font-family: var(--text-font-primary);
        color: var(--text-color-secondary);
        font-weight: 700;
        text-align: center;
      }
      > p {
        width: 100%;
        font-family: var(--text-font-secondary);
        font-size: calc(22 * var(--fu));
        color: var(--text-color-muted);
        text-align: center;
      }
      .price {
        width: 100%;
        text-align: center;
        font-size: calc(26 * var(--fu));
        color: var(--text-color-secondary);
        font-weight: 600;
      }
    }
  }
  /* Figma mobile (768 frame): name Poppins 28 semibold, subtitle Acumin 20, price Poppins 24 */
  @media (max-width: 767px) {
    .product-card_container .product-info > h3 {
      font-family: var(--font-poppins);
      font-size: calc(28 * var(--fu));
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.05em;
    }
    .product-card_container .product-info > p {
      font-family: var(--text-font-primary);
      font-size: calc(20 * var(--fu));
    }
    .product-card_container .product-info .price {
      font-family: var(--font-poppins);
      font-size: calc(24 * var(--fu));
    }
  }
{%- endstylesheet -%}
