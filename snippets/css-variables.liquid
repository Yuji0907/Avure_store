{% stylesheet %}
  :root {
    /* colors tokens */
    --avure-error: rgba(255, 44, 20, 1);
    --avure-blue-950-: rgba(0, 56, 101, 1);
    --avure-blue-900: rgba(12, 70, 117, 1);
    --avure-blue-800: rgba(27, 85, 133, 1);
    --avure-blue-700: rgba(44, 101, 148, 1);
    --avure-blue-600: rgba(65, 119, 163, 1);
    --avure-blue-500: rgba(89, 138, 179, 1);
    --avure-blue-400: rgba(116, 159, 194, 1);
    --avure-blue-300: rgba(146, 181, 209, 1);
    --avure-blue-200: rgba(180, 204, 224, 1);
    --avure-blue-100: rgba(216, 229, 240, 1);

    --avure-black-950: rgba(11, 11, 10, 1);
    --avure-black-900: rgba(29, 29, 27, 1);
    --avure-black-800: rgba(39, 39, 38, 1);
    --avure-black-700: rgba(65, 65, 63, 1);
    --avure-black-600: rgba(84, 84, 81, 1);
    --avure-black-500: rgba(116, 116, 112, 1);
    --avure-black-400: rgba(165, 165, 161, 1);
    --avure-black-300: rgba(212, 212, 211, 1);
    --avure-black-200: rgba(230, 230, 229, 1);
    --avure-black-100: rgba(244, 245, 244, 1);
    --avure-black-50: rgba(249, 250, 249, 1);

    --avure-light: rgba(249, 250, 249, 1);
    --avure-dark: rgba(11, 11, 10, 1);

    /* font sizes */
    --font-size-xs: 0.75rem; /* 12px */
    --font-size-sm: 0.875rem; /* 14px */
    --font-size-md: 1rem; /* 16px */
    --font-size-lg: 1.125rem; /* 18px */
    --font-size-xl: 1.25rem; /* 20px */
    --font-size-2xl: 1.5rem; /* 24px */
    --font-size-3xl: 2rem; /* 32px */
    --font-size-4xl: 2.5rem; /* 40px */
    --font-size-5xl: 3rem; /* 48px */
    --font-size-6xl: 3.5rem; /* 56px */
    --font-size-7xl: 4rem; /* 64px */
    --font-size-8xl: 5rem; /* 80px */
    --font-size-9xl: 7.5rem; /* 120px */

    /* ------------------------------------------------------------------
       Type scale (mobile-first, matches the 384px Figma frames).
       Fixed px values: no vw-based sizing. Desktop sizes can be layered
       on later with media queries that override these tokens.
       ------------------------------------------------------------------ */
    --type-display: 32px; /* hero headline */
    --type-title: 24px; /* section / page titles */
    --type-subtitle: 18px; /* sub-titles, cart totals */
    --type-product: 14px; /* product / card names */
    --type-body: 13px; /* body copy, descriptions */
    --type-body-sm: 12px; /* secondary body, card descriptions */
    --type-label: 11px; /* eyebrows, links, tags */
    --type-caption: 10px; /* badges, small mono captions */
    --type-button: 12px; /* button text */
    --type-input: 13px; /* form fields */

    --leading-none: 1;
    --leading-tight: 1.15;
    --leading-normal: 1.45;
    --tracking-eyebrow: 0.08em;

    /* Legacy tokens: still used across sections, now mapped onto the scale above */
    --text-caption: var(--type-caption);
    --text-caption-leading: var(--leading-normal);

    --text-sm: var(--type-body-sm);
    --text-sm-leading: var(--leading-normal);

    --text-body: var(--type-body);
    --text-body-leading: var(--leading-normal);

    --text-lg: var(--type-body);
    --text-lg-leading: var(--leading-normal);

    --text-h4: var(--type-body-sm);
    --text-h4-leading: var(--leading-normal);

    --text-h3: var(--type-product);
    --text-h3-leading: var(--leading-tight);

    --text-h2: var(--type-subtitle);
    --text-h2-leading: var(--leading-tight);

    --text-h1: var(--type-title);
    --text-h1-leading: var(--leading-tight);

    --text-hero: var(--type-display);
    --text-hero-leading: var(--leading-none);

    --text-masive: 40px;
    --text-masive-leading: var(--leading-none);

    /* Brand colors */

    --color-primary: var(--avure-blue-950-);
    --color-light: var(--avure-light);
    --color-dark: var(--avure-dark);
    --color-dark-muted: var(--avure-black-600);
    --color-dark-disabled: var(--avure-black-400);

    --surface-icon: var(--avure-blue-100);
    --surface-icon-selected: var(--avure-light);

    --bg-primary: var(--avure-blue-950-);
    --bg-light: var(--avure-light);
    --bg-elevated: var(--avure-black-100);
    --bg-dark: var(--avure-black-950);

    --fill-dark: var(--avure-black-950);
    --fill-carousel-points: var(--avure-black-100);
    --fill-carousel-points-selcted: var(--avure-black-200);

    --shadow-clr-dark: var(--avure-black-300);
    --border-clr-dark: var(--avure-black-950);
    --border-clr-muted: var(--avure-black-500);

    --text-color-secondary: var(--avure-dark);
    --text-color-secondary-subheading: var(--avure-black-900);
    --text-color-primary: var(--avure-light);
    --text-color-brand: var(--avure-blue-950-);
    --text-color-muted: var(--avure-black-700);
    --text-color-disabled: var(--avure-black-400);

    --border-color-dark: var(--avure-black-950);

    /* Brand fonts */
    --text-font-accent: 'JetBrainsMono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --text-font-primary: 'Acumin Variable Concept', 'Poppins', system-ui, sans-serif;
    --text-font-secondary: 'Poppins', system-ui, sans-serif;

    /* Aliases: several sections reference these names, which were never defined */
    --text-primary: var(--text-font-primary);
    --text-secondary: var(--text-font-secondary);
    --font-heading: var(--text-font-primary);
  }

  /* ------------------------------------------------------------------
     Global typography
     ------------------------------------------------------------------ */
  body {
    font-family: var(--text-font-secondary);
    font-size: var(--type-body);
    line-height: var(--leading-normal);
  }

  /* Eyebrow labels, announcement bar and small captions: the only places
     that use JetBrains Mono + uppercase. Add .u-eyebrow to opt new elements in. */
  .u-eyebrow,
  .announcement-text,
  .hero-label,
  .colab-hero-label,
  .about-label,
  .about-us-values__slogen,
  .science-avure_subheading,
  .testimonials-title,
  .feedbacks-title,
  .diagnostics__eyebrow,
  .pharma-colab__eyebrow,
  .skincare-steps__heading,
  .skin-type__header h4,
  .product-info_container .category,
  .diagnostics__container > h3 {
    font-family: var(--text-font-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  /* ------------------------------------------------------------------
     Horizontal sliders: keep scrolling, hide the scrollbar
     ------------------------------------------------------------------ */
  .u-no-scrollbar,
  .product-slider_container,
  .concern-slider_container,
  .routines-slider__track,
  .science-behind-avure_carousel,
  .product-ingredients-carousel,
  .product-media_container,
  .product-media-sm_container,
  [class*='carousel'],
  [class*='slider_container'],
  [class*='slider__track'] {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .u-no-scrollbar::-webkit-scrollbar,
  .product-slider_container::-webkit-scrollbar,
  .concern-slider_container::-webkit-scrollbar,
  .routines-slider__track::-webkit-scrollbar,
  .science-behind-avure_carousel::-webkit-scrollbar,
  .product-ingredients-carousel::-webkit-scrollbar,
  .product-media_container::-webkit-scrollbar,
  .product-media-sm_container::-webkit-scrollbar,
  [class*='carousel']::-webkit-scrollbar,
  [class*='slider_container']::-webkit-scrollbar,
  [class*='slider__track']::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}
