{%- comment -%}
  Breadcrumb shown above page titles: HOME / <TITLE>
  Usage: {% render 'breadcrumb', title: section.settings.heading %}
{%- endcomment -%}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a class="breadcrumb__link" href="{{ routes.root_url }}">Home</a>
  <span class="breadcrumb__separator" aria-hidden="true">/</span>
  <span class="breadcrumb__current" aria-current="page">{{ title | strip_html | escape }}</span>
</nav>

{%- stylesheet -%}
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em;
    margin-bottom: 0.5rem;
    font-family: var(--text-font-accent);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-color-disabled);
  }
  .breadcrumb__link {
    color: inherit;
  }
{%- endstylesheet -%}
