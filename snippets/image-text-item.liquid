<div class="product-ingredient_wrapper">

    <div class="ingredient-image_container">
      {%- if item.image != blank -%}
        {{ 
          item.image | image_url: width: 600 | image_tag:
            alt: item.ingredient_name,
            loading: 'eager',
            class:"ingredient-image"
        }}
      {%- else -%}
        <p>No image</p>
      {%- endif -%}
    </div>

    <div class="ingredient-info_container">
        <div>
            <h1 class="ingredient-name">{{ item.lable }}</h1>
        </div>




</div>
</div>

{%- stylesheet -%}
  .product-ingredient_wrapper{
    color: var(--text-color-secondary);
    line-height: 1.2;
    scroll-snap-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    .ingredient-image_container{
        display: flex;
        .ingredient-image{
            width: 100%;
            height: auto;
            object-fit: cover;
        }
    }


    .ingredient-info_container{
        width: 100%;
        font-size: var(--text-h3) ;
        text-transform: capitalize;
        display: flex;
        flex-direction: column;
        /* align-items: center; */
        gap: .8rem;
        
        .ingredient-name{
    		font-family: var(--text-font-accent);
            
            font-size: var(--text-h3) ;
            text-transform: capitalize;
			text-align: center;
            font-weight: 700;
        }
        .ingredient-inci{
            color: var(--text-color-secondary-subheading);
                font-weight: 600;

        }
        .ingredient-benefits_container{
            /* margin-top: .8rem; */
            display: flex;
            flex-direction: column;
            gap: .25rem;
            .ingredient-benefit{
                display: flex;
                align-items: center;
                gap: .25rem;
                /* justify-content: center; */
                >p{
                    margin-top:  clamp( .5rem,.8vw, 1rem);;
                    line-height: 1;
                }
            }
        }
        .ingredient-desc{
                font-family: var(--text-font-secondary);
                font-size: var(--text-h3) ;
                text-align: justify;
                font-weight: 500;
                color: var(--text-color-muted);

        }
    }


}

{%- endstylesheet -%}